	//Calc lapl3
	

	volScalarField  lapl3 = lapl1*0;

	const labelUList& owner = lapl3.mesh().owner();

	const labelUList& neighbour = lapl3.mesh().neighbour();

	forAll(owner,faceI)
	{
		lapl3[owner[faceI]] += testEq.upper()[faceI] * fluxStar[energyI][neighbour[faceI]] ;	
		lapl3[neighbour[faceI]] += testEq.lower()[faceI] * fluxStar[energyI][owner[faceI]] ;	
	}

	forAll(lapl3,cellI)
	{
