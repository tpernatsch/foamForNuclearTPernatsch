template<class Type>
void albedo2FvPatchField<Type>::autoMap
(
    const fvPatchFieldMapper& m
)
{
    fvPatchField<Type>::autoMap(m);
    gamma_.autoMap(m);
}


template<class Type>
void albedo2FvPatchField<Type>::rmap
(
    const fvPatchField<Type>& ptf,
    const labelList& addr
)
{
    fvPatchField<Type>::rmap(ptf, addr);

    const albedo2FvPatchField<Type>& fgptf =
        refCast<const albedo2FvPatchField<Type> >(ptf);

    gamma_.rmap(fgptf.gamma_, addr);
    //diffCoeff_.rmap(fgptf.diffCoeff_, addr);
}


template<class Type>
void albedo2FvPatchField<Type>::evaluate(const Pstream::commsTypes)
{
    if (!this->updated())
    {
        this->updateCoeffs();
    }

    const Field<scalar>& diffCoeff =
        this->patch().template lookupPatchField<volScalarField, scalar>
        (
            diffCoeffName_
        );

    Field<Type>::operator=
    (
        this->patchInternalField() + (this->patchInternalField()*gamma_/diffCoeff)/this->patch().deltaCoeffs()
    );

    fvPatchField<Type>::evaluate();
}


template<class Type>
tmp<Field<Type> > albedo2FvPatchField<Type>::valueInternalCoeffs
(
    const tmp<scalarField>&
) const

{
/*
    return tmp<Field<Type> >
    (
        new Field<Type>(this->size(), pTraits<Type>::zero)
    );
*/

    const Field<scalar>& diffCoeff =
        this->patch().template lookupPatchField<volScalarField, scalar>
        (
            diffCoeffName_
        );

	return Type(pTraits<Type>::one) * (1 + gamma_/diffCoeff/this->patch().deltaCoeffs());
}


