tmp<Field<Type> > albedo2FvPatchField<Type>::valueBoundaryCoeffs
(
    const tmp<scalarField>&
) const

{
 
    return tmp<Field<Type> >
    (
        new Field<Type>(this->size(), pTraits<Type>::zero)
    );

 //  return Type(pTraits<Type>::zero);

}


template<class Type>
tmp<Field<Type> > albedo2FvPatchField<Type>::
gradientInternalCoeffs() const
{
    const Field<scalar>& diffCoeff =
        this->patch().template lookupPatchField<volScalarField, scalar>
        (
            diffCoeffName_
        );

    /*return tmp<Field<Type> >
    (
        new Field<Type>(this->size(), pTraits<Type>::zero)
    );*/
    return Type(pTraits<Type>::one)*(- gamma_/diffCoeff);
}


template<class Type>
tmp<Field<Type> > albedo2FvPatchField<Type>::
gradientBoundaryCoeffs() const
{
    //return gradient();
    return tmp<Field<Type> >
    (
        new Field<Type>(this->size(), pTraits<Type>::zero)
    );
}

template<class Type>
tmp<Field<Type> > albedo2FvPatchField<Type>::snGrad() const
{
    const Field<scalar>& diffCoeff =
        this->patch().template lookupPatchField<volScalarField, scalar>
        (
            diffCoeffName_
        ); 

    //return (- (this->patchInternalField()*gamma_/diffCoeff)/this->patch().deltaCoeffs());
    return (- (this->patchInternalField()*gamma_/diffCoeff));
}

