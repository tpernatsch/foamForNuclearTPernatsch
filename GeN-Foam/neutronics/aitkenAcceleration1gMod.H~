	{
  	      integralFlux0[0]+=(fvc::domainIntegrate(flux[energyI])).value()-phiOld[energyI];
	}   
}  
if(aitkenIterCounter==1)
{

	integralFlux1[0]=0;
	forAll(flux, energyI)
	{
  	      integralFlux1[0]+=(fvc::domainIntegrate(flux[energyI])).value()-phiOld[energyI];
	}   
}
if(aitkenIterCounter==2)
{	
	integralFlux2[0]=0;
	bool aitkenYesNo = true;

	forAll(flux, energyI)
	{
	    integralFlux2[0]+=(fvc::domainIntegrate(flux[energyI])).value()-phiOld[energyI];


	}

	Info << "integralFlux0[0]" << integralFlux0[0] << endl ;
	Info << "integralFlux1[0]" << integralFlux1[0] << endl ;
	Info << "integralFlux2[0]" << integralFlux2[0] << endl ;

		if((integralFlux2[0]-integralFlux1[0])
		/(integralFlux1[0]-integralFlux0[0])>=1) aitkenYesNo=false;


Info << "pippo"  << endl ;


	if(aitkenYesNo==true)
