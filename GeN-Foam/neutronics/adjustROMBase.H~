
if(adjustROM)
{
Info << "Adjusting POD base" << endl ;


Info << "ROMAdjustCounter = " << ROMAdjustCounter << endl ;

if( ROMAdjustCounter == 1 )//first adjustement in step - base clean up
{

/////////////////////////////
        Info<< "ExecutionTime beginning of Re-initialize ROM base = " << runTime.elapsedCpuTime() << " s"
            << nl << endl;/////////////////////////////////////////////////////////////////////

	//Clean up old base old base: check usefullness of old base elements
	PtrList<scalar> projectionOnBase(base_fluxStar[energyI].size());
	scalar maxProejection = 0.0;
	forAll(base_fluxStar[energyI],baseNoI) 
	{

		projectionOnBase.set(baseNoI, new scalar( Foam::mag(Foam::POD::projection(fluxStar[energyI],base_fluxStar[energyI][baseNoI]))));
		maxProejection =  max(maxProejection,projectionOnBase[baseNoI]);
	}

Info << "projectionOnBase" << projectionOnBase << endl ;
	PtrList<scalar> projectionOnBaseReOrdered(projectionOnBase.size());
	projectionOnBaseReOrdered.set(0,new scalar(maxProejection));
	for(int baseNoI = 1; baseNoI < projectionOnBase.size(); baseNoI++) 
	{
		scalar maxProjectionReduced = 0.0;
		forAll(projectionOnBase,baseNoJ) 
		{
			if(projectionOnBase[baseNoJ] < projectionOnBaseReOrdered[baseNoI-1])
			{
				maxProjectionReduced =  max(maxProjectionReduced,projectionOnBase[baseNoJ]);
			}
		}
		projectionOnBaseReOrdered.set(baseNoI, new scalar(maxProjectionReduced));
	}
Info << "projectionOnBaseReOrdered" << projectionOnBaseReOrdered << endl ;		
	scalar projectionForMaxNoOFBasis = projectionOnBaseReOrdered[min(2,(projectionOnBase.size()-1))];






	for(int baseNoI = 0; baseNoI < min(5,base_fluxStar[energyI].size()); baseNoI++) 
	{
		for(int baseNoJ = baseNoI; baseNoJ < projectionOnBase.size(); baseNoJ++) 
		{
			if(projectionOnBase[baseNoJ] >= projectionForMaxNoOFBasis )
			{

				if(baseNoI != baseNoJ )
				{
					base_fluxStar[energyI][baseNoI].primitiveFieldRef() = base_fluxStar[energyI][baseNoJ].internalField();
					base_fluxStar[energyI][baseNoI].correctBoundaryConditions();
					projectionOnBase[baseNoJ] = 0.0;
				}
				baseNoJ =  base_fluxStar[energyI].size();
	
			}
		}
	}	

	base_fluxStar[energyI].resize(min(3,base_fluxStar[energyI].size()));


	base_fluxStar[energyI][0].primitiveFieldRef() = fluxStar[energyI].internalField() / Foam::pow(Foam::POD::projection(fluxStar[energyI],fluxStar[energyI]),0.5);
	base_fluxStar[energyI][0].correctBoundaryConditions();


	for(int baseNoI = 1; baseNoI < base_fluxStar[energyI].size() ; baseNoI++ )
	{
		for(int baseNoJ = 0; baseNoJ < baseNoI ; baseNoJ++ )
		{
			if(baseNoJ != baseNoJ)
			{
				base_fluxStar[energyI][baseNoI]
				 -= Foam::POD::projection(base_fluxStar[energyI][baseNoI],base_fluxStar[energyI][baseNoJ])*base_fluxStar[energyI][baseNoJ];
			}
		}
		base_fluxStar[energyI][baseNoI].correctBoundaryConditions();
		base_fluxStar[energyI][baseNoI] /= Foam::pow(Foam::POD::projection(base_fluxStar[energyI][baseNoI],base_fluxStar[energyI][baseNoI]),0.5);
		base_fluxStar[energyI][baseNoI].correctBoundaryConditions();	
	}


	#include "buildMatrixPOD.H"

	Info << "PODBaseSize energy " << energyI << ": " << base_fluxStar[energyI].size() << endl;
	Info << "Done" << endl;


/////////////////////////////
        Info<< "ExecutionTime end of Re-initialize ROM base r = " << runTime.elapsedCpuTime() << " s"
            << nl << endl;/////////////////////////////////////////////////////////////////////

}
else
{

	int initBaseSize = base_fluxStar[energyI].size();
	base_fluxStar[energyI].resize(initBaseSize+1);
	base_fluxStar[energyI].set
	(
		initBaseSize,
		new volScalarField 
		(
			IOobject
			(
				"_base_fluxStar"+Foam::name(energyI)+"_"+Foam::name(initBaseSize),
				runTime.timeName(),
				neutroMesh,
				IOobject::NO_READ,
				IOobject::NO_WRITE
			),
			fluxStar[energyI]
		)
	);
	for(int baseNoI = 0; baseNoI < initBaseSize ; baseNoI++ )
	{
		base_fluxStar[energyI][initBaseSize]
		 -= Foam::POD::projection(fluxStar[energyI],base_fluxStar[energyI][baseNoI])*base_fluxStar[energyI][baseNoI];
	}
	base_fluxStar[energyI][initBaseSize].correctBoundaryConditions();
	base_fluxStar[energyI][initBaseSize] /= Foam::pow(Foam::POD::projection(base_fluxStar[energyI][initBaseSize],base_fluxStar[energyI][initBaseSize]),0.5);
	base_fluxStar[energyI][initBaseSize].correctBoundaryConditions();	

	Info << "PODBaseSize energy " << energyI << ": " << base_fluxStar[energyI].size() << endl;
	Info << "Done" << endl;

/////////////////////////////
        Info<< "ExecutionTime before build POD matrix = " << runTime.elapsedCpuTime() << " s"
            << nl << endl;/////////////////////////////////////////////////////////////////////

	#include "buildMatrixPOD.H"
				

/////////////////////////////
        Info<< "ExecutionTime after build POD matrix = " << runTime.elapsedCpuTime() << " s"
            << nl << endl;/////////////////////////////////////////////////////////////////////




}

}
else
{
	Info << "Not adjusting POD base" << endl ;
}



