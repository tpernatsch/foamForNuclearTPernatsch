forAll(flux,energyI)
{

//check how well you reproduce new snaphot with old base
volScalarField error = fluxStar[energyI];
forAll(base_fluxStar[energyI],baseNoI) 
{
	error -= Foam::POD::projection(fluxStar[energyI],base_fluxStar[energyI][baseNoI])*base_fluxStar[energyI][baseNoI];
}
scalar globalError = mag(fvc::domainIntegrate(error).value() / fvc::domainIntegrate(fluxStar[energyI]).value());

Info << "Global error for flux reconstruction energy " << energyI << ": " << globalError << endl;

if(globalError > acceptableReconstructionError ) //store new snapshot and change base
{

	Info << "Global error higher than acceptable error" << nl 
		<< "Storing snaphshot and changing POD base  " << endl;

	PtrList<volScalarField> snapShot_fluxStarTmp(snapShot_fluxStar[energyI].size()+1);

	snapShot_fluxStar[energyI].resize(snapShot_fluxStar[energyI].size()+1);
	snapShot_fluxStar[energyI].set
	(
		snapShot_fluxStar[energyI].size()-1,
		new volScalarField
		(
			IOobject
			(
				"_snapShot_fluxStar"+Foam::name(energyI)+"_"+Foam::name(snapShot_fluxStar[energyI].size()-1),
				runTime.timeName(),
				neutroMesh,
				IOobject::NO_READ,
				IOobject::AUTO_WRITE
			),
			fluxStar[energyI]
		)
	);

	Info << "adjusting ROM base" << endl;



	int initBaseSize = base_fluxStar[energyI].size();
	base_fluxStar[energyI].resize(initBaseSize+1);
	base_fluxStar[energyI].set
	(
		initBaseSize,
		new volScalarField 
		(
			IOobject
			(
				"_base_fluxStar"+Foam::name(energyI)+"_"+Foam::name(initBaseSize+1),
				runTime.timeName(),
				neutroMesh,
				IOobject::NO_READ,
				IOobject::AUTO_WRITE
			),
			//PODBase.orthoField(baseNoI)// No! BC no corrette (calculated)
		defaultFlux
		)
	);
	base_fluxStar[energyI][initBaseSize].primitiveFieldRef()=fluxStar[energyI];
	for(int baseNoI = 0; baseNoI < (initBaseSize) ; baseNoI++ )
	{
		base_fluxStar[energyI][initBaseSize].primitiveFieldRef()
		 -= Foam::POD::projection(fluxStar[energyI],base_fluxStar[energyI][baseNoI])*base_fluxStar[energyI][baseNoI];
	}
	base_fluxStar[energyI][initBaseSize].primitiveFieldRef() /= Foam::pow(Foam::POD::projection(base_fluxStar[energyI][initBaseSize],base_fluxStar[energyI][initBaseSize]),0.5);
	base_fluxStar[energyI][initBaseSize].correctBoundaryConditions();	

	Info << "PODBaseSize energy " << energyI << ": " << base_fluxStar[energyI].size() << endl;
	Info << "Done" << endl;
}

}

