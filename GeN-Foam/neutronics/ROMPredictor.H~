
	volScalarField residual =  neutroEq.AmulWithBC()() - neutroEq.SourceWithBC();

	Info << "adjusting ROM base" << endl;

	int initBaseSize = base_fluxStar[energyI].size();
	base_fluxStar[energyI].resize(initBaseSize+1);
	base_fluxStar[energyI].set
	(
		initBaseSize,
		new volScalarField 
		(
			IOobject
			(
				"_base_fluxStar"+Foam::name(energyI)+"_"+Foam::name(initBaseSize+1),
				runTime.timeName(),
				neutroMesh,
				IOobject::NO_READ,
				IOobject::AUTO_WRITE
			),
			//PODBase.orthoField(baseNoI)// No! BC no corrette (calculated)
		defaultFlux
		)
	);
	base_fluxStar[energyI][initBaseSize].primitiveFieldRef()=residual;
	for(int baseNoI = 0; baseNoI < (initBaseSize) ; baseNoI++ )
	{
		base_fluxStar[energyI][initBaseSize].primitiveFieldRef()
		 -= Foam::POD::projection(residual,base_fluxStar[energyI][baseNoI])*base_fluxStar[energyI][baseNoI];
	}
	base_fluxStar[energyI][initBaseSize].primitiveFieldRef() /= Foam::pow(Foam::POD::projection(base_fluxStar[energyI][initBaseSize],base_fluxStar[energyI][initBaseSize]),0.5);
	base_fluxStar[energyI][initBaseSize].correctBoundaryConditions();	

	Info << "PODBaseSize energy " << energyI << ": " << base_fluxStar[energyI].size() << endl;
	Info << "Done" << endl;


	Info << "buildmatrixROM energy: " << energyI <<  endl;

	SquareMatrix<scalar> matrixROMforPredictor(base_fluxStar[energyI].size(),base_fluxStar[energyI].size(),Foam::zero());

	// necessario per riaggiustare flusso dopo averlo reso uguale a base
	volScalarField storeFlux
	(
		IOobject
		(
			"storeFlux",
			runTime.timeName(),
			neutroMesh,
			IOobject::NO_READ,
			IOobject::NO_WRITE
		),
		fluxStar[energyI]
	);

	//inizializza matrice moltiplicata per base
	volScalarField Aphib
	(
		IOobject
		(
			"Aphib",
			runTime.timeName(),
			neutroMesh,
			IOobject::NO_READ,
			IOobject::NO_WRITE
		),
		defaultFlux
	);

	int PODBaseSize(base_fluxStar[energyI].size());
	for(int baseNoJ = 0; baseNoJ < PODBaseSize ; baseNoJ++ )
	{
		fluxStar[energyI].primitiveFieldRef() = base_fluxStar[energyI][baseNoJ].internalField();
		fluxStar[energyI].correctBoundaryConditions();
		Aphib.primitiveFieldRef() = neutroEq.AmulWithBC()().internalField();
		fluxStar[energyI].primitiveFieldRef() = storeFlux.internalField();
		fluxStar[energyI].correctBoundaryConditions();

		for(int baseNoI = 0; baseNoI < PODBaseSize ; baseNoI++ )
		{

			matrixROMforPredictor[baseNoI][baseNoJ] = Foam::POD::projection(Aphib,base_fluxStar[energyI][baseNoI]);
		}
	 
	}

	Info << "Solving ROM energy: " << energyI <<  endl;
	

	List<scalar> sourcePOD(PODBaseSize,0.0);

	volScalarField Sphib("Sphib",neutroEq.SourceWithBC()); 

	for(int baseNoI = 0; baseNoI < PODBaseSize ; baseNoI++ )
	{
		sourcePOD[baseNoI] = Foam::POD::projection(Sphib,base_fluxStar[energyI][baseNoI]);
	}

	List<scalar> coeffPOD(PODBaseSize,0.0);
	solve(coeffPOD,matrixROMforPredictor,sourcePOD);
	fluxStar[energyI] *= 0.0;
	for(int baseNoI = 0; baseNoI < PODBaseSize ; baseNoI++ )
	{
		fluxStar[energyI] += coeffPOD[baseNoI] * base_fluxStar[energyI][baseNoI];
	}

	fluxStar[energyI].correctBoundaryConditions();


