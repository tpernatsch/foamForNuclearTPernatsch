FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       dictionary;
    location    "system/neutroRegion";
    object      createPatchDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

pointSync   false;

patches
(
    // --- Front
    {
        name            front;

        patchInfo
        {
            type        wedge;
        };

        constructFrom   patches;

        patches
        (
            innerFuelDiagrid
            innerLowerFuelAssembly
            innerFuel
            innerUpperFuelAssembly
            outerFuelDiagrid
            outerLowerFuelAssembly
            outerFuel
            outerUpperFuelAssembly
            outerDiagrid
            lowerReflectorAssembly
            middleReflectorAssembly
            upperReflectorAssembly
        );
    }

    // --- Back
    {
        name            back;

        patchInfo
        {
            type        wedge;
        };

        constructFrom   patches;

        patches
        (
            ".*_top"
        );
    }

    // --- Wall
    {
        name            wall;

        patchInfo
        {
            type        patch;
        };

        constructFrom   patches;

        patches
        (
            ".*_rotated"
        );
    }
);


