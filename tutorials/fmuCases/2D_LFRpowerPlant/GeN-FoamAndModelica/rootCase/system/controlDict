FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application         GeN-Foam;

startFrom           latestTime;

stopAt              endTime;

endTime             1;

deltaT              0.05;

writeControl        adjustableRunTime;

writeInterval       1;

purgeWrite          0;

writeFormat         ascii; // ascii / binary (remove the warning due to
                           // precision)
writePrecision      6;

writeCompression    off;

timeFormat          general;

timePrecision       6;

runTimeModifiable   true;

removeBaffles
{
    fluidRegion     true;
    neutroRegion    false;
}


//- Global options ------------------------------------------------------------*

liquidFuel          false;

//- Time step control options -------------------------------------------------*

adjustTimeStep      true;

maxDeltaT           1;

maxCo               5;


//- --*

//- Scoring functions
#include "functions"


//- FMU coupling
// #include "FMUSimulatorFunction"



