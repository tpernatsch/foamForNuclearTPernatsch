    corePower
    {
        type            volFieldValue;
        libs            (fieldFunctionObjects);
        fields          (powerDensityNeutronics);
        operation       volIntegrate;
        region          fluidRegion;
        regionType      all;
        writeControl    adjustableRunTime;
        writeFields     false;
        writeInterval   1;
        timeStart       $timeStartFunctions;
        log             true;
        scaleFactor     ${{72.0 * 0.363516}}; // 0.300239}}; // 0.382179}}; // 360/5 (wedge) * fuelFractionInCore // power.py
    }


    subtract1
    {
        // Mandatory entries (unmodifiable)
        type            subtract;
        libs            (fieldFunctionObjects);

        // Mandatory (inherited) entry (runtime modifiable)
        fields
        (
            T
            T.fixedTemperatureFMU
        );

        // Optional (inherited) entries
        region          fluidRegion;
        regionType      cellZone;
        regionName      "SGenPrim1:SGenPrim2:SGenPrim3:SGenPrim4:SGenPrim5:SGenPrim6:SGenPrim7:SGenPrim8";
        writeControl    adjustableRunTime;
        writeFields     true;
        writeInterval   1;
        timeStart       $timeStartFunctions;
        log             true;
    }

    multiply1
    {
        // Mandatory entries (unmodifiable)
        type    multiply;
        libs    (fieldFunctionObjects);

        // Mandatory (inherited) entry (runtime modifiable)
        fields (
            htc
            subtract(T,T.fixedTemperatureFMU)
        );

        // Optional (inherited) entries
        region          fluidRegion;
        regionType      cellZone;
        regionName      "SGenPrim1:SGenPrim2:SGenPrim3:SGenPrim4:SGenPrim5:SGenPrim6:SGenPrim7:SGenPrim8";
