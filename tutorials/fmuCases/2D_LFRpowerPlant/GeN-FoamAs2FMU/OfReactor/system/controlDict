FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "simulationParameters"

application         GeN-Foam;

startFrom           latestTime;

stopAt              endTime;

endTime             $endTime;

deltaT              $deltaT;

writeControl        adjustableRunTime;

writeInterval       $writeInterval;

purgeWrite          2;

writeFormat         ascii; // ascii / binary (remove the warning due to
                           // precision)
writePrecision      6;

writeCompression    off;

timeFormat          general;

timePrecision       6;

runTimeModifiable   false;

solveFMI            true;

removeBaffles
{
    fluidRegion     true;
    neutroRegion    false;
}


//- Global options ------------------------------------------------------------*

liquidFuel          false;

//- Time step control options -------------------------------------------------*

adjustTimeStep      false;

maxDeltaT           1;

maxCo               5;

timeStartFunctions  0; // 349;

//----------------------------------------------------------------------------*

libs
(
    externalComm
);

