FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       dictionary;
    location    "system/fluidRegion";
    object      createPatchDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

pointSync   false;

patches
(
    // --- Front
    {
        name            front;

        patchInfo
        {
            type        wedge;
        };

        constructFrom   patches;

        patches
        (
            innerLowerCorePlenum
            innerFuelDiagrid
            innerLowerFuelAssembly1
            innerLowerFuelAssembly2
            innerFuel
            innerUpperFuelAssembly
            innerUpperCorePlenum1
            innerUpperCorePlenum2
            innerUpperCorePlenum3
            innerUpperAssembly
            outerLowerCorePlenum
            outerFuelDiagrid
            outerLowerFuelAssembly1
            outerLowerFuelAssembly2
            outerFuel
            outerUpperFuelAssembly
            outerUpperCorePlenum1
            outerUpperCorePlenum2
            outerUpperCorePlenum3
            outerUpperAssembly
            lowerCorePlenum
            outerDiagrid
            lowerReflectorAssembly1
            lowerReflectorAssembly2
            middleReflectorAssembly
            upperReflectorAssembly
            upperCorePlenum1
            upperCorePlenum2
            upperCorePlenum3
            upperAssembly
            primaryColdPoolRegion1
            primaryColdPoolRegion2
            primaryColdPoolRegion3
            primaryColdPoolRegion4
            primaryColdPoolRegion5
            primaryColdPoolRegion6
            primaryColdPoolRegion7
            primaryColdPoolRegion8
            primaryColdPoolRegion9
            primaryColdPoolRegion10
            primaryColdPoolRegion11
            primaryColdPoolRegion12
            primaryColdPoolRegion13
            primaryColdPoolRegion14
            pumpDuct1
            pumpDuct2
            pumpDuct3
            primaryPump
            primaryColdPoolBottomRegion1
            primaryColdPoolBottomRegion2
            primaryColdPoolBottomRegion3
            primaryHotPoolRegion
            SGenPrim1
            SGenPrim2
            SGenPrim3
            SGenPrim4
            SGenPrim5
            SGenPrim6
            SGenPrim7
            SGenPrim8
        );
    }

    // --- Back
    {
        name            back;

        patchInfo
        {
            type        wedge;
        };

        constructFrom   patches;

        patches
        (
            ".*_top"
        );
    }

    // --- Wall
    {
        name            wall;

        patchInfo
        {
            type        wall;
        };

        constructFrom   patches;

        patches
        (
            ".*_rotated"
        );
    }
);


