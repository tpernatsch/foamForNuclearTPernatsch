FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant/fluidRegion";
    object      turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulationType 	    RAS; // laminar | RAS

RAS
{
    RASModel        porousKEpsilon; // laminar | kEpsilon | porousKEpsilon

    turbulence      on;

    printCoeffs     on;
}

porousKEpsilonProperties
{
    "innerFuelDiagrid:outerFuelDiagrid:innerLowerFuelAssembly1:innerLowerFuelAssembly2:outerLowerFuelAssembly1:outerLowerFuelAssembly2:innerUpperFuelAssembly:outerUpperFuelAssembly:innerUpperAssembly:outerUpperAssembly:innerFuel:outerFuel:primaryPump:SGenPrim1:SGenPrim2:SGenPrim3:SGenPrim4:SGenPrim5:SGenPrim6:SGenPrim7:SGenPrim8"
    {
        convergenceLength           0.1;// k and epsilon will exponentially
					 					// converge to equilibrium according
					 					// to this exponent
		// k and epsilon are determined based on correlations for turbulent
		// intensity (I) and length scale (L)
		// Turbulent intensity correlation in the form 0.16*Reynolds^-0.125
		// Reynolds number calculated by the thermal-hydraulic class, according
		// to the input data in phaseProperties
        turbulenceIntensityCoeff    0.16;

        turbulenceIntensityExp      -0.125;

        turbulenceLengthScaleCoeff  0.07; // L = 0.07*Dh (Dh is the hydraulic
					                      // diameter specified in
                                          // phaseProperties)
        DhStruct 					1;
    }
}


