FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     GeN-Foam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         100;

deltaT          0.01;

writeControl    adjustableRunTime;

writeInterval   $endTime;

purgeWrite      0;

writeFormat     ascii;

writePrecision  7;

writeCompression false;

timeFormat      general;

timePrecision   8;

runTimeModifiable false;


//- Physics

removeBaffles
{
    fluidRegion     true;
    neutroRegion    false;
}


//- Time control

adjustTimeStep  true;

maxDeltaT       1;

maxCo           5;

maxPowerVariation 0.01;


//- FMU coupling

libs
(
    externalComm
);

functions
{
    ///*
    FMUSimulator
    {
        type            FMUSimulator;
        libs            (pyFMUSim);
        pyClassName     ExternalReactivityController;
        pyFileName      ExternalReactivityController;
    }
    //*/
}

