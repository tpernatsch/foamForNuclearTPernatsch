cd ${0%/*} || exit 1    # Run from this directory

clear

#------------------------------------------------------------------------------

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

# Function to display help
usage() {
    echo "Usage: $0 [-j N|--jobs N] [--fmi] [--fast] [--help]"
    exit 1
}

echoCmd()
{
    txtVar1=$1
    txtVar2=$2
    quiet_flag_in=$3
    if [[ $quiet_flag_in = 'true' && ! -z "$txtVar2" ]]
    then
        printf "$txtVar2"
    elif [ ! $quiet_flag_in = 'true' ]
    then
        printf "$txtVar1"
    fi
}

# Default values
num_jobs=1
fmi_flag=false
fast_flag=false
quiet_flag=false

# Parse options using getopt
PARSED_OPTIONS=$(getopt -n "$0" -o j:h --long jobs:,fmi,fast,quiet,help -- "$@")
if [ $? -ne 0 ]; then
    usage
fi

# Rearrange the positional parameters based on the parsed options
eval set -- "$PARSED_OPTIONS"

# Process the options
while true; do
    case "$1" in
        -j | --jobs)
            num_jobs="$2"
            shift 2
            ;;
        --fmi)
            fmi_flag=true
            shift
            ;;
        --fast)
            fast_flag=true
            shift
            ;;
        --quiet)
            quiet_flag=true
            shift
            ;;
        --help)
            usage
            ;;
        --)
            shift
            break
            ;;
        *)
            usage
            ;;
    esac
done

# Script logic
echo "FMI flag: $fmi_flag"

echo -e "Run tutorials using $num_jobs threads"
if [ $num_jobs -gt 1 ]
then
    quiet_flag="false"
    echo "Cannot run quiet if multiple jobs"
fi

echo "Quiet flag: $quiet_flag"

echoCmd "Run all cases\n" "Run fast cases only\n" $fast_flag

echo


