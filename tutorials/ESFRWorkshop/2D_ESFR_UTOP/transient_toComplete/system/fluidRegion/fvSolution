FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
solvers
{
    p_rgh
    {
        solver          GAMG;
        smoother        DIC;
        tolerance       1e-06;
        relTol          0;
    }
    p_rghFinal
    {
        solver          GAMG;
        smoother        DIC;
        tolerance       1e-06;
        relTol          0;
    }
  /*  "e.*"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-06;
        relTol          0;
        minIter         1;
    }
    "h.*"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-12;
        relTol          0;
        minIter         1;
    }*/
    ".*"
    {
        solver          PBiCGStab;
        preconditioner  diagonal;
        tolerance       1e-06;
        relTol          0.001;
    }
    alpha
    {
        solver          "MULES";
        adjustSubCycles true;
        alphaMaxCo      0.25;
        solvePhase      "vapour";
    }
}

PIMPLE
{
    solveEnergy true;
    solveFluidMechanics true;
    nCorrectors                         12;
    correctUntilConvergence             false;
    nOuterCorrectors 			5;
    nNonOrthogonalCorrectors            0;
    partialEliminationMode              implicit;
    momentumMode                        faceCentered;
    massTransferSafetyFactor            0.90;
    
    residualControl
    {
        p_rgh
        {
            tolerance                           1e-05;
            relTol                              1;
            useFirstPISOInitialResidual         true;
        }
        h
        {
            tolerance       1e-5;
            relTol          0;
        }
    }
}

relaxationFactors
{
    equations
    {
        ".*"                0.5;
        //"h.vapour"          0.25;
        //"h.vapourFinal"     0.25;
        h 			0.3;
        p_rghFinal		0.3;
        UFinal			0.7;
    }
    fields
    {
       // "T.interface"               0.25;
//"T.interfaceFinal"          0.25;
      //  "dmdt.*"                    0.125;
    }
}

