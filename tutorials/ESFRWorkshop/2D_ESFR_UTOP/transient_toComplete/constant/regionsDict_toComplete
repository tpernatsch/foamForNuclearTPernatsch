// Define the following solvers

// Level_0:
			// fluidRegion (onePhase)
			// neutroRegion (pointKinetics) 
			// Conjugate Heat Transfer coupling (CHTLoop)

// Level_1 (CHTLoop):
			// channelRegion (onePhase)
			// fuelBehaviourRegion (fuelBehaviour)

regionSolvers
{
	Level_0
	{
		...
	}

	// When defining a Loop, the subSolvers always have to be specified, i.e. the list of
	// solvers which are coupled together

	Level_1
	{
		subSolvers // same structure as Level_0, regionName solverName
		{
			...
		}

		// Control of loop --> not relevant in this case since one-way coupling

		minResidual 1e-5;
		maxIterations 1;

		// Control of CHT --> need to specify:
			// - Which is the fluid region?
			// - Which is the solid region?
			// - How is heat-flux preserved?
			// 	-If useHTC, then on the fluid side heat flux is computed as h*deltaT
			// 	-Else, q'' is computed as k_eff*gradT, where k_eff comes from turbulence model

		CHTLoopCoeffs
		{
			// To change
			fluidRegionName ...;
			solidRegionName ...;
			useHTC ...;


			// Do not change
			fluidSidePatchName wall2;
			solidSidePatchName cladOuter;
			oneWayCoupling true;
			targetRegion fuelBehaviourRegion;
		}
	}

};


