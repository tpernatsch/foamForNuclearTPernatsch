FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulationType  laminar;

// If simulationType is set to "RAS", the RAS subDictionary
// is read to assign turbulence modeling properties.
// kEpsilon, porousMediaKEpsilon, LaheyKEpsilon are available

RAS // k-kEpsilon example
{
    RASModel        kEpsilon;

    turbulence      on;

    printCoeffs     on;
}

