FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The thermophysical properties dictionary of FFN is identical to 
// standard OpenFOAM's heRhoThermo. More info in 
// https://www.openfoam.com/documentation/user-guide/5-models-and-physical-properties/5.2-thermophysical-models


//- COMPRESSIBLE

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture; 
    transport       const; //polynomial;
    thermo          hConst; // hPolynomial;
    equationOfState perfectGas; // icoPolynomial;
    specie          specie;
    energy          sensibleEnthalpy;
}

pRef                        100000;

mixture
{
    specie
    {
        molWeight           28.9;
    }
    thermodynamics
    {
        Cp                  904.141;
        Hf                  4217528;
        Sf                  0;
    }
    transport
    {
        mu                  1.8e-5;
        Pr                  0.001;
    }
}

// ************************************************************************* //
