FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fsiProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

regionSolvers
{
    Level_0
    {
        Level_1 CHTLoop;
    }

    Level_1
    {
        subSolvers
        {
            fluid onePhase;
            solid extendedThermoMechanics;
        }

        maxResidual 5e-5;
        maxIterations 50;

        CHTLoopCoeffs
        {
            fluidRegionName fluid;
            solidRegionName solid;

            fluidPatches ( interface );
            solidPatches ( top );

            useHTC false;
        }
    }
}

mappings
{
    fluid{}
    solid{}
}

