#!/bin/bash

# --- Run from this directory
cd ${0%/*} || exit 1

# --- Initialize output file
resFile=test.out
rm -f $resFile
touch $resFile

# ==========================
# Helper functions
# ==========================

checkConvergence()
{
    caseDir=$1
    endString=$(tail -3 ./$caseDir/log.GeN-Foam | grep End)
    if [ "$endString" = "End" ]; then
        echo 0
    else
        echo 1
    fi
}

extract_Tmax()
{
    caseDir=$1
    grep -e "T (avg min max)" ./$caseDir/log.GeN-Foam | tail -1 | awk '{print $8}'
}

isInRange()
{
    ref=$1
    value=$2
    error=$3
    valueMin=$(bc -l <<<"$value*(1-$error)")
    valueMax=$(bc -l <<<"$value*(1+$error)")

    if (( $(echo "$valueMin <= $ref && $ref <= $valueMax" | bc -l) )); then
        echo 0
    else
        echo 1
    fi
}

# ==========================
# Run simulations
# ==========================

echo "Running tutorials..." | tee -a $resFile
./Allrun >> log.simulation
echo "Done running tutorials." | tee -a $resFile

# ==========================
# Case definitions
# ==========================

cases=("CHTLoop" "boundaryCoupling")

expectedTMax_CHTLoop=309.287
expectedTMax_boundaryCoupling=309.287   

error=0.001

# ==========================
# Table header
# ==========================

echo "" | tee -a $resFile
echo "Results comparison:" | tee -a $resFile
echo "| Case              | Tmax (sim) | Tmax (exp) | Converged | Status |" | tee -a $resFile
echo "|:------------------|:----------:|:----------:|:---------:|:------:|" | tee -a $resFile

overallStatus=0

# ==========================
# Loop over cases
# ==========================

for case in "${cases[@]}"; do

    if [ $(checkConvergence $case) -eq 0 ]; then
        converged="YES"
    else
        converged="NO"
        overallStatus=1
    fi

    Tmax=$(extract_Tmax $case)
    expectedVar="expectedTMax_${case}"
    expectedTMax=${!expectedVar}

    if [ $(isInRange $Tmax $expectedTMax $error) -eq 0 ]; then
        status="OK"
    else
        status="FAIL"
        overallStatus=1
    fi

    printf "| %-17s | %10.6f | %10.6f | %9s | %6s |\n" \
        "$case" "$Tmax" "$expectedTMax" "$converged" "$status" | tee -a $resFile
done

# ==========================
# Exit
# ==========================

exit $overallStatus
