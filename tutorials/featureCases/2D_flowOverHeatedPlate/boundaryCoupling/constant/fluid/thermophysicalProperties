FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type                heRhoThermo;
    mixture             pureMixture;
    equationOfState     Boussinesq;
    thermo              hConst;
    transport           const;
    specie              specie;
    energy              sensibleEnthalpy;
}

pRef        100000;

mixture
{
    specie
    {
        // molWeight unknown from original file, set to 1 for incompressible fluid
        molWeight   1.0;
    }

    equationOfState
    {
        rho0    1.0;           // from rho
        T0      303.0;         // from TRef
        beta    0.0;           // forced convection case
    }

    thermodynamics
    {
        Cp      500;           // from Cp
        Hf      0;
    }

    transport
    {
        mu      1.0e-4;        // nu × rho
        Pr      0.01;          // from Cp, lambda, mu
    }
}

