FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         Euler;
}

gradSchemes
{
    default         Gauss linear;

}

divSchemes
{
    default none;

    div(alphaRhoPhi,U) Gauss linear;
    div(alphaRhoPhi,he) Gauss linear;
    div((nuEff*dev2(T(grad(U))))) Gauss linear;
    div((nuEff*dev(T(grad(U))))) Gauss linear;
    div(alphaRhoPhiNu,U) Gauss linear; 
    div(alphaRhoPhi,K) Gauss linear; 
}

laplacianSchemes
{
    default         Gauss linear uncorrected;
}


snGradSchemes
{
    default         uncorrected;
}
fluxRequired
{
    default         no;
    p_rgh;
}

interpolationSchemes
{
    default         linear;
}


