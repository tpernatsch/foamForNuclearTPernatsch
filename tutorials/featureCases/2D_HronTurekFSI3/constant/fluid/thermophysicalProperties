FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       polynomial;
    thermo          hPolynomial;
    equationOfState icoPolynomial;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        nMoles          1;
        molWeight       18.01528;
    }
    equationOfState
    {
        rhoCoeffs<8>       (1000 0 0 0 0 0 0 0);
    }
    thermodynamics
    {
        CpCoeffs<8>        (4184 0 0 0 0 0 0 0);
        Hf             0;
        Sf             0;
    }
    transport
    {
        muCoeffs<8>        (1 0 0 0 0 0 0 0);
        kappaCoeffs<8>     (10 0 0 0 0 0 0 0);
    }
}

