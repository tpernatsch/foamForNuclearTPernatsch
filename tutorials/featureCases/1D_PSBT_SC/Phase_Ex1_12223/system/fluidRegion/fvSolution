FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p_rgh
    {
        solver          GAMG;
        smoother        DIC;
        tolerance       1e-08;
        relTol          0;
    }
    p_rghFinal
    {
        solver          GAMG;
        smoother        DIC;
        tolerance       1e-08;
        relTol          0;
    }
    "h.*"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-08;
        relTol          0;
        minIter         0;
    }
    ".*"
    {
        solver          PBiCGStab;
        preconditioner  diagonal;
        tolerance       1e-06;
        relTol          0.001;
    }
    "alpha"
    {
        solver          implicitUpwind;
        solvePhase      vapour;
    }
}

PIMPLE
{
    nCorrectors     12;
    correctUntilConvergence true;
    nNonOrthogonalCorrectors 0;
    partialEliminationMode implicit;
    momentumMode    faceCentered;
    oscillationLimiterFraction 0;
    massTransferSafetyFactor 0.4;
    enthalpyStabilizationMode cutoff;
    pMin                    10000;
    pRefCell                0;
    pRefValue               100000;
    
    residualControl
    {
        p_rgh
        {
            tolerance       1e-06;
            relTol          0;
            useFirstPISOInitialResidual true;
        }
        h.liquid
        {
            tolerance       1e-06;
            relTol          0;
        }
    }
    solveEnergy         true;
    solveFluidMechanics true;
    nOuterCorrectors    12;
}

relaxationFactors
{
    equations
    {
        ".*"            1;
    }
    fields
    {
        "dmdt.*"        0.01;
        "phi.*"         0.8;
    }
}


