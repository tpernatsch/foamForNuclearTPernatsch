FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      regionsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


// Select two solvers
regionSolvers
{
    Level_0
    {
        ...
    }
}

// Mappings structure will be

//Neutronics --> Fluid : 
    // powerDensity --> powerDensityStructure  
    // secondaryPowerDensity --> powerDensityLiquid

//Fluid --> Neutronics : 
    // thermo:rho --> rhoCool
    // T.fuelAvForNeutronics --> TFuel
    // T.cladAvForNeutronics --> TClad

// For field names use
// https://foamfornuclear.gitlab.io/foamForNuclear/usersguide/GeN-Foam/coupling.html

mappings
{
    fluidRegion // target region
    {
        neutroRegion //source region 
        {
            targetFields (...); // this is the name of the field in the target region 
            sourceFields (...); // this is the name of the field in the source region 
        }
    }
    neutroRegion // target region
    {
        fluidRegion // source region
        {
            targetFields (...);
            sourceFields (...);
        }
    }
}


