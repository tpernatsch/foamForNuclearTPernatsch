FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      esfr_core__res;
}


// We want to simulate a full control rod insertion 10 seconds from BOC (160s) which is completed in 
// 0.25 seconds (160.25s) with an insertion speed of 9 m/s

// control rods is called "controlRod" and follower is "follower"

zones 
( 
    controlRod
    {
        startTime 160;
        endTime  160.25;
        speed 9; // positive entering the core
        initialDistanceFromMeshCR 0.0; // distance from the position defined in the mesh (postive towards the core) 
        followerName	follower; // name of the cellZone representing the follower
    } 

); 
