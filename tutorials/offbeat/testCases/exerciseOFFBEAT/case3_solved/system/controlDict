FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}

libs            ( "liboffbeat.so" );

application     offbeat;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         365;

deltaT          0.01;

writeControl    timeStep;

writeInterval   1;

purgeWrite      0;

writeFormat     ascii;

writeCompression off;

timeFormat      general;

timePrecision   6;

writePrecision  6;

userTime
{
    type            days;
}

functions
{
    fuelCenterline
    {
        type            probes;
        libs            ( "libsampling.so" );
        writeControl    timeStep;
        writeInterval   1;
        probeLocations  ( ( 0 0 0.055 ) );
        fields          ( T Bu );
    }
    fuelOuter
    {
        type            patchProbes;
        libs            ( "libsampling.so" );
        writeControl    timeStep;
        writeInterval   1;
        probeLocations  ( ( 0.0045 0 0.055 ) );
        patchName       fuelOuter;
        fields          ( gapWidth );
        patch           fuelOuter;
    }
    fuelRadialProfile
    {
        type            sets;
        libs            ( "libsampling.so" );
        writeControl    writeTime;
        interpolationScheme cell;
        setFormat       raw;
        sets            ( line { type uniform ; axis distance ; start ( 0 0 0.055 ) ; end ( 0.0045 0 0.055 ) ; nPoints 30 ; } );
        fields          ( T sigma );
    }
}

adjustableTimeStep true;

maxDeltaT       7;

minDeltaT       0.01;

maxRelativeDeltaTIncrease 1e+09;

minRelativeDeltaTDecrease 1e+09;

maxRelativePowerIncrease 1e+09;

maxRelativePowerDecrease 1e+09;

runTimeModifiable true;


