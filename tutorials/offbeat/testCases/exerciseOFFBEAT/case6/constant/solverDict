FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      solverDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Thermal and Mechanical solver selection:
thermalSolver
{
    type solidConduction;
}

mechanicsSolver
{
    type smallStrain;    
    forceSummary        off;  
    cylindricalStress   on;  

    multiMaterialCorrection
    {
        type                    uniform;
        defaultWeights          1;
    }
}

burnup
{
    type fromPower;
}

heatSource
{
    type timeDependentLhgr;
    timePoints  ( 0  0.04    364    364.04 365 );
    lhgr        ( 0  400e2  400e2  0      0);
    timeInterpolationMethod linear;
    
    axialProfile
    {
        type flat;
    }
    
    radialProfile
    {
        type    flat;
    }
    
    materials ( fuel );
}

fastFlux
{
    type            timeDependentAxialProfile;
    
    timePoints   ( 0 0.04 364 364.04 365);
    fastFlux     ( 0 1e+13 1e+13 0 0);
    timeInterpolationMethod linear;
    axialProfile
    {
        type            flat;
    }
    
    materials        (fuel cladding);
}

gapGas
{
    type Frapcon;

    gapPatches ( fuelOuter cladInner );
    holePatches ( );
    topFuelPatches    ( fuelTop );
    bottomFuelPatches ( fuelBottom );

    gapVolumeOffset 0.0;
    gasReserveVolume 0.0;
}

fissionGasRelease
{

}

rheology
{
    type byMaterial;
    modifiedPlaneStrain on;
    springModulus   3500;
    coolantPressureList
    {
        file            "$FOAM_CASE/constant/systemPressure";
        outOfBounds     clamp;
    }
}

sliceMapper
{
    type autoAxialSlices;
}

globalOptions
{
    pinDirection            (0 0 1);
    reactorType             "LWR";
}


materials
{
    fuel
    {
        material                    UO2;

        enrichment                  0.045;
        rGrain                      2.8e-05;
        GdContent                   0.0;
        theoreticalDensity          10960;
        densityFraction             0.95;
        dishFraction                0.0;

        densification
        {
            type empirical;
            densificationDensityChange   1;
            densificationTimeConstant   1000;
        }

        relocation
        {
            type UO2Frapcon;
            GapCold                     0.12e-3;
            DiamCold                    9e-3;
            outerPatch                  "fuelOuter";
        }

        swelling
        {
            type ;
        }

        damage
        {
            type isotropicCracking;
            nCracksMax 12;
        }
        
        constitutiveLaw
        {
            type elasticity;
        }
    }

    cladding
    {
        material                    Zircaloy;        

        swelling
        {

        }

        constitutiveLaw
        {
            type            misesPlasticCreep;
            yieldStress
            {
                type            constant;
                sigmaY          400000000.0;
            }

            creep
            {
                type            ZircaloyLimback;
                relax           0.9;
            }

        }

    }
}

