FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   ;

boundaryField
{
    ".*Front|.*Back"
    {
        type            wedge;
        value           $internalField;
    }

    fuelOuter
    {
        type            resistiveGap;
        patchType       regionCoupledOFFBEAT;
        kappa           k;
        coupled         true;
        alpha           ;

        roughness       uniform 2e-6;
        value           $internalField;
        relax           1;
    }

    cladInner
    {
        type            resistiveGap;
        patchType       regionCoupledOFFBEAT;
        kappa           k;
        coupled         true;
        alpha           ;
        
        roughness       uniform 0.5e-6;
        value           $internalField;
        relax           1;
    }

    cladOuter
    {
        type            fixedValue;
        value           ;
    }
}


