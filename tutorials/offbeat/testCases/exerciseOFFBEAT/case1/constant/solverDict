FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      solverDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Thermal and Mechanical solver selection:
thermalSolver
{
    type solidConduction;
}

mechanicsSolver
{
    type constant;
}

heatSource
{
    type timeDependentLhgr;
    timePoints  ( );
    lhgr        ( );
    timeInterpolationMethod linear;
    
    axialProfile
    {
        type flat;
    }
    
    radialProfile
    {
        type    flat;
    }
    
    materials ( fuel );
}

sliceMapper
{
    type autoAxialSlices;
}

globalOptions
{
    pinDirection            (0 0 1);
    reactorType             "LWR";
}


materials
{
    fuel
    {
        material                    UO2;

        conductivity
        {
            type           constant;
            value          ;
        }

        enrichment                  0.045;
        rGrain                      2.8e-05;
        GdContent                   0.0;
        theoreticalDensity          10960;
        densityFraction             0.95;
        dishFraction                0.0;

        constitutiveLaw
        {
            type elasticity;
        }
    }

    cladding
    {
        material                    Zircaloy;

        conductivity
        {
            type           constant;
            value          ;
        }

        constitutiveLaw
        {
            type elasticity;
        }
    }
}

