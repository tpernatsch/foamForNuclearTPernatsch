FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      D;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions          [0 1 0 0 0 0 0];

internalField       uniform (0 0 0);

boundaryField
{
    ".*Front|.*Back"
    {
        type            wedge;
    }
    
    fuelBottom
    {
        type            unilateralContact;
        relax           1;
        value           $internalField;
        planeNormal     (0 0 -1);
        // weights uniform 0;
        
        // contactRelRampWidth 0.1;
        contactRelOffset    1e-3;
        // penaltyScaleFactor  1.0;
    }
    
    cladBottom
    {
        type            fixedDisplacementZeroShear;
        relax           1;
        value           $internalField;
    }
    
    cladTop
    {
        type            topCladRingPressure;
        
        // topCap radius coolant side
        topCapOuterRadius 5.315e-3;
        
        // topCap radius plenum side
        topCapInnerRadius 4.565e-3;

        coolantPressureList    
        {
            // Specify location of the file
            file           "$FOAM_CASE/constant/systemPressure";
            
            // Treatement for out of bound values
            outOfBounds     clamp;
        };
        
        traction        uniform (0 0 0);
        pressure        uniform 15.5e6;
        
        // Relaxation factor for boundary gradient
        relax           1.0;
        
        // Plane strain approximation avoids end effect jumps due to coarse axial
        // discretization
        planeStrain     off;
        
        value           $internalField;
    }
    
    "fuelOuter|cladInner"
    {
        type            implicitGapContact;
        patchType       regionCoupledOFFBEAT;
        
        glued off;
        
        penaltyFactor              0.1;
        penaltyFactorFriction      0.001;        
        frictionCoefficient        0;
        
        relax 0.1;
        
        traction        uniform (0 0 0);
        pressure        uniform 2.25e6;
        value           $internalField;
    }
    
    "fuelTop_.*|fuelBottom_.*"
    {
        type            implicitGapContact;
        patchType       regionCoupledOFFBEAT;
        
        glued off;
        
        penaltyFactor              0.1;
        penaltyFactorFriction      0.001;        
        frictionCoefficient        0;
        
        offset -1e-16;
        relax 0.1;
        
        traction        uniform (0 0 0);
        pressure        uniform 2.25e6;
        value           $internalField;
    }
    
    fuelTop
    {
        type                  plenumSpringPressure;
        
        // Names of fuel top patches
        fuelTopPatches (fuelTop);
        
        // Names of cap inner patches 
        // If the cap is missing from the model, the top 
        // cladding pach should be used instead
        topCapInnerPatches (cladTop);

        springModulus         3.5e3;
        springPreCompression  0.001;
        
        relax           1.0;
        
        // Plane strain approximation avoids end effect jumps due to coarse axial
        // discretization
        planeStrain     off;

        value           $internalField;
    }

    fuelInner
    {
        type            gapPressure;
        relax           1.0;

        value           $internalField;
    }

    "dishChamferBottom_.*|dishChamferTop_.*"    
    {
        type            gapPressure;
        relax           1.0;
        value           $internalField;
    }
    
    cladOuter
    {
        type            coolantPressure;
    
        coolantPressureList    
        {
            file           "$FOAM_CASE/constant/systemPressure";
            outOfBounds     clamp;
        };
    
        traction        uniform (0 0 0);
        pressure        uniform 15.5e6;
        relax           1.0;
        value           $internalField;
    }
}

