FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     offbeat;

//- Run options:
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         35000;
deltaT          0.001;

//- Write options:
writeControl    timeStep;
writeInterval   1;
purgeWrite      0;
writeFormat     ascii;
writeCompression off;
timeFormat      general;
timePrecision   8;
writePrecision   6;

userTime        
{
    type            hours;
}

functions
{
    fuelCenterline
    {
        type            probes;
        fields           (T Bu);
        enabled         true;
        probeLocations   ((0.0 0.0 1.5));
        libs            ("libsampling.so");
    }

    radialProfile
    {
        type            sets;
        fields           (T sigma);
        writeControl    timeStep;
        interpolationScheme cellPatchConstrained;
        setFormat       csv;
        sets
        (
            line
            {
                type            uniform;
                axis            distance;
                nPoints         100;
                start           (0.0 0.0 1.395);
                end             (0.0045 0.0 1.395);
            }

        );

        libs            ("libsampling.so");
    }

    fuelOuter
    {
        type            patchProbes;
        fields
        (
            T
            Bu
            gapWidth
            interfaceP
            hGap
        );
        enabled         true;
        patches          (fuelOuter);
        patchName        "fuelOuter";
        probeLocations   (
            (0.0 0.0 1.49)
            (0.0 0.0 1.5)
        );
        libs            ("libsampling.so");
    }

}

//- Adjustable time step options:
adjustTimeStep true;

maxDeltaT         100;
minDeltaT         0.001;
maxRelativeDeltaTIncrease 2;
minRelativeDeltaTDecrease 1e9;
maxRelativePowerIncrease  1e9;
maxRelativePowerDecrease  1e9;
maxBurnupIncrease 0.1;
maxAverageCreep   1e-4;
maxMaximumCreep	  1e-4;
maxFGR			  1e-8;	

runTimeModifiable true;

// ************************************************************************* //
