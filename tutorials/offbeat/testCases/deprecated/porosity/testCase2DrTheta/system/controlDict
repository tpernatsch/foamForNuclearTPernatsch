FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

libs ("libsciantix.so");
libs ("liboffbeat.so");

application     offbeat;

//- Run options:
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         1e4;
deltaT          100;

//- Write options:
writeControl    timeStep;
writeInterval   1;
purgeWrite      5;
writeFormat     ascii;
writeCompression off;
timeFormat      general;
timePrecision   20;
writePrecision   6;

//- Adjustable time step options:
adjustableTimeStep true;

maxDeltaT         100;
minDeltaT         100;
maxRelativeDeltaTIncrease 1;
minRelativeDeltaTDecrease 1e9;
maxRelativePowerIncrease  1e9;
maxRelativePowerDecrease  1e9;
maxBurnupIncrease 0.1;
maxAverageCreep   1e-4;
maxMaximumCreep   1e-4;
maxFGR            1e-8;
maxCourantNoPorosity 0.25;

runTimeModifiable true;

adjustableWriteTimeStep true;
writeTimeStepList
(
    $endTime
);


