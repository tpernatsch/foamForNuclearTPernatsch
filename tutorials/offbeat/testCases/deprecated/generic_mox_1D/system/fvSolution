FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    D
    {
        solver          PCG;
        preconditioner  FDIC;
        tolerance       1e-10;
        relTol          0.1;
    }

    T
    {
        solver          PCG;
        preconditioner  FDIC;
        tolerance       1e-10;
        relTol          0.1;
    }

    "porosity|AmFormFactor|PuFormFactor"
    {
        solver          PBiCG;
        preconditioner  DILU;
        tolerance       1e-10;
        relTol          0.1;
    }
    neutronFlux0
    {
        solver          PCG;
        preconditioner  FDIC;
        tolerance       1e-10;
        relTol          0.1;
    }
}

stressAnalysis
{
    nCorrectors 3;     
    // nCorrectors     
    // {
    //     D 3;
    //     default 1;
    // }
    maxOuterIter    400;

    referencePairs  ();

    D                   (1e-5 1 1e-5);
    T                   1e-5;
    neutronFlux0        1e-5;
   
    porosity            1e-5;
    PuFormFactor        1e-5;
    AmFormFactor        1e-5;

    relD                1e-6;
    relT                1e-6;
    relneutronFlux0     1e-6;

    relporosity         1e-5;
    relPuFormFactor     1e-5;
    relAmFormFactor     1e-5;
}

relaxationFactors
{
    fields
    {
        D           0.8;
        porosity    0.7;       
        porosity    0.7;       
    }
}

