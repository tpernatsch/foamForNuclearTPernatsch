FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

d2dt2Schemes
{
    default         Euler;
}

ddtSchemes
{
    default         Euler;
}

gradSchemes
{
    default         leastSquaresImplicitContact;
}

divSchemes
{
    default                         Gauss linear;
    "div(flux,P)"                   Gauss upwind;
    "div(pmTerm,PuFormFactor)"      Gauss upwind;
    "div(soretTerm,PuFormFactor)"   Gauss upwind;
    "div(pmTerm,AmFormFactor)"      Gauss upwind;
    "div(soretTerm,AmFormFactor)"   Gauss upwind;
}

laplacianSchemes
{
    default Gauss linear corrected;
}

interpolationSchemes
{
    default linear;
}

snGradSchemes
{
    default         uncorrected;
}

fluxRequired
{
    default         no;
    D;
    T;
}

