FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      solverDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//- Thermal and Mechanical solver selection:
thermalSolver           solidConduction;
mechanicsSolver         smallStrain;
neutronicsSolver        fromLatestTime; //diffusion;
elementTransport        byList;

//- Material and rhelogy treatment:
materialProperties      byZone;
rheology                byMaterial;

heatSource              timeDependentLhgr;
burnup                  fromPower; //LassmannFBR;
fastFlux                timeDependentAxialProfile;
corrosion               fromLatestTime;
gapGas                  Frapcon;
fgr                     SCIANTIX;
sliceMapper             autoAxialSlices;
corrosion               fromLatestTime;

globalOptions
{
    pinDirection            (0 0 1);
    reactorType             "FBR";
}

thermalSolverOptions
{
    heatFluxSummary     off;
}

elementTransportOptions
{
    solvers
    ( 
        porosityTransport
        AmRedistribution
        PuRedistribution 
    );

    porosityOptions
    {
        boundedAdvectionTerm    on;
        diffusiveTerm           off;
    }

    "AmRedistributionOptions|PuRedistributionOptions"
    {
        poreMigration      off;
    }
}

rheologyOptions
{
    thermalExpansion on;
    modifiedPlaneStrain on;
    springModulus   3500;
    coolantPressureList
    {
        file            "$FOAM_CASE/constant/systemPressure";
        outOfBounds     clamp;
    }
    planeStress     off;
}

mechanicsSolverOptions
{
    forceSummary        off;  
    cylindricalStress   on; 

    multiMaterialCorrection
    {
        type                    uniform;
        defaultWeights          1;
        defaultWeightsGrad      0.0;
    }
}

fgrOptions
{
    nFrequency  1;
    relax       1;
    addToRegistry   true;

    SCIANTIX
    {
        iverification                                   0; // (0= no verification)
        igrain_growth                                   1; // (1 = ainscough)
        iinert_gas_behavior                             1; // (1= do IGB)
        igas_diffusion_coefficient                      1; // (1= Turnbull et al., 1988)
        iintra_bubble_evolution                         1; // (1=Pizzocri et al., 2018)
        ibubble_radius                                  1; // (1= Olander&Wongy, 2006)
        iresolution_rate                                1; // (1=Turnbull 1971)
        itrapping_rate                                  1; // (1= Ham 1958)
        inucleation_rate                                1; // (1= Baker 1971)
        isolver                                         1; // (1= SDA, Pizzocri et al., 2019)
        iformat_output                                  1; // (1 = output.txt, values separated by tabs)
        igrain_boundary_vacancy_diffusion_coefficient   1; // (1= Reynolds and Burton, 1979)
        igrain_boundary_behaviour                       1; // (1= do InterGranularGasBehavior - Pastore et al., 2013; Barani et al., 2017)
        igrain_boundary_micro_cracking                  1; // (1 = Barani et al., 2017)
        igrain_recrystallization                        0; // (0 = non active)
        ifuel_reactor_type                              0; // (0=UO2/PWR)
        igas_effective_coefficient                      1; // gas effective (=0) or single atom (=1)
        igas_sweeping                                   1; // add boundary gas sweeping
    }
}

gapGasOptions
{
    gapPatches ( fuelOuter cladInner );
    holePatches ();
    topFuelPatches    ( fuelTop);
    bottomFuelPatches ( fuelBottom);

    gapVolumeOffset 0.0;
    gasReserveVolume 0.0;
    gasReserveTemperature 290;
}

heatSourceOptions
{
    timePoints  ( 0  3600    15768000 );
    lhgr        ( 0  30e3    29e3 );
    timeInterpolationMethod linear;

    axialProfile
    {
        type constantTabulated;
        #include "axialProfile";
        axialInterpolationMethod step;
    }

    radialProfile
    {
        type    flat;
    }

    materials ( fuel );
}

fastFluxOptions
{
    timePoints  ( 0  3600     1.26E+08 );
    fastFlux    ( 0  2e14     2e14 );
    timeInterpolationMethod linear;

    axialProfile
    {
        type flat;
    }

    materials ( fuel cladding );
}


materials
{
    fuel
    {
        material                    UPuO2;
        Tref                        Tref [ 0 0 0 1 0 ] 293;

        densificationModel  UO2Frapcon;
        relocationModel     UO2Frapcon;
        swellingModel       UPuO2Fbr;

        conductivityModel       MaUPuO2Magni; // UPuO2Magni2020; // UPuO2Philipponeau;
        YoungModulusModel       UPuO2SckCen;
        thermalExpansionModel   UPuO2Lemehov;

        rGrain                      5e-06;
        GdContent                   0.0;
        theoreticalDensity          11077;
        densityFraction             0.975;
        dishFraction                0.0;

        resinteringDensityChange    1;
        GapCold                     0.300e-3;
        DiamCold                    5.40e-3; // cold fuel diameter
        recoveryFraction            0.5;
        outerPatch                  "fuelOuter";

        isotropicCracking           on;
        nCracksMax                  12;

        rheologyModel   misesPlasticCreep;
        rheologyModelOptions
        {
            plasticStrainVsYieldStress table ( ( 0 3e+08 ) );
            creepModel          RoutbortFastMOXCreepModel;
            irradiationCreep    on;

            NewtonRaphsonMethod on;
            NewtonRaphsonTolerance 1e-3;

            creepRateLimiter    on;
            creepRateLimit      4.1e-6;

            relaxCreep          0.1;
        }

        poreVelocityModel   vaporPressureMOX;

        oxygenMetalRatio 1.98;
        isotopes
        {
            U
            {
                ratioOverMetal  0.71;
                massNumbers (235 238);
                weightFractions (0.003359 0.996641);
            }
            Pu
            {
                ratioOverMetal  0.26;
                massNumbers (238 239 240 241 242);
                weightFractions (0.013 0.604 0.234 0.104 0.045);
            }
            Am
            {
                ratioOverMetal  0.03;
                massNumbers (241 243);
                weightFractions (1 0);
            }
        }
    }

    cladding
    {
        material        Steel1515Ti;
        Tref            Tref [ 0 0 0 1 0 ] 293;
        emissivityModel ZircaloyConstant;
        PoissonRatioModel ZircaloyConstant;
        swellingModel   Steel1515TiGeneralized;
        rheologyModel   misesPlasticCreep;
        rheologyModelOptions
        {
            plasticStrainVsYieldStress table ( ( 0 6.91e+08 ) );
            creepModel      Steel1515TiAim1Tobbe;
            relaxCreep      1;
        }
    }
}

