FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

libs ("libsciantix.so");
libs ("liboffbeat.so");

application     offbeat;

//- Run options:
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         14400;
deltaT          0.0001;

//- Write options:
writeControl    runTime;
writeInterval   1440;
purgeWrite      0;
writeFormat     ascii;
writeCompression off;
timeFormat      general;
timePrecision   20;
writePrecision   6;

//- Adjustable time step options:
adjustableTimeStep true;

maxDeltaT         10.0;
minDeltaT         0.001;
maxRelativeDeltaTIncrease 1.1;
minRelativeDeltaTDecrease 1.1;
maxRelativePowerIncrease  1.1;
maxRelativePowerDecrease  1.1;
maxBurnupIncrease 0.1;
maxAverageCreep   1e-4;
maxMaximumCreep	  1e-4;
maxFGR			  1e-8;	

runTimeModifiable true;


