FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      function;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


    enthalpyVolAverage
    {
        type            volFieldValue;
        functionObjectLibs ( "libfieldFunctionObjects.so" );
        writeFields     true;
        writeControl    timeStep;
        writeInterval   1;
        operation       volAverage;
        regionType      cellZone;
        name            fuel;
        fields          ( enthalpy );
    }


