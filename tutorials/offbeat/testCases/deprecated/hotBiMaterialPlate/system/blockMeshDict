            (0 7 9 3)  // f-left-w (v0 v6 v9 v3)
        );
    }
    right
    {
        type patch;
        faces
        (
            (2 5 11 8)  // f-right-n (v2 v5 v11 v8)
        );
    }
    top
    {
        type symmetry;
        faces
        (
            (4 3 9 10)  // f-left-n (v4 v3 v9 v10)
            (5 4 10 11)  // f-right-n (v5 v4 v10 v11)
        );
    }
    bottom
