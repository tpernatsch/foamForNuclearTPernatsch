FoamFile
{
    version         2;
    format          ascii;
    class           volVectorField;
    location        "0";
    object          DD;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 0 1 0 0 0 0 0 ];

internalField   uniform ( 0 0 0 );

boundaryField
{
    top
    {    
        type            symmetry;
        value           uniform ( 0 0 0 );
    }

    bottom
    {
        type            fixedValue;
        value           uniform ( 0 0 0 );
    }
    
    "front|back"
    {
        type            wedge;
    }

    inner
    {
        type            coolantPressure;
        coolantPressureList
        {
            coolantPressureList table
            (
                ( 0             100000.0)
                ( 1000.000000	100000.00 )
                ( 2000.000000	7500000.00 )
            );
            outOfBounds     clamp;
        }
        traction        uniform ( 0 0 0 );
        relax           1;
        value           $internalField;
    }

    outer
    {
        type            tractionDisplacement;
        pressure        uniform 100000;
        traction        uniform ( 0 0 0 );
        relax           1;
        value           $internalField;
    }
}


