FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    D
    {
        solver          PCG;
        preconditioner  FDIC;
        tolerance       1e-10;
        relTol          0.1;
    }

    T
    {
        solver          PCG;
        preconditioner  FDIC;
        tolerance       1e-10;
        relTol          0.1;
    }

    neutronFlux0
    {
        solver          PCG;
        preconditioner  FDIC;
        tolerance       1e-10;
        relTol          0.1;
    }
}

stressAnalysis
{
    nCorrectors     1;
    maxOuterIter    1000;

    referencePairs  ();

    D                   (1e-7 1 1e-7);
    T                   1e-7;
    neutronFlux0        1e-7;

    relD                1e-7;
    relT                1e-7;
    relneutronFlux0     1e-7;
}

relaxationFactors
{
    fields
    {
        D   0.8;
        // T   0.8;
        // neutronFlux0   0.9;
    }
    /*
    equations
    {
        D   0.7;
        T   0.7;
    }
    */
}

