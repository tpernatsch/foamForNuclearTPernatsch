FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

libs ("libsciantix.so");
libs ("liboffbeat.so");

application     offbeat;

//- Run options:
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         1576800;
deltaT          78840;

//- Write options:
writeControl    timeStep;
writeInterval   10;
purgeWrite      0;
writeFormat     ascii;
writeCompression off;
timeFormat      general;
timePrecision   20;
writePrecision   20;

functions 
{ 
    #includeFunc  probes
}

//- Adjustable time step options:
adjustableTimeStep off;

maxDeltaT         6.048e5;
minDeltaT         0.001;
maxRelativeDeltaTIncrease 1e9;
minRelativeDeltaTDecrease 1e9;
maxRelativePowerIncrease  1e9;
maxRelativePowerDecrease  1e9;
maxBurnupIncrease 0.1;
maxAverageCreep   1e-4;
maxMaximumCreep	  1e-4;
maxFGR			  1e-8;	

runTimeModifiable true;

//- Adjustable write step:
adjustableWriteTimeStep true;

writeTimeStepList (1 788400 1576800);


