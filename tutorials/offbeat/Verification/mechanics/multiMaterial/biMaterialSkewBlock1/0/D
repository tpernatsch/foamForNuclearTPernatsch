FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      D;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions          [ 0 1 0 0 0 0 0 ];

internalField       uniform ( 0 0 0 );

boundaryField
{
    left
    {
        type            tractionDisplacement;
        pressure        uniform 1e6;
        traction        uniform (0 0 0);
        value           uniform (0 0 0);
    }
    right
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    "top|bottom"
    {
        type            cyclic;
    }
    fontAndBackPlanes
    {
        type            empty;
    }
}

