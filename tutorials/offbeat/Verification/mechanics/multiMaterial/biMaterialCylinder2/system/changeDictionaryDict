FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      changeDictionaryDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

boundary
{
    symmetry1
    {
        type            cyclicAMI;
        neighbourPatch  symmetry2;
        transform       rotational;
        rotationAxis    (0 0 1);
        rotationCentre  (0 0 0);
        //rotationAngle 30; // optional
    }
    symmetry2
    {
        type            cyclicAMI;
        neighbourPatch  symmetry1;
        transform       rotational;
        rotationAxis    (0 0 1);
        rotationCentre  (0 0 0);
    }
}
