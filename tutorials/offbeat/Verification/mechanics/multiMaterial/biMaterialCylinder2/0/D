FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      D;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 0 1 0 0 0 0 0 ];

internalField   uniform ( 0 0 0 );

boundaryField
{
    inner
    {
        type            fixedValue;
        value           uniform ( 0 0 0 );
    }
    outer
    {
        type            fixedTorque;
        torque          1;
        axis            ( 0 0 1 );
        centre          ( 0 0 0 );
        value           uniform ( 0 0 0 );
        pressure        uniform 0;
        traction        uniform ( 0 0 0 );
    }
    "symmetry[12]"
    {
        type            cyclicAMI;
    }
}
