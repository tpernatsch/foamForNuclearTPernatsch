type            surfaces;
libs            ("libsampling.so");
writeControl    writeTime;
surfaceFormat   raw;
fields
(
    sigmaCyl
);
interpolationScheme cellPoint;

surfaces
(
    claddingInnerSurface
    {
        type        patch;
        patches     (claddingInnerSurface);
        triangulate false;
    }
);


