FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "D|DD"
    {
        solver          PBiCGStab;
        preconditioner
        {
            preconditioner  GAMG;
            smoother        FDIC;
        }
        tolerance       1e-10;
        relTol          1e-3;
    }
    
    T
    {
        solver          PCG;
        preconditioner  FDIC;
        tolerance       1e-8;
        relTol          1e-3;
    }
}

stressAnalysis
{
    nCorrectors     30;
    maxOuterIter    100;

    referencePairs  ();
    DD              (1e-6 1e-6 1e-6);
    D               (1e-9 1e-6 1e-6);
    T               1e-8;

    useRelResD off;
    relT    1e-6;
    relD    1e-6;
    
    accelerationScheme
    {
        type    andersonMixing;
        order   28;
        alpha   1;
        diagonalFactor  1e-7;
    }
}

relaxationFactors
{
    equations
    {
        //"D|DD"  1;
    }
}

