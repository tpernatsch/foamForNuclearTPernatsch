#!/bin/bash
cd ${0%/*} || exit 1    # Run from this directory
set -o pipefail

# Source tutorial run functions
. "$WM_PROJECT_DIR/bin/tools/RunFunctions"

runApplication -o blockMesh 
# runApplication -o setSet -batch setBatch 
# runApplication -o setsToZones 

rm -f results
STATUS=0

for correction in rhieChow multiMaterial
do
    cp -f constant/solverDict.$correction constant/solverDict
    
    for solver in smallStrain largeStrainTotLag
    do
        echo Testing $solver with $correction | tee -a results
        runApplication -o foamDictionary constant/solverDict -entry mechanicsSolver -set $solver
        runApplication -o foamListTimes -rm
        rm -rf postProcessing
        
        runApplication -o offbeat 

        if [[ $WM_PROJECT_VERSION == *v* ]]
        then    
            runApplication -o postProcess -func xyGraph_ESI
            gnuplot plots.gnuplot > log.gnuplot 
            python3 test_ESI.py | tee -a results
        else
            runApplication -o postProcess -func xyGraph 
            gnuplot plots.gnuplot > log.gnuplot 
            python3 test.py | tee -a results
        fi
        
        STATUS=$(expr $? "|" $STATUS)
        
        echo "" | tee -a results
    done
done

exit $STATUS

