FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      sigmaHyd;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    "wedge.*"
    {
        type            wedge;
    }

    claddingOuterSurface
    {
        type            extrapolatedFixedValue;
        relax           1;
        value           $internalField;

    }
    claddingInnerSurface
    {
        type            extrapolatedFixedValue;
        relax           1;
        value           $internalField;
    }
    "bottom.*|top.*"
    {
        type empty;
    }
}

