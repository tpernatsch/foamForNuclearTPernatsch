FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //



application     offbeat;

//- Run options:
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         360;
deltaT          1;

//- Write options:
writeControl    timeStep;
writeInterval   1;
purgeWrite      0;
writeFormat     ascii;
writeCompression off;
timeFormat      general;
timePrecision   20;
writePrecision  12;

//- Adjustable time step options:
adjustableTimeStep true;

maxDeltaT         1;
minDeltaT         1;
maxRelativeDeltaTIncrease 1e9;
minRelativeDeltaTDecrease 1e9;
maxRelativePowerIncrease  1e9;
maxRelativePowerDecrease  1e9;
maxBurnupIncrease 1e9;
maxAverageCreep   1e-4;
maxMaximumCreep   1e-4;
maxFGR            1e-8;
maxCourantNoPorosity  0.25;

runTimeModifiable true;

adjustableWriteTimeStep true;
writeTimeStepList
(
    180
    360
);


