FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

libs ("libsciantix.so");
libs ("liboffbeat.so");

application     offbeat;

//- Run options:
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         1000;
deltaT          0.05;

userTime
{
    type  days;
}

//- Write options:
writeControl    runTime;
writeInterval   1000;
purgeWrite      1;
writeFormat     ascii;
writeCompression off;
timeFormat      general;
timePrecision   12;
writePrecision   6;

//- Adjustable time step options:
adjustableTimeStep true;

maxDeltaT         10;
minDeltaT         0.05;
maxRelativeDeltaTIncrease 1e9;
minRelativeDeltaTDecrease 1e9;
maxRelativePowerIncrease  1e9;
maxRelativePowerDecrease  1e9;
maxRelativeTemperatureIncrease  0.01;
maxRelativeTemperatureDecrease  0.01;
maxBurnupIncrease 0.1;
maxAverageCreep   1e-4;
maxMaximumCreep	  1e-4;
maxFGR			  1e-8;
maxConcentrationChange      5;

runTimeModifiable true;

functions
{
    graphs
    {
        start           (4.574303205e-3 0 0.5e-3);
        end             (5.324188977e-3 0 0.5e-3);
        nPoints         61;
        fields          ( T Css Cpp Ctot KG KN KD TSSp TSSd );
        axis            distance;
        #includeEtc     "caseDicts/postProcessing/graphs/graphUniform.cfg"
    }

    average
    {
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");

        writeControl    runTime;
        writeInterval   100;
        writeFields     false;

        regionType      cellZone;
        name            cladding;
        operation       volAverage;

        fields
        (
            Css
            Cpp
            Ctot
        );
    }
}

