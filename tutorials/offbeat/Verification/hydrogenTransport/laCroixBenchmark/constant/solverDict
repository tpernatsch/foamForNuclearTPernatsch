FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      solverDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//- Select the physics to solve for
thermalSolver           solidConduction;
mechanicsSolver         smallStrain;
neutronicsSolver        none;
elementTransport        byList;

materialProperties      byZone;
rheology                byMaterial;

heatSource              timeDependentVhgr;
burnup                  constant;
fastFlux                constant;
fgr                     none;
gapGas                  none;
sliceMapper             none;
corrosion               constant;

globalOptions
{
    reactorType         none;
    pinDirection        (0 0 1);
}

