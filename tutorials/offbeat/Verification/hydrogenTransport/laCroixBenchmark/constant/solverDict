thermalSolverOptions
{
    heatFluxSummary     off;
}

rheologyOptions
{
    thermalExpansion    off;
}

mechanicsSolverOptions
{
    forceSummary        off;  
    cylindricalStress   off;

    RhieChowCorrection  off;
}

materials
{
    sample
    {
        material                Zircaloy;
        Tref                    Tref [ 0 0 0 1 0 ] 293;

        rheologyModel           elasticity;
    }
}

elementTransportOptions
{
    solvers ( HNGD );
    
    HSolverOptions
    {
        effectiveTSSp   false;
        stressDrivenDiffusion   false;
	    Q*        25500;
 		V_H       1.7e-6;     

		HDiffusionCoefficientModel  HDiffusionCoefficientBison;
	                                 
        materials
        {
            sample
            {
                TSSdModel   TSSdGeneric;
				TSSpModel   TSSpGeneric;
                TSSd0       16.552e5;
                Qd          50660;
                TSSp0       6.8e4;
                Qp          29770;
            }
        }
    }
}

