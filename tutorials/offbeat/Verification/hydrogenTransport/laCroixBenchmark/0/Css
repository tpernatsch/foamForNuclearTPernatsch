FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      Css;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    ".*"
    {
        type            hydrogenTransport;
        gradient        uniform 0;
        ingressRate     uniform 0;
        value           uniform 0;
    }
}


