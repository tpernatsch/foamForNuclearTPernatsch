FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      Cpp;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 254;

boundaryField
{
    ".*"
    {
        type            zeroGradient;
        value           $internalField;
    }
}


