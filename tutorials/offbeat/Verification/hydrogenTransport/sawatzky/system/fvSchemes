FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

d2dt2Schemes
{
    default         Euler;
}

ddtSchemes
{
    default         Euler;
}

gradSchemes
{
    default         leastSquares;
}

divSchemes
{
    div(phi,Css)    Gauss limitedLinear 0.5;
    default         Gauss linear;
}

laplacianSchemes
{
    laplacian(k,T)  Gauss harmonic corrected;
    laplacian(DD,D) Gauss harmonic corrected;
    laplacian(DH,Css) Gauss harmonic corrected;
}

interpolationSchemes
{
    default linear;
}

snGradSchemes
{
    default         uncorrected;
}

fluxRequired
{
    default         no;
    D;
    T;
    Css;
}


