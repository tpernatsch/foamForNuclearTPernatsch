FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


application     offbeat;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         3542400;

deltaT          0.1;

adjustableTimeStep  yes;
maxDeltaT           600;
minDeltaT           0.01;
maxRelativeDeltaTIncrease 1.25;
minRelativeDeltaTDecrease 1e9;
maxRelativePowerIncrease  1e9;
maxRelativePowerDecrease  1e9;
maxBurnupIncrease   1e9;
maxAverageCreep     1e9;
maxMaximumCreep     1e9;
maxFGR              1e9;
maxConcentrationChange  1;

writeControl    runTime;

writeInterval   708480;

purgeWrite      0;

writeFormat     ascii;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

functions
{
    graphs
    {
        start           (0.0254 0.005 0.005);
        end             (0 0.005 0.005);
        nPoints         201;
        fields          ( T Css Cpp Ctot KG KN KD TSSp TSSd );
        axis            distance;
        #includeEtc "caseDicts/postProcessing/graphs/graphUniform.cfg"
    }
}

