FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    D
    {
        solver          PCG;
        smoother        GaussSeidel;
        preconditioner  FDIC;
        tolerance       1e-10;
        relTol          0.1;
        nCellsCoarsestLevel 20;
    }
    T
    {
        solver          PCG;
        preconditioner  FDIC;
        tolerance       1e-8;
    }
    Css
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-10;
        minIter         1;
    }
    Cpp
    {
        solver          diagonal;
    }
}

stressAnalysis
{
    nCorrectors     2;
    maxOuterIter    100;

    referencePairs  ();

    T               1e-6;
    relT            1e-4;
    D               (1e-6 1e-6 1e-6);
    relD            1e-4;
    Css             1e-10;
}

relaxationFactors
{}

