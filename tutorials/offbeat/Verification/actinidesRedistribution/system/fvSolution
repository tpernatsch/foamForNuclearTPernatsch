FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "AmFormFactor|PuFormFactor|T"
    {
        solver          PBiCG;
        preconditioner  DILU;
        tolerance       1e-10;
        relTol          0.01;
    }
 }

stressAnalysis
{
    nCorrectors     1;
    maxOuterIter    1000;

    referencePairs  ();

    T               1e-7;
    PuFormFactor    1e-7;
    AmFormFactor    1e-7;

    relT            1e-9;
    relPuFormFactor 1e-40;
    relAmFormFactor 1e-40;
    relD    1e-6;
}

relaxationFactors
{
    fields
    {
        T               0.8;
        PuFormFactor    0.8;
    }
}

