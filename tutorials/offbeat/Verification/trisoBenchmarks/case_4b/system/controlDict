FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //



application     offbeat;

//- Run options:
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         1e7;
deltaT          1e3;

//- Write options:
writeControl    runTime;
writeInterval   0.5e6;
purgeWrite      1;
writeFormat     ascii;
writeCompression off;
timeFormat      general;
timePrecision   6;
writePrecision   6;

functions
{
    #includeFunc  probes
}

//- Adjustable time step options:
adjustableTimeStep true;

maxDeltaT         1e5;
minDeltaT         1;
maxRelativeDeltaTIncrease 1e9;
minRelativeDeltaTDecrease 1e9;
maxRelativePowerIncrease  1e9;
maxRelativePowerDecrease  1e9;
maxBurnupIncrease 0.1;
maxAverageCreep   1e-4;
maxMaximumCreep	  1e-4;
maxFGR			  1e-8;

runTimeModifiable true;


