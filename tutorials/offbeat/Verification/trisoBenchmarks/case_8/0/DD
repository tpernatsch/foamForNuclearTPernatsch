FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      DD;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions          [0 1 0 0 0 0 0];

internalField       uniform (0 0 0);

boundaryField
{
    "bottom|top|front|back"
    {
        type            wedge;
    }

    outer
    {
        type            tractionDisplacement;
        traction        uniform (0 0 0);
        pressure        uniform 0.1e6;
        value           uniform (0 0 0);
    }

    inner
    {
        type            tractionDisplacement;
        traction        uniform (0 0 0);
        pressureList
        {
            type    table;

            values
            (
                (0.0       0)
                (0.8352e7  0.14e6)
                (0.864e7   0.02e6)
                (1.6992e7  0.94e6)
                (1.728e7   0.04e6)
                (2.5632e7  2.59e6)
                (2.592e7   0.07e6)
                (3.4272e7  4.87e6)
                (3.456e7   0.10e6)
                (4.2912e7  7.64e6)
                (4.32e7    0.14e6)
                (5.1552e7  10.79e6)
                (5.184e7   0.20e6)
                (6.0192e7  14.26e6)
                (6.048e7   0.26e6)
                (6.8832e7  17.99e6)
                (6.912e7   0.33e6)
                (7.7473e7  21.96e6)
                (7.776e7   0.41e6)
                (8.6112e7  26.13e6)
                (8.64e7    0.50e6)
            );

            outOfBounds         clamp;     // optional out-of-bounds handling
            interpolationScheme linear;    // optional interpolation method
        }
        value           uniform (0 0 0);
    }


}

