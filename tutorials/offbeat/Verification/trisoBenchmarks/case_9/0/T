FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 1576;

boundaryField
{
    "bottom|top|front|back"
    {
        type            wedge;
    }

    bufferOuter
    {
      type            trisoGap;
      patchType       regionCoupledOFFBEAT;
      kappa           k;
      coupled         true;
      roughness       uniform 1e-6;
      jumpDistance    uniform 0.0;
      value           $internalField;
      relax           1;
    }
    //
    ipycInner
    {
      type            trisoGap;
      patchType       regionCoupledOFFBEAT;
      kappa           k;
      coupled         true;
      roughness       uniform 1e-6;
      jumpDistance    uniform 0.0;
      value           $internalField;
      relax           1;
    }

    outer
    {
        type            fixedValue;
        value           uniform 1576;
    }

}


