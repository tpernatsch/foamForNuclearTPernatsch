FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //



application     offbeat;

//- Run options:
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         10;
deltaT          10;

//- Write options:
writeControl    runTime;
writeInterval   1;
purgeWrite      1;
writeFormat     ascii;
writeCompression off;
timeFormat      general;
timePrecision   20;
writePrecision   6;


functions 
{ 
   #includeFunc  radialProfile_ESI
}

//- Adjustable time step options:
adjustableTimeStep false;

maxDeltaT         1e6;
minDeltaT         1e-3;
maxRelativeDeltaTIncrease 1e9;
minRelativeDeltaTDecrease 1e9;
maxRelativePowerIncrease  1;
maxRelativePowerDecrease  1;
maxBurnupIncrease 0.1;
maxAverageCreep   1e9;
maxMaximumCreep   1e9;
maxFGR            1e9;  

runTimeModifiable true;


