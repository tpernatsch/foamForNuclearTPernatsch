FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "constant";
    object          solverDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

mechanicsSolver     fromLatestTime;
thermalSolver       solidConduction;
neutronicsSolver    fromLatestTime;
elementTransport    fromLatestTime;

materialProperties      byZone;
rheology                byMaterial;
heatSource              timeDependentLhgr;
burnup                  fromLatestTime;
fastFlux                fromLatestTime;
gapGas                  none;
fgr                     none;
sliceMapper             autoAxialSlices;
corrosion               fromLatestTime;

globalOptions
{
    pinDirection    ( 0 0 1 );
    reactorType     "LWR";
}

thermalSolverOptions
{
    heatFluxSummary  on;
}

heatSourceOptions
{
    timePoints  ( 0 3600 14400 18000 24000  );
    lhgr        ( 0 30e3 30e3  0     0      );

    "axialProfile|radialProfile"
    {
        type    flat;
    }

    materials   ( tube );
}

materials
{
    tube
    {
        material constant;

        rho         rho     [1 -3 0 0 0]    6560;
        Cp          Cp      [0 2 -2 -1 0]   285;
        k           k       [1 1 3 -1 0]    2;
        emissivity emissivity [0 0 0 0 0]   0.808642;
        E           E       [1 -1 -2 0 0]   9.93e10;
        nu          nu      [0 0 0 0 0]     0.37;
        G           G       [1 -1 -2 0 0]   3.6241e+10;
        alpha       alpha   [0 0 0 0 0]     6e-6;
        Tref        Tref    [0 0 0 1 0]     300;
        
        rheologyModel   elasticity;
    }
}


