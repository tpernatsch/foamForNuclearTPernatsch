FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "DD|D"
    {
        solver          PCG;
        smoother        GaussSeidel;
        preconditioner  FDIC;
        tolerance       1e-7;
        relTol          0.01;
    }

    "T"
    {
        solver          PCG;
        preconditioner  FDIC;
        tolerance       1e-10;
        relTol          0.01;
    }

    "porosity|I"
    {
        solver          PBiCG;
        preconditioner  DILU;
        tolerance       1e-10;
        relTol          0.01;
    }

    cellDisplacement
    {
        solver          PCG;
        smoother        GaussSeidel;
        preconditioner  FDIC;
        tolerance       1e-10;
        relTol          0.1;
        nCellsCoarsestLevel 20;
    }
 }

stressAnalysis
{
    nCorrectors     1;
    maxOuterIter    1000;

    referencePairs  ();

    T               1e-6;
    porosity        1e-6;
    D               (1e-6 1e-6 1e-6);

    relD            1e-6;
    relT            1e-3;
    relporosity     1e-6;
}

relaxationFactors
{
    fields
    {
        T           0.9;
    }
}

