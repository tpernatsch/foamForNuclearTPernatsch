FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //



application         offbeat;

//- Run options:
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         10;
deltaT          1;

//- Write options:
writeControl    timeStep;
writeInterval   1;
purgeWrite      1;
writeFormat     ascii;
writeCompression off;
timeFormat      general;
timePrecision   20;
writePrecision   6;

adjustableTimeStep false;

maxDeltaT                   1e9;
minDeltaT                   1e9;
maxRelativeDeltaTIncrease   1e9;
minRelativeDeltaTDecrease   1e9;
maxRelativePowerIncrease    1e9;
maxRelativePowerDecrease    1e9;
maxBurnupIncrease           1e9;
maxAverageCreep             1e9;
maxMaximumCreep             1e9;
maxFGR                      1e9; 
maxCourantNoPorosity        1e9;

runTimeModifiable           true;

adjustableWriteTimeStep     false;

// ************************************************************************* //
