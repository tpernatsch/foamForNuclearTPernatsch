Description
    Writes out patch surface files with interpolated field data in VTK format.

\*---------------------------------------------------------------------------*/
type            surfaces;
libs            ("libsampling.so");

writeControl    writeTime;

surfaceFormat   raw;

interpolationScheme cellPoint;

fields      ( T Tcoolant);

surfaces
(
    patch
    {
        type        patch;
        interpolate false;
        patches     ( outerSurface );
    }
);


