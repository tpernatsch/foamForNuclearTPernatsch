FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 293;

boundaryField
{
    fuelOuter
    {
        type            uniformFixedValue;
        patchType       regionCoupledOFFBEAT;
        uniformValue table           
        (
            (0 293)
            (1 500)
        );
    }

    cladInner
    {
        type            fixedValue;
        patchType       regionCoupledOFFBEAT;
        value           $internalField;
    }
    cladOuter
    {
        type            fixedValue;
        value           uniform 293;
    }
    front
    {
        type            wedge;
        value           $internalField;
    }
    back
    {
        type            wedge;
        value           $internalField;
    }
}


