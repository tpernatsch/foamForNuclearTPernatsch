#!/bin/sh
# Run from this directory
cd "${0%/*}" || exit 1

# Source tutorial run functions
. "$WM_PROJECT_DIR/bin/tools/RunFunctions"

runApplication -o blockMesh
runApplication -o changeDictionary
runApplication -o offbeat
#
runApplication -o postProcess -func sampleDict

epsilon1_Simulation=$(cat postProcessing/sampleDict/10/left/symmTensorField/epsilonSwelling | grep -oE '[^ ]+' | sed -n '4p')
epsilon2_Simulation=$(cat postProcessing/sampleDict/10/right/symmTensorField/epsilonSwelling | grep -oE '[^ ]+' | sed -n '4p')

epsilon1_Expected=-0.155198206124898
epsilon2_Expected=-0.193952890624666

#
echo "Swelling strain at 623.15K: $epsilon1_Simulation" >> results
echo "Expected value: $epsilon1_Expected" >> results
echo "Swelling strain at 1623.15K: $epsilon2_Simulation" >> results
echo "Expected value: $epsilon2_Expected" >> results


relError1=`echo - | awk '{print 100*(var1-var2)/var2}' \
var1="$epsilon1_Simulation" var2="$epsilon1_Expected"`
relError2=`echo - | awk '{print 100*(var1-var2)/var2}' \
var1="$epsilon2_Simulation" var2="$epsilon2_Expected"`


echo "Relative error for swelling strain at  623.15K: $relError1%" >> results
echo "Relative error for swelling strain at  1623.15K: $relError2%" >> results
