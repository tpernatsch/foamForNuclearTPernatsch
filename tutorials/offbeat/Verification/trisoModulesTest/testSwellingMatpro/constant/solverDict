FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      solverDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//- Thermal and Mechanical solver selection:
thermalSolver           solidConduction;
mechanicsSolver         smallStrain;//smallStrainIncrementalUpdated;
neutronicsSolver        fromLatestTime;
elementTransport        fromLatestTime;

//- Material and rhelogy treatment:
materialProperties      byZone;
rheology                byMaterial;

heatSource              timeDependentVhgr;
burnup                  fromPower;
fastFlux                none;
corrosion               fromLatestTime;
gapGas                  none;
fgr                     none;
sliceMapper             autoAxialSlices;

globalOptions
{
    pinDirection            (0 0 1);
    reactorType             "LWR";
}

thermalSolverOptions
{
    heatFluxSummary     off;
}


heatSourceOptions
{
    timePoints  (0.0    1e9);
    vhgr        (3561803753.40845 3561803753.40845);
    // fission_rate * energy_per_fission
    // = 1.11306367294014E+020 f/m³/s * 3.2e-11 J/f
    materials ( fuel );
}

rheologyOptions
{
    thermalExpansion off;
    // solvePressureEqn on;
    // pressureSmoothingScaleFactor 0.1;
}

mechanicsSolverOptions
{
    // multiMaterialCorrection
    // {
    //     type                    uniform;
    //     defaultWeights          0;
    // }
    forceSummary        off;
    cylindricalStress   on;
    sphericalStress     on;

    multiMaterialCorrection
    {
      type                    cellZone;
      interfaceWeights        1;
      defaultWeights          0.9;//0.9;
    }
}

materials
{
  //writeProperties true;
  fuel
  {
    material UO2;
    densityModel            constant;//UO2Constant;
    heatCapacityModel       UO2Matpro;
    conductivityModel       UO2Matpro;
    emissivityModel         constant;
    YoungModulusModel       constant;//UO2Matpro;
    PoissonRatioModel       constant;//UO2Constant;
    thermalExpansionModel   UO2Relap;
    //
    densificationModel          none;//UO2Frapcon;
    swellingModel               UO2Matpro;
    relocationModel             none;
    failureModel                none;


    emissivity emissivity [0 0 0 0 0]   0.0;
    rho         rho     [1 -3 0 0 0]    10773.0;
    // a very small value to avoid any mechnical interaction with the layers
    E           E       [1 -1 -2 0 0]   2e11;
     nu          nu      [0 0 0 0 0]     0.345;
     alpha       alpha   [0 0 0 0 0]     10e-6;
    Tref        Tref    [0 0 0 1 0]     1600;

      // //
      enrichment                  0.0982;
      rGrain                      5e-6;
      // GdContent                   0.0;
      theoreticalDensity          10960;
      densityFraction             0.9863; //10810.0
      dishFraction                0.0;
      //resinteringDensityChange    0.3;
      //
      //
      isotropicCracking           off;

      rheologyModel               elasticity;
  }


}

// ************************************************************************* //
