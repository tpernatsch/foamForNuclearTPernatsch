FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "D|DD"
    {
        solver          PCG;
        preconditioner  FDIC;
        tolerance       1e-10;
        relTol          0.1;
    }

    T
    {
        solver          PCG;
        preconditioner  FDIC;
        tolerance       1e-10;
        relTol          0.1;
    }
    // sigmaHyd
    // {
    //     solver          PCG;
    //     preconditioner  FDIC;
    //     tolerance       1e-09;
    //     relTol          0.1;
    // }
 /*
    neutronFlux0
    {
        solver          PCG;
        preconditioner  FDIC;
        tolerance       1e-10;
        relTol          0.1;
    }
    */
}

stressAnalysis
{
    nCorrectors     10;
    maxOuterIter    10000;

    referencePairs  ();

    D                   (1e-5 1 1);
    DD                   (1e-5 1 1);
    T                   1e-5;
    neutronFlux0        1e-5;

    relD                1e-8;
    relT                1e-6;
    relneutronFlux0     1e-6;
}

relaxationFactors
{
    fields
    {
        D   0.8;
        // DD   0.8;
        // T   0.8;
        // neutronFlux0   0.9;
    }
    /*
    equations
    {
        D   0.7;
        T   0.7;
    }
    */
}

