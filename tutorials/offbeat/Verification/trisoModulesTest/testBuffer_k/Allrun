#!/bin/sh
# Run from this directory
cd "${0%/*}" || exit 1

# Source tutorial run functions
. "$WM_PROJECT_DIR/bin/tools/RunFunctions"

runApplication -o blockMesh
runApplication -o changeDictionary
runApplication -o offbeat
#
runApplication -o postProcess -func sampleDict

k_Simulation=$(cat postProcessing/probes/0/k |tail -n 1| awk '{print $NF}')

k_Expected=0.464684014869888
#
echo "Thermal conductivity of density 900 kg/m³: $k_Simulation" >> results
echo "Expected value: $k_Expected" >> results


relErrorK=`echo - | awk '{print 100*(var1-var2)/var2}' \
var1="$k_Simulation" var2="$k_Expected"`


echo "Relative error for thermal conductivity of density 900 kg/m³: $relErrorK%" >> results
