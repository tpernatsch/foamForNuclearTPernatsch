FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 600.0;

boundaryField
{
    "bottom|back|left"
    {
        type            uniformFixedValue;
        uniformValue    600.0;
    }

    "top|front|right"
    {
        type            zeroGradient;
    }
}


