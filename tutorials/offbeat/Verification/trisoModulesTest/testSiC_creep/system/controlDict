FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //



application     offbeat;

//- Run options:
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         200e6;
deltaT          1e7;

//- Write options:
writeControl    runTime;
writeInterval   10e6;
purgeWrite      1;
writeFormat     ascii;
writeCompression off;
timeFormat      general;
timePrecision   6;
writePrecision   6;

functions
{
    #includeFunc  probes
}

//- Adjustable time step options:
adjustableTimeStep true;

maxDeltaT         2e7;
minDeltaT         1.0;
maxRelativeDeltaTIncrease 1e9;
minRelativeDeltaTDecrease 1e9;
maxRelativePowerIncrease  1e9;
maxRelativePowerDecrease  1e9;
maxBurnupIncrease 0.1;
maxAverageCreep   1e-4;
maxMaximumCreep	  1e-4;
maxFGR			  1e-8;

runTimeModifiable true;
valueAverage1
{
    // Mandatory entries (unmodifiable)
    type              valueAverage;
    libs              (fieldFunctionObjects);

    // Mandatory entries (runtime modifiable)
    functionObject    <fieldAverage>;                       // forceCoeffs1;
    fields            (epsilonCreep.XX);    // (Cm Cd Cl);

    // Optional entries (runtime modifiable)
    resetOnRestart    false;
    window            0.5;

    // Optional (inherited) entries
    writePrecision    8;
    writeToFile       true;
    useUserTime       true;
    region            region0;
    enabled           true;
    log               true;
}

