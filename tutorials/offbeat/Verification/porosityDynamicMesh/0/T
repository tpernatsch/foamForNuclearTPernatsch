FoamFile
{
    version         2;
    format          ascii;
    class           volScalarField;
    location        "0";
    object          T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 0 0 0 1 0 0 0 ];

internalField   uniform 300;

boundaryField
{
    ".*Front|.*Back"
    {
        type            wedge;
    }
    ".*Top|.*Bottom"
    {
        type            empty;
    }
    fuelOuter
    {
        type            timeDependentTemperature;
        temperatureSeries
        {
            values()        ;
            outOfBounds     clamp;
            interpolationScheme linear;
            values          ( ( 0 295 ) ( 251280 1156 ) );
        }
        value           $internalField;
    }
    fuelInner
    {
        type            zeroGradient;
    }
}


