FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      sample;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type            sets;
libs            ("libsampling.so");

interpolationScheme cellPoint;

setFormat       csv;

sets
(
    radial
    {
        type        face;
        start       (0.0 0.0 0.0005);
        end         (1.0 0.0 0.0005);
        axis        distance;
    }
);

fields
(
    porosity
);

