#!/bin/sh

# Ensure the script runs from its directory
cd "$(dirname "$0")" || exit 1

# Source tutorial run functions
. "$WM_PROJECT_DIR/bin/tools/RunFunctions"
. "$WM_PROJECT_DIR/bin/tools/CleanFunctions"

# List of perturbations to be tested
perturbs="1.25"

# Define paths
dict="./system/userParameters"
unit="[ 0 0 0 0 0 0 0 ]"
bDict="behavioralModels"

# Remove and create results file
rm -f ./results && touch ./results

for perturb in $perturbs; do

    # Clean case
    cleanCase || { echo "Error: cleanCase failed"; exit 1; }

    # Create mesh
    python3 rodMaker.py && mv blockMeshDict system || { echo "Error: Mesh generation failed"; exit 1; }
    runApplication -o blockMesh || { echo "Error: blockMesh failed"; exit 1; }
    runApplication -o collapseEdges -overwrite || { echo "Error: collapseEdges failed"; exit 1; }

    # Set user parameters
    foamDictionary "$dict" -entry "$bDict/densification/F_epsilonDensification" -set "$unit $perturb"
    foamDictionary "$dict" -entry "$bDict/relocation/F_epsilonRelocation" -set "$unit $perturb"
    foamDictionary "$dict" -entry "$bDict/swelling/UO2Frapcon/F_epsilonSwelling" -set "$unit $perturb"

    # Run simulation
    runApplication -o offbeat

    wait 

    # Store final temperature results in file
    temp=$(tail -1 ./postProcessing/probes/0/T | cut -d " " -f7)

    if [ -z "$temp" ]; then
        echo "Error: Could not extract temperature data" >> ./results
        exit 1
    fi

    # Write in results file
    echo "Perturb. behav. models $perturb : $temp K" >> ./results
done

# Expected result
expectedResult=1040.01
echo "Expected result perturb. $perturb: $expectedResult K" >> ./results

# Compute relative error
relErr=$(python3 -c "print(($temp - $expectedResult) / $expectedResult)")

echo "Relative error: $relErr" >> ./results

# Determine test result
decision=$(python3 -c "print('passed' if abs($relErr) < 0.005 else 'failed')")

echo "Test $decision" >> ./results

#------------------------------------------------------------------------------
