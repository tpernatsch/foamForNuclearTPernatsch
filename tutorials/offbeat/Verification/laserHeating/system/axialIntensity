FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      sample;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type            sets;
libs            ("libsampling.so");

interpolationScheme cellPointFace;

setFormat       csv;

sets
(
    axial
    {
        type        lineCellFace;
        start       (0.5e-3 0.5e-3 0);
        end         (0.5e-3 0.5e-3 1);
        axis        distance;
    }
);

fields
(
    I
);

