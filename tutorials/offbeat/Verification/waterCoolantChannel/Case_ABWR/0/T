FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300.0;

boundaryField
{
    ".*Front|.*Back"
    {
        type            wedge;
        value           $internalField;
    }
    
    fuelOuter
    {
        type            fuelRodGap;
        patchType       regionCoupledOFFBEAT;
        kappa           k;
        coupled         true;

        roughness       uniform 2.2e-6;
        value           $internalField;
        relax           1;
    }

    cladInner
    {
        type            fuelRodGap;
        patchType       regionCoupledOFFBEAT;
        kappa           k;
        coupled         true;
        
        roughness       uniform 0.5e-6;
        value           $internalField;
        relax           1;
    }

    cladOuter
    {
        type                    coolantChannel;
        value                   uniform 300.0;
            kappa                   k;
        hydraulicDiameter       0.010431;
        massFlowRate            uniform 0.16631;
        flowArea                0.000101148;
            flowDirection           1.0;
        relax                   1;
        enthalpyModel           1;
        inletTemperatureList    
        {
            file           "$FOAM_CASE/constant/inletTemperature";
            outOfBounds     clamp;
        };
        coolantPressureList    
        {
            file           "$FOAM_CASE/constant/systemPressure";
            outOfBounds     clamp;
        };
        maxPicardIter 10;
        correlations
        {
            singlePhase         Gnielinski;
            onb                 Basu;
            chf                 GroeneveldTable;
            subcooledBoiling    Rohsenow;
            saturatedBoiling    Rohsenow;
            filmBoiling         GroeneveldAnnular; 
            transitionBoiling   McDonoughMilichKing;
            leidenfrost         GroeneveldStewartCorrected;
        }

    }
}

