FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300.0;

boundaryField
{
    ".*Front|.*Back"
    {
        type            wedge;
        value           $internalField;
    }

    fuelOuter
    {
        type            fuelRodGap;
        patchType       regionCoupledOFFBEAT;
        kappa           k;
        coupled         true;

        roughness       uniform 2.2e-6;
        value           $internalField;
        relax           1;
    }

    cladInner
    {
        type            fuelRodGap;
        patchType       regionCoupledOFFBEAT;
        kappa           k;
        coupled         true;
        
        roughness       uniform 0.5e-6;
        value           $internalField;
        relax           1;
    }

    cladOuter
    {
        type            coolantChannel;
        value           uniform 300.0;
        hydraulicDiameter 0.012011;
        massFlowRate    uniform 0.2214;
        relaxHTC 0.1;
        enthalpyModel 1;
        flowArea 1.03308e-4;
        enthalpyModel 1;
        inletTemperatureList    
        {
            file           "$FOAM_CASE/constant/inletTemperature";
            outOfBounds     clamp;
        };
        coolantPressureList    
        {
            file           "$FOAM_CASE/constant/systemPressure";
            outOfBounds     clamp;
        };
        correlations
        {
            ONB                 Basu;
            CHF                 lookuptableGroeneveld;
            SubcooledBoiling    Rohsenow;
            SaturatedBoiling    Rohsenow;
            Leidenfrost         GroeneveldStewartCorrected;
            FilmBoiling         GroeneveldAnnular; 
        }
    }
}

