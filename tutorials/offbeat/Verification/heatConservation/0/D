FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      D;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions          [0 1 0 0 0 0 0];

internalField       uniform (0 0 0);

boundaryField
{
    top
    {
        type            tractionDisplacement;
        traction        uniform (0 0 0);
        pressure        uniform 15.5e6;
        relax           1.0;
        value           $internalField;
    }
    cladOuter
    {
        type            tractionDisplacement;
        traction        uniform (0 0 0);
        pressure        uniform 15.5e6;
        relax           1.0;
        value           $internalField;
    }
    fuelOuter
    {
        type            gapContact;
        patchType       regionCoupledOFFBEAT;
        penaltyFactor   0.1;
        relax           1.0;
        relaxInterfacePressure 0.1;
        traction        uniform (0 0 0);
        pressure        uniform 2.25e6;
        value           $internalField;
    }
    cladInner
    {
        type            gapContact;
        patchType       regionCoupledOFFBEAT;
        penaltyFactor   0.1;
        relax           1.0;
        relaxInterfacePressure 0.1;
        traction        uniform (0 0 0);
        pressure        uniform 2.25e6;
        value           $internalField;
    }
    fuelTop
    {
        type            tractionDisplacement;
        traction        uniform (0 0 0);
        pressure        uniform 2.25e6;
        relax           1.0;
        value           $internalField;
    }
    fuelBottom
    {
        type            fixedDisplacementZeroShear;
        value           $internalField;
    }
    bottom
    {
        type            fixedDisplacementZeroShear;
        value           $internalField;
    }
    front
    {
        type            wedge;
    }
    back
    {
        type            wedge;
    }
}

