FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300;

boundaryField
{
    top
    {
        type            zeroGradient;
        value           $internalField;
    }
    fuelTop
    {
        type            zeroGradient;
        value           $internalField;
    }
    fuelOuter
    {
        type            fuelRodGap;
        patchType       regionCoupledOFFBEAT;
        kappa           k;
        coupled         true;
        alpha           uniform 5000;
        roughness       uniform 2.2e-6;
        value           $internalField;
        relax           0.1;
    }

    cladInner
    {
        type            fuelRodGap;
        patchType       regionCoupledOFFBEAT;
        kappa           k;
        coupled         true;
        alpha           uniform 5000;
        roughness       uniform 0.5e-6;
        value           $internalField;
        relax           0.1;
    }
    cladOuter
    {
        type            fixedValue;
        value           uniform 600;
    }
    topCap
    {
        type            zeroGradient;
        value           $internalField;
    }
    fuelBottom
    {
        type            zeroGradient;
        value           $internalField;
    }
    bottom
    {
        type            zeroGradient;
        value           $internalField;
    }
    front
    {
        type            wedge;
        value           $internalField;
    }
    back
    {
        type            wedge;
        value           $internalField;
    }
}


