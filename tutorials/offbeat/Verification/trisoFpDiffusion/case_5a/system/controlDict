FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

libs            ( "libsciantix.so" );

libs            ( "liboffbeat.so" );

application     offbeat;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         8.64e+07;

deltaT          86400;

writeControl    timeStep;

writeInterval   40;

purgeWrite      1;

writeFormat     ascii;

writeCompression off;

timeFormat      general;

timePrecision   6;

writePrecision  6;

functions
{
    #includeFunc    probes
}

adjustableTimeStep false;

maxDeltaT       3600;

minDeltaT       1;

maxRelativeDeltaTIncrease 1e+09;

minRelativeDeltaTDecrease 1e+09;

maxRelativePowerIncrease 1e+09;

maxRelativePowerDecrease 1e+09;

maxBurnupIncrease 0.1;

maxAverageCreep 0.0001;

maxMaximumCreep 0.0001;

maxFGR          1e-08;

runTimeModifiable true;


