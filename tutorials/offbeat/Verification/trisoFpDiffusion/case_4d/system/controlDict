// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}

libs            ( "liboffbeat.so" );

application     offbeat;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         4.32e+07;

deltaT          86400;

writeControl    timeStep;

writeInterval   20;

purgeWrite      1;

writeFormat     ascii;

writeCompression off;

timeFormat      general;

timePrecision   6;

writePrecision  6;

functions
{
    probes
    {
        points          ( ( 0 0 1.5 ) );
        probeLocations  ( ( 0 0 1.5 ) );
        fields          ( T Bu );
        type            probes;
        libs            ( "libsampling.so" );
        writeControl    timeStep;
        writeInterval   1;
    }
}

adjustableTimeStep false;

maxDeltaT       3600;

minDeltaT       1;

maxRelativeDeltaTIncrease 1e+09;

minRelativeDeltaTDecrease 1e+09;

maxRelativePowerIncrease 1e+09;

maxRelativePowerDecrease 1e+09;

maxBurnupIncrease 0.1;

maxAverageCreep 0.0001;

maxMaximumCreep 0.0001;

maxFGR          1e-08;

runTimeModifiable true;


