FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    D
    {
        solver          PCG;
        smoother        GaussSeidel;
        preconditioner  FDIC;
        tolerance       1e-10;
        relTol          0.1;
    }

    T
    {
        solver          PCG;
        preconditioner  FDIC;
        tolerance       1e-10;
        relTol          0.01;
    }

    nFlux
    {
        solver          PCG;
        preconditioner  FDIC;
        tolerance       1e-10;
        relTol          0.01;
    }
}

stressAnalysis
{
    nCorrectors     1;
    maxOuterIter    1000;

    referencePairs  ();

    D               (1e-6 1 1e-6);
    T               1e-6;

    relD            1e-6;
    relT            1e-6;
}

neutronicsAnalysis
{
    nCorrectors     1;
    maxOuterIter    1000;

    nFlux           1e-6;
    relnFlux        1e-6;
}

relaxationFactors
{
    fields
    {
        //D       0.9;
        //T       0.9;
        //nFlux   0.9;
    }
    equations
    {
        //D   0.7;
        //T   0.7;
    }
}

