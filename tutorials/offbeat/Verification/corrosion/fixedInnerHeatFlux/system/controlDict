FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

libs ("libsciantix.so");
libs ("liboffbeat.so");

application     offbeat;

//- Run options:
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         1000;
deltaT          0.01;

userTime
{
    type  days;
}

//- Write options:
writeControl    runTime;
writeInterval   1000;
purgeWrite      5;
writeFormat     ascii;
writeCompression off;
timeFormat      general;
timePrecision   20;
writePrecision   6;


//- Adjustable time step options:
adjustableTimeStep true;

maxDeltaT         1;
minDeltaT         0.01;
maxRelativeDeltaTIncrease 1.25;
minRelativeDeltaTDecrease 1e9;
maxRelativePowerIncrease  1e9;
maxRelativePowerDecrease  1e9;
maxBurnupIncrease 0.1;
maxAverageCreep   1e-4;
maxMaximumCreep	  1e-4;
maxFGR			  1e-8;	

runTimeModifiable true;

DebugSwitches
{
    ZircaloyOuterCorrosion  1;
}

functions
{
    probes
    {
        type    patchProbes;
        
        probeLocations
        (
            (0.005324 0 0)
        );

        fields  ( oxideThickness );
        patchName   cladOuter;
        patch      cladOuter;
        
        executeControl  timeStep;
        writeControl    timeStep;
    }
}

