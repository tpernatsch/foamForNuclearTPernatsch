FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      solverDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//- Thermal and Mechanical solver selection:
thermalSolver           solidConduction;
mechanicsSolver         constant;
neutronicsSolver        none;
elementTransport        none;

//- Material and rhelogy treatment:
materialProperties      byZone;
rheology                byMaterial;

heatSource              constant;
burnup                  constant;
fastFlux                constant;
gapGas                  none;
fgr                     none;
sliceMapper             byMaterial;
corrosion               byPatch;

globalOptions
{
    pinDirection            (0 0 1);
    reactorType             "LWR";
}

rheologyOptions
{
    modifiedPlaneStrain  off;
}

corrosionOptions
{
    patches
    {
        right
        {
            corrosionModel ZircaloyOuterCorrosion;
            oxidationKineticsModel EPRI-SLI|Cathcart-Pawel-Prater-Courtright;
            // Parameters for EPRI/SLI correlation
            Li  2.2;
            Sn  1.5;
            Fe  0;
        }
    }
}

materials
{
    cladding
    {
        material        constant;
        rho             rho [ 1 -3 0 0 0 ] 6560;
        Cp              Cp [ 0 2 -2 -1 0 ] 285;
        k               k [ 1 1 3 -1 0 ] 21.5;
        emissivity      emissivity [ 0 0 0 0 0 ] 0;
        E               E [ 1 -1 -2 0 0 ] 1.10501e+10;
        nu              nu [ 0 0 0 0 0 ] 0.454;
        G               G [ 1 -1 -2 0 0 ] 3.8e+09;
        alpha           alpha [ 0 0 0 0 0 ] 0;
        Tref            Tref [ 0 0 0 1 0 ] 293;
        

        nSlices         1;

        rheologyModel   elasticity;
        rheologyModelOptions {}
    }
}

