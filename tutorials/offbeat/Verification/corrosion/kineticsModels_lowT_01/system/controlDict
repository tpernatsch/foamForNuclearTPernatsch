FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     offbeat;

// Run options (time is user units)
startFrom       startTime;
startTime       0;
stopAt          endTime;

userTime
{
    type  days;
}

endTime         1000;
deltaT          1;

//- Write options (time in seconds)
writeControl                runTime;
writeInterval               1000;
purgeWrite                  0;
writeFormat                 ascii;
writeCompression            off;
timeFormat                  general;
timePrecision               6;
writePrecision              6;

adjustableTimeStep          false;
runTimeModifiable           true;

functions
{
    oxideThickness
    {
        type            patchProbes
        libs            (sampling);
        patchName       right;
        fields          ( T oxideThickness );
        probeLocations
        (
            (0.01 0 0)
        );
        executeControl  timeStep;
        writeControl    timeStep;
    }
}

DebugSwitches
{
    ZircaloyOuterCorrosion  1;
}

