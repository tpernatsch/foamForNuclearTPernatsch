FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     offbeat;

// Run options (time is user units)
startFrom       latestTime;
startTime       0;
stopAt          endTime;

endTime         1000;
deltaT          100;

//- Write options (time in seconds)
writeControl                runTime;
writeInterval               1000;
purgeWrite                  0;
writeFormat                 ascii;
writeCompression            off;
timeFormat                  general;
timePrecision               20;
writePrecision              6;

adjustableTimeStep          false;
runTimeModifiable           true;

DebugSwitches
{
    ZircaloyOuterCorrosion  1;
}

functions
{
    oxideThickness
    {
        fields              ( T oxideThickness );
        patch               cladOuter;
        interpolate false;
        
        #includeEtc "caseDicts/postProcessing/surface/patchSurface.cfg"
        surfaceFormat       raw;
    }
}

