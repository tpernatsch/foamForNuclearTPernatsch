FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    D
    {
        solver          PCG;
        smoother        GaussSeidel;
        preconditioner  FDIC;
        tolerance       1e-10;
        relTol          0.1;
        nCellsCoarsestLevel 20;
    }

    T
    {
        solver          PCG;
        preconditioner  FDIC;
        tolerance       1e-10;
        relTol          0.01;
    }
}

stressAnalysis
{
    maxOuterIter    10;
}

relaxationFactors
{
}

