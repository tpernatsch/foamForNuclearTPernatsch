FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

d2dt2Schemes
{
    default         steadyState;
}

ddtSchemes
{
    default         steadyState;
}

gradSchemes
{
    default         leastSquares;
}

divSchemes
{
    default         Gauss linear;
}

laplacianSchemes
{
    laplacian(k,T)  Gauss harmonic corrected;
    laplacian(DD,D) Gauss harmonic corrected;
}

interpolationSchemes
{
	default linear;
    interpolate(k)          harmonic;
    interpolate(2mu+lambda) harmonic;
}

snGradSchemes
{
    default         corrected;
}

fluxRequired
{
    default         no;
    D;
    T;
}


