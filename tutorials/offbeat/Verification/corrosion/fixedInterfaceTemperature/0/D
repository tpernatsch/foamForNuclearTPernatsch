FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      D;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions          [0 1 0 0 0 0 0];

internalField       uniform (0 0 0);

boundaryField
{
    "front|back"
    {
        type            wedge;
    }
    cladOuter
    {
        type            tractionDisplacement;
        traction        uniform (0 0 0);
        pressure        uniform 15.5e6;
        relax           1.0;
        value           $internalField;
    }
    cladInner
    {
        type            tractionDisplacement;
        traction        uniform (0 0 0);
        pressure        uniform 5e6;
        relax           1.0;
        value           $internalField;
    }

}

