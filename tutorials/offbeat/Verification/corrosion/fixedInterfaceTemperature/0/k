FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      fastFlux;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 1 -3 -1 0 0 0];

internalField   uniform 1;

boundaryField
{
    cladInner
    {
        type            zeroGradient;
    }
    cladOuter
    {
        type            resistiveLayer;
        alpha           uniform 1;
        value           $internalField;
    }
    cladBottom
    {
        type            empty;
    }
    cladTop
    {
        type            empty;
    }
    front
    {
        type            wedge;
    }
    back
    {
        type            wedge;
    }
}


