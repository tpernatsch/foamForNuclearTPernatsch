FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       polynomial;
    thermo          hPolynomial;
    equationOfState perfectGas;
    specie          specie;
    energy          sensibleEnthalpy;
}


mixture
{
    specie
    {
        molWeight               4.0; // 
    }
    thermodynamics
    {
        CpCoeffs<8>             (5195 0 0 0 0 0 0 0); //
        Hf                      0;
        Sf                      0;
    }
    transport
    {
        muCoeffs<8>             (5.02373903e-06  5.62735701e-08 -2.38488053e-11  1.18681675e-14 -3.50285341e-18  4.39544144e-22 0 0); 
        kappaCoeffs<8>          (3.04140540e-02  4.87700827e-04 -2.93201897e-07  2.16256326e-10 -9.73867749e-14  1.91187374e-17 0 0);
    }
}


