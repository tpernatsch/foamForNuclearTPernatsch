FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;    // General thermophysical model calculation
                                    // based on enthalpy h or internal energy e,
                                    // and density rho
    mixture         pureMixture;
    properties      liquid;         // Thermophysical properties implemeted in 
                                    // the OpenFOAM source code format.
    energy          sensibleEnthalpy;
}

mixture
{
    // Hydrogen model that model the molecular hydrogen dissociation at 
    // high-temperature
    H2;
}

