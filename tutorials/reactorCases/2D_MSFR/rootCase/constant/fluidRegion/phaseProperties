// ------------------------------------------------------------------------- //
// --- STRUCTURES PROPERTIES ----------------------------------------------- //
// ------------------------------------------------------------------------- //

structureProperties
{
    "intermed:main_fd"
    {
        volumeFraction      0;
        Dh                  1;
    }

    "hx"
    {
        volumeFraction      0.6;
        Dh                  0.01;

        powerModel
        {
            type            fixedTemperature;
            volumetricArea  200;
            T               900;
        }
    }

    "pump"
    {
        volumeFraction      0;
        Dh                  1;

        pump
        {
            momentumSource      (0 0 -300000);
        }
    }
}

// ------------------------------------------------------------------------- //
// --- REGIME PHYSICS FOR EACH REGIME -------------------------------------- //
// ------------------------------------------------------------------------- //

physicsModels
{
    dragModels
    {
        "hx"
        {
            type    ReynoldsPower;
            coeff   0.5;
            exp     -0.25;
        }
    }

    heatTransferModels
    {
        "hx"
        {
            type    constant;
            value   1e+4;
        }
    }
}


