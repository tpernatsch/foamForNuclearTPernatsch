FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/fluidRegion";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "p_rgh.*"
    {
        solver          GAMG;
        smoother        DIC;

        tolerance       1e-9;
        relTol          1e-3;
        maxIter         100;
    }

    "p_rgh.*Final"
    {
        $p_rgh;
        relTol          0;
    }

    "(U|k|epsilon|omega|R)"
    {
        solver          GAMG;
        smoother        GaussSeidel;

        tolerance       1e-9;
        relTol          1e-3;
        maxIter         100;
    }

    "(U|k|epsilon|omega|R)Final"
    {
        $U;
        relTol          0;
    }

    T
    {
        solver          PBiCG;
        preconditioner  DILU;

        tolerance       1e-9;
        relTol          1e-3;
        maxIter         100;
    }

    TFinal
    {
        $T;
        relTol          0;
    }

    "flux.*"
    {
        solver          GAMG;
        smoother        DIC;

        tolerance       1e-9;
        relTol          1e-3;
        maxIter         100;
    }

    "flux.*Final"
    {
        $flux1;
        relTol          0;
    }

    "(prec|dec).*"
    {
        solver          GAMG;
        smoother        GaussSeidel;

        tolerance       1e-9;
        relTol          1e-3;
        maxIter         100;
    }

    "(prec|dec).*Final"
    {
        $prec1;
        relTol          0;
    }
}

PIMPLE
{
    momentumPredictor   yes;
    nOuterCorrectors    1;
    nCorrectors         2;
    nNonOrthogonalCorrectors 0;

    pRefCell            0;
    pRefValue           0;
}

relaxationFactors
{
    equations
    {
        ".*"            1;
    }
}

