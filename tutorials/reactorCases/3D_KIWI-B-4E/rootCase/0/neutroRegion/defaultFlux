FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/neutroRegion";
    object      defaultFlux;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 -2 -1 0 0 0 0];

internalField   uniform 1;

boundaryField
{
    "(inlet|outlet|defaultFaces)"
    {
        type            albedoSP3;
        gamma           0.5;
        diffCoeffName   Dalbedo;
        fluxStarAlbedo  fluxStarAlbedo;
        forSecondMoment false;
        value           uniform 1;
    }
}

