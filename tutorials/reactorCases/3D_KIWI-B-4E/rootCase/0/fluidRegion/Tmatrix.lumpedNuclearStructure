FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/fluidRegion";
    object      Tmatrix.lumpedNuclearStructure;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }
    outlet
    {
        type            zeroGradient;
    }
    defaultFaces
    {
        type            zeroGradient;
    }
    baffle_master
    {
        type            zeroGradient;
    }
    baffle_slave
    {
        type            zeroGradient;
    }
    inletFuelElement
    {
        type            zeroGradient;
        patchType       cyclic;
    }
    inletFuelElement_slave
    {
        type            zeroGradient;
        patchType       cyclic;
    }
    outletFuelElement
    {
        type            zeroGradient;
        patchType       cyclic;
    }
    outletFuelElement_slave
    {
        type            zeroGradient;
        patchType       cyclic;
    }
}


