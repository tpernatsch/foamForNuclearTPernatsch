FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p_rgh
    {
        solver          GAMG;
        smoother        DIC;
        tolerance       1e-4;
        relTol          1e-2;
    }

    p_rghFinal
    {
        solver          GAMG;
        smoother        DIC;
        tolerance       1e-4;
        relTol          0;
    }

    "e.*"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-5;
        relTol          1e-2;
        minIter         1;
    }

    "h.*"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-5;
        relTol          1e-2;
        minIter         1;
    }

    ".*"
    {
        solver          PBiCGStab;
        preconditioner  diagonal;
        tolerance       1e-05;
        relTol          1e-2;
    }
}

PIMPLE
{
    momentumPredictor   yes;
    correctPhi          yes;
    nOuterCorrectors    1;
    nCorrectors         1;
    nNonOrthogonalCorrectors 0;
    momentumMode        faceCentered;
    solveEnergy         true;
    solveFluidMechanics true;
    pMin                1e4;
    pRefCell            0;
    pRefValue           1e5;
}

relaxationFactors
{
    fields
    {
        ".*"            0.7;
        "p_rgh.*"       1;
    }
    equations
    {
        ".*"            1;
        "h.*"           0.7;
        "e.*"           0.7;
        "k.*"           0.7;
    }
}

