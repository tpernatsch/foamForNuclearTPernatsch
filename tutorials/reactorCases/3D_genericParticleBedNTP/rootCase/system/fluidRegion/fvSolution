FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p_rgh
    {
        solver          GAMG;
        smoother        FDIC;
        tolerance       1e-6;
        relTol          0.01;
    }

    p_rghFinal
    {
        $p_rgh;
        relTol          0;
    }

    "e.*"
    {
        solver          PBiCGStab;//smoothSolver;
        smoother        symGaussSeidel;
        preconditioner  diagonal;
        tolerance       1e-5;
        relTol          0.1;
        minIter         0;
    }

    "h.*"
    {
        solver          PBiCGStab;//smoothSolver;
        preconditioner  diagonal;
        smoother        symGaussSeidel;
        tolerance       1e-5;
        relTol          0.1;
        minIter         0;
    }

    ".*"
    {
        solver          PBiCGStab;
        preconditioner  diagonal;
        tolerance       1e-4;
        relTol          0.1;
    }
}

PIMPLE
{
    // momentumPredictor   yes;
    // correctPhi          yes;
    nCorrectors         1;
    nNonOrthogonalCorrectors 0;
    // nOuterCorrectors    3;
    momentumMode                faceCentered;
    solveEnergy             true;   
    solveFluidMechanics     true;

    pMin            10000;
    pRefCell        0;
    pRefValue       100000;
}

relaxationFactors
{
    fields//equations
    {
        ".*"            0.6;
    }
}

