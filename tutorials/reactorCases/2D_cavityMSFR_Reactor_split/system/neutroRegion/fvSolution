FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/neutroRegion";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "prec.*|precStar.*"
    {
        solver           PBiCG;
        preconditioner   DILU;
        tolerance        1e-6;
        relTol           1e-1;
    }

    "flux.*"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-6;
        relTol          1e-1;
    }
}

neutronTransport
{
    integralPredictor           false;
    implicitPredictor           false;
    aitkenAcceleration          true;
    neutronIterationResidual    0.000001;
    maxNeutronIterations        50;
}

