FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Single-zone homogeneous cavity: the XS module requires every mesh
// cellZone to be represented in nuclearData, and cross sections are only
// populated for cells that belong to a matching cellZone -- so the whole
// domain needs to be tagged as one zone ("main"), even with just one state.

actions
(
    {
        type        cellSet;
        name        main;
        action      new;
        source      boxToCell;
        sourceInfo
        {
            box (-10 -10 -10) (10 10 10);
        }
    }

    {
        name        main;
        type        cellZoneSet;
        action      new;
        source      setToCellZone;
        sourceInfo
        {
            set         main;
        }
    }
);

