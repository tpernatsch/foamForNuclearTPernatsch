FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      neutronicsProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// eigenvalueNeutronics keeps Keff (in 0/uniform/reactorState) rescaled every
// iteration to drive the computed power toward "power" in that same file --
// the native equivalent of msfrParcelFoam's calcKeff.H addition.
eigenvalueNeutronics    true;

// Liquid (molten-salt) fuel: precursors are advected by the mapped-in flow
// velocity, matching msfrParcelFoam's own precEqns.H treatment.
liquidFuel              true;

fastNeutrons            true;

adjustDiscFactors       false;

useGivenDiscFactors     false;

