FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      defaultFlux;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 -2 -1 0 0 0 0];

// Template every flux0..flux5 group field is initialized from (including
// its boundary conditions) if the per-group file isn't present on disk --
// see applications/modules/neutronics/diffusion/include/createNeutronicsFields.H.
internalField   uniform 1e13;

boundaryField
{
    ".*Wall"
    {
        type            albedoSP3;
        gamma           0.5;
        diffCoeffName   Dalbedo;
        fluxStarAlbedo  fluxStarAlbedo;
        forSecondMoment false;

        value           $internalField;
    }
    frontAndBack
    {
        type            empty;
    }
}


