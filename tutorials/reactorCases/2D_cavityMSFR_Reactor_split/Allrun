#!/bin/sh
cd ${0%/*} || exit 1    # Run from this directory

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

restore0Dir

runApplication blockMesh -region fluidRegion

# The neutronics region shares the exact same mesh as the fluid region --
# they are two independent mesh objects, mapped every timestep (not one
# shared mesh), but coincident geometry keeps the mapping cost trivial here.
cp -r constant/fluidRegion/polyMesh constant/neutroRegion/polyMesh

runApplication topoSet -region neutroRegion

runApplication GeN-Foam

# Sample the steady-state T/velocity profiles along AA'/BB' and compare
# against the digitized Tiberga et al. 2020 (Table 13) reference data --
# regression check: rerun this after any solver change to confirm nothing
# broke. Writes paperComparison.png; does not abort the case run on FAIL.
python3 compareWithPaper.py . 2>&1 | tee log.compareWithPaper

