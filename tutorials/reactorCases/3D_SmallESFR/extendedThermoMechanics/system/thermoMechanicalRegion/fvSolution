FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    porosity
    {
        solver          PBiCG;
        preconditioner  	DILU;
        tolerance       1e-10;
        relTol          0.01;
        smoother        GaussSeidel;
    }

    D
    {
        solver          PCG;
        preconditioner  FDIC;
        tolerance       1e-10;
        relTol          0.1;
    }
    "fuelDisp"
    {

        solver          PBiCG;
        preconditioner  DILU;
        tolerance       1e-5;
        relTol          0.01;
    }
    "CRDisp"
    {

        solver          PBiCG;
        preconditioner  DILU;
        tolerance       1e-5;
        relTol          0.01;
    }
    T
    {
        solver          PCG;
        preconditioner  FDIC;
        tolerance       1e-10;
        relTol          0.1;
    }

    neutronFlux0
    {
        solver          PCG;
        preconditioner  FDIC;
        tolerance       1e-10;
        relTol          0.1;
    }
}

stressAnalysis
{
    nCorrectors     20;
    maxOuterIter    100;

    referencePairs  ();

    D               (1e-5 1 1e-5);
    T               1e-5;

    relD            1e-5;
    relT            1e-5;
}

relaxationFactors
{
    fields
    {
        D   0.7;
        // T   0.8;
        // neutronFlux0   0.9;
    }
    /*
    equations
    {
        D   0.7;
        T   0.7;
    }
    */
}

