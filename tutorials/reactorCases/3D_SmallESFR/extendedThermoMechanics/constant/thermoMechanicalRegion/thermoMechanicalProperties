FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      solverDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The thermomechanics dictionary has the same structure as the solverDict of OFFBEAT
// Differences and/or new additions are explained and commented

//- Thermal and Mechanical solver selection: other OFFBEAT cards not needed

thermalSolver           solidConduction;
mechanicsSolver         smallStrain;

//- Same as OFFBEAT 

materialProperties      byZone;
rheology                byMaterial;
heatSource              fromLatestTime;
sliceMapper             autoAxialSlices;

globalOptions
{
    pinDirection            (0 0 1);
    reactorType             "LWR";
    linkedFuel false;
}

thermalSolverOptions
{
    heatFluxSummary     on;
    averageFieldsForMappings true;
    patchForAverage "fuelOuter";
}

mechanicsSolverOptions
{
    forceSummary        off;  
    cylindricalStress   on;  
}

// - In order to couple the thermomechanics solution to the other physics, some changes might need to be made
//
// - 1) Since GeN-Foam is mostly used for porous media, the thermal solution on the porous zones might not be
//      accurate. The user has then to options: if the thermomechanical and thermohydraulics meshes are perf-
//      ectly overlapping, then the T.passiveStructure field (TH) can be mapped onto T (TM) and decativate t-
//      he thermal solution; if instead there are regions that are non-porous, the thermal solution might be
//      still needed. The temperature is then obtained from solid conduction and the porous cells are correc-
//      ted with the TStructFromTH field. The user will then map T.passiveStructure onto TStructFromTH and s-
//      et the "correctTFromTH" option on 
//
// - 2) In order to take into account the deformation feedback on the neutronics, the displacement field mig-
//      ht need to be corrected. While the radial component is computed by the selected mechanics solver, as 
//      this is driven by the structural materials (e.g. diagrid of SFR), the axial component needs to take 
//      into account the fuel and control rods expansions. For this reason, a different field "meshDisp" is 
//      present and is updated by computing the fuel and CR expansion separately if the user sets the "corre-
//      ctDispForNeutro" keyword on.
//
// 	Both options are defaulted to false if not found or if the couplingOptions dict is not found entirely

couplingOptions
{
    correctTFromTH on;
    correctDispForNeutro on;
}

