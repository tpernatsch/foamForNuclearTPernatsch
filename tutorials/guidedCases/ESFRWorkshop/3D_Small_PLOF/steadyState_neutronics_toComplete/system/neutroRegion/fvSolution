FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//--------------------------------------//
//-----------LINEAR SOLVERS-------------//
//--------------------------------------//

// Linear solvers are selected here. These are the same as OpenFOAM, complete list is available at
// https://www.openfoam.com/documentation/user-guide/6-solving/6.3-solution-and-algorithm-control

// For the sake of the workshop, do not change

solvers
{
    "prec.*|precStar.*|adjoint_prec.*"
    {
        solver           PBiCG; // Stab;
        preconditioner   DILU;
        tolerance        1e-6;
        relTol           1e-3;

        /*
        solver           smoothSolver;
        smoother         GaussSeidel;
        tolerance        1e-5;
        relTol           0.01;
        */
    }
    "flux.*|adjoint_flux.*"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-6;
        relTol          1e-3;
        /*
        solver          GAMG;
        tolerance       1e-6;
        relTol          0.01;  //0.1;
        smoother        DICGaussSeidel;
	    nPostSweeps 	1;
	    nPreSweeps 	    1;
	    nFinestSweeps 	1;

        cacheAgglomeration  true;
        nCellsInCoarsestLevel   20;
        agglomerator    faceAreaPair;
        mergeLevels     1;
	    processorAgglomerator   masterCoarsest;
        */
    }

}


//--------------------------------------//
//-------TRANSPORT SOLUTION-------------//
//--------------------------------------//

//In neutronTransport, the solution procedure for the 
// neutron transport is specified. If the simulation is
// in eigenvalue mode, several acceleration methods are
// available to accelerate convergence

// The transport is solved in sequence for each group.
// maxNeutroIterations and neutronIterationResidual control
// the convergence of the multi-group solution

// For the sake of this exercise , please select 50 
//max iterations and a minimum residual of 1e-6

neutronTransport
{
    integralPredictor           false;  // integral neutron balance made at
                                        // each time step to predict fluxes at
                                        // next step (can be unstable)
    implicitPredictor           false;  // implicit soluion of all energy groups
				                        // with explicit diffusion term
    aitkenAcceleration          false;

    neutronIterationResidual     1e-6; // required accuracy for the coupling
					                    // of different energy groups
    maxNeutronIterations         50; // up to 3-400 if no acceleration techniques
}

