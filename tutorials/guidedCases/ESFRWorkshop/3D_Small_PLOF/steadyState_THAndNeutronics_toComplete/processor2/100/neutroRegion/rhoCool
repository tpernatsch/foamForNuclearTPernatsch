dimensions      [1 -3 0 0 0 0 0];

internalField   uniform 860;

boundaryField
{
    top
    {
        type            zeroGradient;
    }
    bottom
    {
        type            zeroGradient;
    }
    defaultFaces
    {
        type            zeroGradient;
    }
    procBoundary2to1
    {
        type            processor;
        value           uniform 860;
    }
    procBoundary2to3
    {
        type            processor;
        value           uniform 860;
    }
}


