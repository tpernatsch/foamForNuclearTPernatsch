FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       dictionary;
    location    "constant";
    object      multiRegionCouplingDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


// Select two solvers
regionSolvers
{
    Level_0
    {
        fluidRegion onePhase;
        neutroRegion    diffusionNeutronics;
    }
}

// Mappings structure will be

//Neutronics --> Fluid : 
    // powerDensity --> powerDensityStructure  
    // secondaryPowerDensity --> powerDensityLiquid

//Fluid --> Neutronics : 
    // T --> TCool
    // thermo:rho --> rhoCool
    // T.fuelAvForNeutronics --> TFuel
    // T.cladAvForNeutronics --> TClad
    // T.passiveStructure --> TStructMech

//ThermoMech --> Neutronics:
    // meshDisp --> disp

//Fluid --> ThermoMech
    // T.passiveStructure --> TStructFromTH
    // T.fuelAvForNeutronics --> TFuel

//Neutronics --> ThermoMech
    // powerDensity --> powerDensityStructure

// For field names use
// https://foam-for-nuclear.gitlab.io/GeN-Foam/user_guide/coupling/

mappings
{
    fluidRegion // target region
    {
        neutroRegion //source region 
        {
            targetFields (powerDensityStructure powerDensityLiquid); // this is the name of the field in the target region 
            sourceFields (powerDensity  secondaryPowerDensity); // this is the name of the field in the source region 
        }
    }
    neutroRegion // target region
    {
        fluidRegion // source region
        {
            targetFields (TCool rhoCool TFuel TClad TStruct);
            sourceFields (T thermo:rho T.fuelAvForNeutronics T.cladAvForNeutronics T.passiveStructure);
        }
    }
}


