FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 4.55911);

boundaryField
{
    wall 
    {
        type            slip;
    }

    baffle0 
    {
        type            slip;
    }

    baffle1 
    {
        type            slip;
    }

    top 
    {
        type            zeroGradient;
    }

    bottom 
    {
        type            fixedValue;
        value           uniform (0 0 4.55911);
    }

}


