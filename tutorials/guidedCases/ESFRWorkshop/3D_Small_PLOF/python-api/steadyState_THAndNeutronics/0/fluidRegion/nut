FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [2 -1 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    wall 
    {
        type            zeroGradient;
    }

    baffle0 
    {
        type            zeroGradient;
    }

    baffle1 
    {
        type            zeroGradient;
    }

    top 
    {
        type            calculated;
        value           uniform 0;
    }

    bottom 
    {
        type            calculated;
        value           uniform 0;
    }

}


