FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [2 -2 0 0 0 0 0];

internalField   uniform 0.005;

boundaryField
{
    wall 
    {
        type            zeroGradient;
    }

    baffle0 
    {
        type            zeroGradient;
    }

    baffle1 
    {
        type            zeroGradient;
    }

    top 
    {
        type            inletOutlet;
        phi             phi;
        inletValue      uniform 0.005;
        value           uniform 0.005;
    }

    bottom 
    {
        type            turbulentIntensityKineticEnergyInlet;
        intensity       0.05;
        value           uniform 0.005;
    }

}


