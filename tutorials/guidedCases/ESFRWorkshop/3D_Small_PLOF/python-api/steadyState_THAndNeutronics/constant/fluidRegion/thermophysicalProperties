FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       polynomial;
    thermo          hPolynomial;
    equationOfState icoPolynomial;
    specie          specie;
    energy          sensibleEnthalpy;
}

pRef            100000.0;

// rho: Discrepancy with experimental values below 1% in the
//      400 K - 1950 K range, deteriorates slowly
// mu:  Discrepancy with experimental values below 1% in the
//      400 K - 1400 K, deteriorates quickly after that
// kappa: Provided by evaluators for the 371 K - 2503.7 K
// 
mixture
{
    specie 
    {
        molWeight       22.989769;
    }

    equationOfState 
    {
        rhoCoeffs<8>     (860 0 0 0 0 0 0 0);
    }

    thermodynamics 
    {
        CpCoeffs<8>      (1646.97 -0.831587 0.000431182 0 0 0 0 0);
        Hf              0;
        Sf              0;
    }

    transport 
    {
        muCoeffs<8>      (0.0002 0 0 0 0 0 0 0);
        kappaCoeffs<8>   (60 0 0 0 0 0 0 0);
    }

}


