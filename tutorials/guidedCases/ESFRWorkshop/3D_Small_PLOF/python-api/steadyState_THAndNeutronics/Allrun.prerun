#!/bin/sh
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
runApplication -s fluidRegion checkMesh -region fluidRegion
runApplication -s neutroRegion checkMesh -region neutroRegion
runApplication decomposePar -allRegions -copyUniform
GeN-Foam -initializeMappedFields > log.GeN-Foam.initializeMappedFields
