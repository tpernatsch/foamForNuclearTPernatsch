FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      regionsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

regionSolvers
{
    Level_0
    {
        fluidRegion     onePhase;
        neutroRegion    diffusionNeutronics;
    }
}

meshDeformation
{
}

mappings
{
    fluidRegion
    {
        neutroRegion // -> fluidRegion
        {
            sourceFields    ( powerDensity secondaryPowerDensity );
            targetFields    ( powerDensityStructure powerDensityLiquid );
        }
    }
    neutroRegion
    {
        fluidRegion // -> neutroRegion
        {
            sourceFields    ( T thermo:rho T.fuelAvForNeutronics T.cladAvForNeutronics T.passiveStructure );
            targetFields    ( TCool rhoCool TFuel TClad TStructMech );
        }
    }
}

