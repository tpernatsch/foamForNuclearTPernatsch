FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p_rgh 
    {
        solver          GAMG;
        smoother        DIC;
        tolerance       1e-07;
        relTol          0;
    }

    p_rghFinal 
    {
        solver          GAMG;
        smoother        DIC;
        tolerance       1e-07;
        relTol          0;
    }

    e 
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-07;
        relTol          0;
        minIter         0;
    }

    h 
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-07;
        relTol          0;
        minIter         0;
    }

    ".*" 
    {
        solver          PBiCGStab;
        preconditioner  diagonal;
        tolerance       1e-07;
        relTol          0.001;
    }

}

PIMPLE
{
    nCorrectors     2;
    nNonOrthogonalCorrectors 0;
    nOuterCorrectors 6;
    solveEnergy     true;
    solveFluidMechanics true;
    momentumMode    faceCentered;
    pMin            10000;
    pRefCell        0;
    pRefValue       100000;
}

relaxationFactors
{
    equations 
    {
        h               0.7;
    }

    fields 
    {
        T               0.7;
    }

}


