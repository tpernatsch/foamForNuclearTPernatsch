FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     GeN-Foam;

startFrom       latestTime;

stopAt          endTime;

startTime       0.0;

endTime         100;

deltaT          1;

writeControl    runTime;

writeInterval   100;

purgeWrite      0.0;

writeFormat     ascii;

writePrecision  7;

writeCompression false;

timeFormat      general;

timePrecision   8;

runTimeModifiable true;

adjustTimeStep  false;

maxDeltaT       1;

maxCo           1;

maxPowerVariation 0.01;

removeBaffles
{
    fluidRegion     1;
    neutroRegion    0;
}

functions
{
}


