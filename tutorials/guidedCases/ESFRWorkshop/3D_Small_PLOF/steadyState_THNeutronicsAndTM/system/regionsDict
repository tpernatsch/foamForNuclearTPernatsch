FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       dictionary;
    location    "system";
    object      regionsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

regionSolvers
{
    Level_0
    {
	    fluidRegion     onePhase;
	    neutroRegion    diffusionNeutronics;
	    thermoMechanicalRegion legacyThermoMechanics;
