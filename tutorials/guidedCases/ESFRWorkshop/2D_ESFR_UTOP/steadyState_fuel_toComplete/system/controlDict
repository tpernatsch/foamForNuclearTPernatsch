FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

libs ("libsciantix.so");
libs ("liboffbeat.so");

application     GeN-Foam;

//- Run options:
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         51840000; // 600 days
deltaT          864; //0.01 days

//- Write options:
writeControl    runTime;
writeInterval   25920000; // 300 days
purgeWrite      0;
writeFormat     ascii;
writeCompression off;
timeFormat      general;
timePrecision   6;
writePrecision   6;




//- Adjustable time step options:
adjustableTimeStep true;
adjustTimeStep true;


maxDeltaT         1.0e7;
minDeltaT         0.001;
maxRelativeDeltaTIncrease 2.0;
minRelativeDeltaTDecrease 1e9;
maxRelativePowerIncrease  2.0;
maxRelativePowerDecrease  2.0;
maxBurnupIncrease 0.1;
maxAverageCreep   1e-4;
maxMaximumCreep   1e-4;
maxTotalFgrChange   0.1;    
maxLocalFgrChange   1.0;
runTimeModifiable true;
maxCourantNoPorosity  0.25;


