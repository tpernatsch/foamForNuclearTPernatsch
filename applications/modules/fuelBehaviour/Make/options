ifeq ($(WM_PROJECT), foam)
    VERSION_SPECIFIC_INC = -DFOAMEXTEND
else
    VERSION_SPECIFIC_INC = -DOPENFOAMESIORFOUNDATION
    ifneq (,$(findstring v,$(WM_PROJECT_VERSION)))
        VERSION_SPECIFIC_INC += -DOPENFOAMESI
    else
        VERSION_SPECIFIC_INC += -DOPENFOAMFOUNDATION
    endif
endif

EXE_INC = \
    -g \
    -std=c++17 \
    -Wno-old-style-cast -Wno-deprecated-declarations \
    $(VERSION_SPECIFIC_INC) \
    -I./../../../src/offbeatLib/lnInclude \
    -I./../../../src/multiRegion/lnInclude \
    -I./../../../src/fvPatchFields/lnInclude \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    -I$(LIB_SRC)/thermophysicalModels/specie/lnInclude \
    -I$(LIB_SRC)/thermophysicalModels/reactionThermo/lnInclude \
    -I$(LIB_SRC)/dynamicFvMesh/lnInclude \
    -I$(LIB_SRC)/dynamicMesh/lnInclude \
    -I$(LIB_SRC)/topoChangerFvMesh/lnInclude \
    -I$(LIB_SRC)/fvMotionSolver/lnInclude

EXE_LIBS = \
    -L$(FOAM_USER_LIBBIN)\
    -loffbeat \
    -lsciantix \
    -lOpenFOAM \
    -lfiniteVolume \
    -lmeshTools \
    -lspecie \
    -lreactionThermophysicalModels \
    -ldynamicFvMesh \
    -ldynamicMesh \
    -ltopoChangerFvMesh \
    -lfvMotionSolvers
