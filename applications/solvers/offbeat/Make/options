ifeq ($(WM_PROJECT), foam)
    VERSION_SPECIFIC_INC = -DFOAMEXTEND
else
    VERSION_SPECIFIC_INC = -DOPENFOAMESIORFOUNDATION
    ifneq (,$(findstring v,$(WM_PROJECT_VERSION)))
        VERSION_SPECIFIC_INC += -DOPENFOAMESI
        OF_FLAVOUR := ESI
    else
        VERSION_SPECIFIC_INC += -DOPENFOAMFOUNDATION
        OF_FLAVOUR := FOUNDATION
    endif
endif

EXE_INC = \
    -g \
    -std=c++17 \
    -Wno-old-style-cast -Wno-deprecated-declarations \
    $(VERSION_SPECIFIC_INC) \
    -I./../../../src/interpolationModels/lnInclude \
    -I./../../../src/solutionControl/lnInclude \
    -I./../../../src/profiles/lnInclude \
    -I./../../../src/crossSections/lnInclude \
    -I./../../../src/porousMediaModels/lnInclude \
    -I./../../../src/thermophysicalProperties/lnInclude \
    -I./../../../src/multiRegion/lnInclude \
    -I./../../../src/fvPatchFields/lnInclude \
    -I./../../modules/thermalHydraulics/lnInclude \
    -I./../../modules/neutronics/lnInclude \
    -I./../../modules/thermoMechanics/lnInclude \
    -I./../../modules/fuelBehaviour/lnInclude \
    -I./../../modules/openFoamImported/lnInclude \
    -I./../../../src/multiRegion/lnInclude \
    -I./../../modules/thermoMechanics/lnInclude \
    -I../../../src/offbeatLib/lnInclude \
    -I../../../thirdParty/SCIANTIX/lnInclude \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    -I$(LIB_SRC)/sampling/lnInclude \
    -I$(LIB_SRC)/dynamicFvMesh/lnInclude \
    -I$(LIB_SRC)/dynamicMesh/lnInclude \
    -I$(LIB_SRC)/surfMesh/lnInclude \
    -I$(LIB_SRC)/fvMotionSolver/lnInclude \
    -I$(LIB_SRC)/topoChangerFvMesh/lnInclude \
    -I$(LIB_SRC)/transportModels/lnInclude \
    -I$(LIB_SRC)/thermophysicalModels/basic/lnInclude \
    -I$(LIB_SRC)/MomentumTransportModels/momentumTransportModels/lnInclude \
    -I$(LIB_SRC)/MomentumTransportModels/compressible/lnInclude \
    -I$(LIB_SRC)/ThermophysicalTransportModels/lnInclude \
    -I$(LIB_SRC)/thermophysicalModels/solidThermo/lnInclude \

EXE_LIBS = \
    -L$(FOAM_USER_LIBBIN)\
    -L$(FOAM_USER_LIBBIN) -lInterpolationModels \
    -L$(FOAM_USER_LIBBIN) -lSolutionControl \
    -L$(FOAM_USER_LIBBIN) -lProfiles \
    -L$(FOAM_USER_LIBBIN) -lCrossSections \
    -L$(FOAM_USER_LIBBIN) -lPorousMediaModels \
    -L$(FOAM_USER_LIBBIN) -lThermophysicalProperties \
    -L$(FOAM_USER_LIBBIN) -lMultiRegion \
    -L$(FOAM_USER_LIBBIN) -lFvPatchFields \
    -L$(FOAM_USER_LIBBIN) -lFluidSolvers\
    -L$(FOAM_USER_LIBBIN) -lNeutronicsSolvers \
    -L$(FOAM_USER_LIBBIN) -lThermoMechanicsSolvers \
    -L$(FOAM_USER_LIBBIN) -lFuelSolvers \
    -L$(FOAM_USER_LIBBIN) -lOFSolvers \
    -L$(FOAM_USER_LIBBIN) -lFuelSolvers \
    -loffbeat \
    -lsciantix \
    -lOpenFOAM \
    -lfiniteVolume \
    -lmeshTools \
    -lspecie \
    -lreactionThermophysicalModels \
    -lsampling  \
    -lsurfMesh \
    -ldynamicMesh  \
    -ldynamicFvMesh \
    -lfvMotionSolvers  \
    -ltopoChangerFvMesh \
    -lfluidThermophysicalModels \
    -lspecie \
    -lsolidThermo

ifeq ($(OF_FLAVOUR),FOUNDATION)
    EXE_LIBS += \
        -lmomentumTransportModels \
        -lcompressibleMomentumTransportModels \
        -lthermophysicalTransportModels
endif

ifneq (,$(findstring v,$(WM_PROJECT_VERSION)))
    ifneq (,$(findstring FMU4FOAM,$(LIB_FMU4FOAM)))
        EXE_INC += -I$(LIB_FMU4FOAM)/ECI4FOAM/src/externalComm/lnInclude
        EXE_INC += -I$(LIB_FMU4FOAM)/src/OF_FMU/fmuControl/lnInclude
        EXE_LIBS += -lexternalComm
        EXE_LIBS += -L$(FOAM_USER_LIBBIN) -lFMUControl
    endif
endif