FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0/fluidRegion";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];


internalField   uniform (0 0 1.283295);

boundaryField
{
    top
    {
        type            zeroGradient;
    }
    bottom
    {
        type            inletOutlet;
        inletValue      uniform (0 0 1.283295);
        value           uniform (0 0 1.283295);
    }
    walls
    {
        type            slip;
    }
    baffle0
    {
        type            slip;
    }
    baffle1
    {
        type            slip;
    }
    procBoundary3to2
    {
        type            processor;
        value           uniform (0 0 1.283295);
    }
}


