FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/fluidRegion";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];


internalField   uniform 100000;

boundaryField
{
    top
    {
        type            fixedValue;
        value           uniform 100000;
    }
    bottom
    {
        type            zeroGradient;
    }
    walls
    {
        type            zeroGradient;
    }
    baffle0
    {
        type            calculated;
        value           uniform 0;
    }
    baffle1
    {
        type            calculated;
        value           uniform 0;
    }
    procBoundary3to2
    {
        type            processor;
        value           uniform 100000;
    }
}


