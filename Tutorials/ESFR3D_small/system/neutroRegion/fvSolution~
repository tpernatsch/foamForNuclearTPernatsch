FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "prec.*"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-6;
        relTol          1e-3;
    }
    "flux.*"
    { 
      
   /* 
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-6;
        relTol          1e-3;
  */  
        solver           GAMG;
        tolerance        1e-6;
        relTol           0.1;

        smoother         DICGaussSeidel;//;
	nPostSweeps 	1;
	nPreSweeps 	1;
	nFinestSweeps 	1;

        cacheAgglomeration  true;
        nCellsInCoarsestLevel 20;
        agglomerator     faceAreaPair;
        mergeLevels      1;
	processorAgglomerator masterCoarsest; 
          
        
    }
}


