FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// NB: to start from steady state one has to first paste de kedd value from the eigenvalue calculation to the nuclearData dictionary

// General

application         GeN-Foam;

startFrom           latestTime;

startTime           0;

stopAt              endTime;

endTime             1010;

deltaT              0.00001; // time step (if non adjusted)

adjustTimeStep      true; // adjust time step based on CFL condition, max power and max delta T

maxDeltaT           0.5; // max time step

writeControl        adjustableRunTime;

writeInterval       2;

purgeWrite          2;

writeFormat         ascii;

writePrecision      7;

writeCompression    true;

timeFormat          general;

timePrecision       8;

runTimeModifiable   true;

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Physics to solve

solveFluidMechanics     false;

solveEnergy             true;

solveNeutronics         true;

solveThermalMechanics   true;

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Global simulation options

compr       false; // true for compressible simulation

liquidFuel  false; // eg, MSRs

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Solution control

maxCo               0.99; // should be below 1 for CFL condition (necessary to guarantee stability if solving NS)

maxPowerVariation   0.025; //max power variation in each time step

// ************************************************************************* //
