FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 200;

boundaryField
{
    top
    {
        type            inletOutlet;
        inletValue      uniform 200;
        value           $internalField;
    }
    bottom
    {
        type            turbulentMixingLengthDissipationRateInlet;
        mixingLength    0.005;
        value           $internalField;
    }
    walls
    {
        type            zeroGradient;
        value           $internalField;

//        type            epsilonWallFunction;
//        value           $internalField;
    }
    baffle0
    {
        type            zeroGradient;
        value           $internalField;

//        type            epsilonWallFunction;
//        value           $internalField;
    }
    baffle1
    {
        type            zeroGradient;
        value           $internalField;

//        type            epsilonWallFunction;
//        value           $internalField;
    }



}


