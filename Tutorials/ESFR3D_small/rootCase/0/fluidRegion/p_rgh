FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/fluid";
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 1e5;

boundaryField
{
    top
    {
        type            fixedValue;
        value           uniform 1e5;
    }
    bottom
    {
        type            fixedFluxExtrapolatedPressure;
    }
    walls
    {
        type            zeroGradient;
    }
    baffle0
    {
        type            zeroGradient;
    }
    baffle1
    {
        type            zeroGradient;
    }
}


