#!/bin/sh
cd ${0%/*} || exit 1    # Run from this directory

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

exe="GeN-Foam"

cases="steadyState transient"

runCloneCase()
{
    printf "Cloning $2 to case $1..."
    foamCloneCase -latestTime $2 $1
    printf "$2 cloned!\n"
}

createMeshes()
{
    gmshToFoam $1/3dESFRMesh/meshTool_thermalHydraulics/esfrMain.msh -case $1 -region fluidRegion >> log.gmshToFoam.fluidRegion
    gmshToFoam $1/3dESFRMesh/meshTool_neutronics/esfrMain.msh -case $1 -region neutroRegion >> log.gmshToFoam.neutroRegion
    gmshToFoam $1/3dESFRMesh/meshTool_thermalMechanics/esfrMain.msh -case $1 -region thermoMechanicsRegion >> log.gmshToFoam.thermoMechanicsRegion

    # Add createBaffles and topoSet commands
}

setTransient()
{
    runCloneCase $1 $2

    printf "Setting transient case...\n"
    foamDictionary transient/constant/neutroRegion/neutronicsProperties -entry eigenvalueNeutronics -set false

    foamDictionary transient/system/fvSolution -entry PIMPLE.tightlyCoupled -set true

    foamDictionary transient/system/controlDict -entry startFrom -set latestTime
    foamDictionary transient/system/controlDict -entry endTime -set 1010
    foamDictionary transient/system/controlDict -entry deltaT -set 1e-05
    foamDictionary transient/system/controlDict -entry adjustTimeStep -set true
    foamDictionary transient/system/controlDict -entry writeControl -set adjustableRunTime
    foamDictionary transient/system/controlDict -entry writeInterval -set 2
    foamDictionary transient/system/controlDict -entry solveFluidMechanics -set false
    printf "Case set!\n\n"
}

for caseName in $cases
do
    printf "Preparing to run case $caseName...\n"

    case "$caseName" in
    "steadyState")
        runCloneCase $caseName rootCase
        printf "Steady state case is prepared!\n"
        ;;
    "transient")

        printf "Transient case entered...\n"
        setTransient $caseName steadyState
        ;;
    esac

    #( cd $caseName && runApplication `getApplication` )
    printf "Running $exe on $caseName\n"
    $exe -case $caseName 2>&1 | tee "$caseName/log.$exe"
done

