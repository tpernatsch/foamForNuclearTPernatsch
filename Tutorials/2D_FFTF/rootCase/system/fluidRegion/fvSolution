// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          fvSolution;
}

solvers
{
    p_rgh
    {
        solver          GAMG;
        smoother        DIC;
        tolerance       1e-07;
        relTol          0.001;
    }
    p_rghFinal
    {
        solver          GAMG;
        smoother        DIC;
        tolerance       1e-07;
        relTol          0;
    }
    "(h|k|epsilon)"
    {
        solver          PBiCG;
        preconditioner  DILU;
        tolerance       1e-07;
        relTol          0.001;
    }
    "(h|k|epsilon)Final"
    {
        solver          PBiCG;
        preconditioner  DILU;
        tolerance       1e-07;
        relTol          0;
    }
}

PIMPLE
{
    nCorrectors     6;
    nNonOrthogonalCorrectors 0;
    correctUntilConvergence true;
    momentumMode    cellCenteredFaceReconstruction;
    porousInterfaceSharpness 0.5;

    residualControl
    {
        p_rgh
        {
            tolerance       1e-06;
            relTol          0;
            useFirstPISOInitialResidual true;
        }
        h
        {
            tolerance       1e-06;
            relTol          0;
        }
        k
        {
            tolerance       0.0001;
            relTol          0;
        }
    }
}

relaxationFactors
{
    equations
    {
        h               0.8;
        hFinal          0.8;

        U               0.8;
        UFinal          0.8;
        p_rgh           0.8;
        p_rghFinal      0.8;

        "epsilon.*"     0.8;
        "k.*"           0.8;
    }
    fields
    {
    }
}


