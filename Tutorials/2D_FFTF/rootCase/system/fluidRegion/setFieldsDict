FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue powerDensity.nuclearFuelPin 0
);

regions
(
    zoneToCell
    {
        zone            "innerCore";
        fieldValues
        (
            volScalarFieldValue powerDensity.nuclearFuelPin 7.474871169e8
        );
    }

    zoneToCell
    {
        zone            "outerCore";
        fieldValues
        (
            volScalarFieldValue powerDensity.nuclearFuelPin 5.583084308e8
        );
    }
);


