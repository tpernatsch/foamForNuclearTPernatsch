FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    ".*"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-07;
        relTol          0.0001;
    }
    "fuelDisp"
    {

        solver          PBiCG;
        preconditioner  DILU;
        tolerance       1e-7;
        relTol          0.0001;
    }
    "CRDisp"
    {

        solver          PBiCG;
        preconditioner  DILU;
        tolerance       1e-7;
        relTol          0.0001;
    }
}

stressAnalysis
{
    compactNormalStress yes;
    nCorrectors     6;
    D               1e-06;
}

relaxationFactors
{
    fields
    {
	   disp 0.95;
    }
}


