FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      CRDisp;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{

     "zeroDispl"
    {
       type            zeroGradient;
    }
     "defaultFaces"
    {
       type            zeroGradient;
    }  
     "bottom"
    {
        type            zeroGradient;
    } 
      "top"
    {
        type            fixedValue;
        value           uniform 0;
    }  
     "topCR"
    {
        type            fixedValue;
        value           uniform 0;
    }  
     "bottomCR"
    {
        type            zeroGradient;
    }  
}

