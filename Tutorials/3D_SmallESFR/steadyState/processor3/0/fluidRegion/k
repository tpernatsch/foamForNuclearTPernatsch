FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/fluidRegion";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];


internalField   uniform 0.005;

boundaryField
{
    top
    {
        type            inletOutlet;
        inletValue      uniform 0.005;
        value           uniform 0.005;
    }
    bottom
    {
        type            turbulentIntensityKineticEnergyInlet;
        intensity       0.05;
        value           nonuniform List<scalar> 0();
    }
    walls
    {
        type            zeroGradient;
    }
    baffle0
    {
        type            zeroGradient;
    }
    baffle1
    {
        type            zeroGradient;
    }
    procBoundary3to2
    {
        type            processor;
        value           uniform 0.005;
    }
}


