FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0/fluidRegion";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 4.559114016);

boundaryField
{
    top
    {
        type            zeroGradient;
    }
    bottom
    {
        type            fixedValue;
        value           uniform (0 0 4.559114016);
    }
    walls
    {
        type            slip;
    }
    baffle0
    {
        type            slip;
    }
    baffle1
    {
        type            slip;
    }
}


