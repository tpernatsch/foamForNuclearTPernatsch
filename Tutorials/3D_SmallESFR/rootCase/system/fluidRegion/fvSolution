FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p_rgh
    {
        solver          GAMG;
        smoother        DIC;
        tolerance       1e-7;
        relTol          0;
    }

    p_rghFinal
    {
        $p_rgh;
        relTol          0;
    }

    "e.*"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-7;
        relTol          0;
        minIter         0;
    }

    "h.*"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-7;
        relTol          0;
        minIter         0;
    }

    ".*"
    {
        solver          PBiCGStab;
        preconditioner  diagonal;
        tolerance       1e-07;
        relTol          0.001;
    }
}

PIMPLE // a detailed explanation of this dictionary is available in this 
       // same fvSolution file of the 1D_boiling tutorial
{
    nCorrectors      2;//pressure-velocity correctors
    nNonOrthogonalCorrectors 0;
    // partialEliminationMode      implicit;
    momentumMode                faceCentered;
}

relaxationFactors
{
    equations
    {
        ".*"            1;
    }
}


