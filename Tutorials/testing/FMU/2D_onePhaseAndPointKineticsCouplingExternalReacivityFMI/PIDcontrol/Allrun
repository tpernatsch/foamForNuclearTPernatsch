#!/bin/sh
cd ${0%/*} || exit 1    # Run from this directory

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

#=============================================================================*
# Simulation parameters

steadyStateDuration=100
transientDuration=500

#=============================================================================*
# Build FMU

cd rootCase
omc FMUGen.mos
cd ..

#=============================================================================*
# Run Steady-state

if [ ! -d steadyState ]
then
    echo "No steady-state case in the current directory, run steady-state"
    cp -r rootCase steadyState
    cd steadyState

    foamDictionary system/controlDict -entry endTime -set $steadyStateDuration

    GeN-Foam | 
        tee log.GeN-Foam | 
        grep -E "Time = |deltaT ="

    cd ..
else
    echo "Steady-state calculation already perform, skip steady-state simulation"
fi

#=============================================================================*
# Run Transient

echo "Remove transient and duplicate steadyState case as transient"
rm -rf transient
cp -r steadyState transient
cp rootCase/ExternalReactivityController* transient/
cd transient

echo "Change case parameters for transient calculation"
foamDictionary constant/neutroRegion/neutronicsProperties -entry model -set pointKinetics
foamDictionary constant/neutroRegion/neutronicsProperties -entry eigenvalueNeutronics -set false
foamDictionary system/controlDict -entry endTime -set $(($steadyStateDuration+$transientDuration))
foamDictionary system/controlDict -entry deltaT -set 1e-3
foamDictionary system/controlDict -entry writeControl -set timeStep
foamDictionary system/controlDict -entry writeInterval -set 10

GeN-Foam | 
    tee log.GeN-Foam | 
    grep -E "Time = |deltaT ="

#=============================================================================*