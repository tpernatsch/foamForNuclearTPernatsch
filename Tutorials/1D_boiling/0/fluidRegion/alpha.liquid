FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alpha.liquid;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 1; 

boundaryField
{
    inlet
    {
        type            calulated;
        value           $internalField;
    }
    outlet
    {
        type            calulated;
        value           $internalField;
    }
    fixedWalls
    {
        type            empty;
    }
}

