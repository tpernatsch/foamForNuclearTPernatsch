{
    dragModels
    {
       "hx:core"
        {
            type     ReynoldsPower;
            coeff   0.5;
            exp     -0.25;
        }
    }

    heatTransferModels
    {
        "core"
        {
            type    NusseltReynoldsPrandtlPower; // const + coeff*Re^expRe*Pr^expPr
