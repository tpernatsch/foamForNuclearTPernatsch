// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}

application     GeN-Foam;

startFrom       startTime;

startTime       0;

stopAt          endTime;//writeNow;//

endTime         100;

deltaT          0.001;

writeControl    adjustableRunTime;

writeInterval   100;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

solveFluidMechanics true;

solveEnergy     true;

solveNeutronics false;

solveThermalMechanics false;

liquidFuel      true;

adjustTimeStep  true;

maxDeltaT       1;

maxCo           1;

maxPowerVariation 0.025;


