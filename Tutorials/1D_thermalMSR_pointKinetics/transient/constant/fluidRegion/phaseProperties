(       1       0.818730753077982       )
(       2       0.670320046035639       )
(       3       0.548811636094026       )
(       4       0.449328964117222       )
(       5       0.367879441171442       )
(       6       0.301194211912202       )
(       7       0.246596963941606       )
(       8       0.201896517994655       )
(       9       0.165298888221587       )
(       10      0.135335283236613       )
(       1000    0.135335283236613       )

            );
        }



    }
}

