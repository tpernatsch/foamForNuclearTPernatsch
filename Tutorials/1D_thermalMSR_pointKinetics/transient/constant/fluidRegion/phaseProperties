// ------------------------------------------------------------------------- //
// --- THERMAL-HYDRAULIC TYPE ---------------------------------------------- //
// ------------------------------------------------------------------------- //

thermalHydraulicsType    "onePhase";

fluidProperties
{
    initialPowerDensity
    {
        "core"              33e+07;
    }
}

// ------------------------------------------------------------------------- //
// --- STRUCTURES PROPERTIES ----------------------------------------------- //
// ------------------------------------------------------------------------- //

structureProperties
{    
    "core"
    {
        volumeFraction      0.7;
        Dh                  0.01;
        powerModel
        {
            type                lumpedNuclearStructure;
            volumetricArea      300;
            powerDensity        6.6e6;
            nodesNumber         1;
            nodeFuel            0;
            nodeClad            0;
            heatReistances      (450000 225000);
            rhoCp               5357692;
            volumeFractions     1;
            powerFractions      1;

        }

    }

    "hx"
    {
        volumeFraction      0.6;
        Dh                  1;//0.01;

        powerModel
        {
            type            fixedTemperature;
            volumetricArea  200;
            T               900;
        }
    }

    "pump"
    {
        volumeFraction      0;
        Dh                  1;
        momentumSource      (0 0 7858.6);

        momentumSourceTimeProfile
        {
            type                            table;

            //- Time after which the time table is applied
            startTime                   100;

            //- Left column is time elapsed since the startTime defined
