cd ${0%/*} || exit 1    # Run from this directory

#==============================================================================*

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# Clean the case
rm -rf steadyState


#==============================================================================*
# Steady-state
#==============================================================================*

cp -r rootCase steadyState
GeN-Foam -legacy -initializeMappedFields -case steadyState

# Run neutronics steady-state
GeN-Foam -case steadyState |
    tee "steadyState/log.GeN-Foam" |
    grep --color=auto -E "Time = |deltaT ="

