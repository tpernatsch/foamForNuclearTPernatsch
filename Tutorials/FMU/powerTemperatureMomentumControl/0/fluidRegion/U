FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 0 1 -1 0 0 0 0 ];

internalField   uniform (0 0 0.001);

boundaryField
{
    "(inlet1|inlet2|defaultFaces)"
    {
        type            fixedValue;
        value           $internalField;
    }
    "(outlet1|outlet2)"
    {
        type            zeroGradient;
    }
}

