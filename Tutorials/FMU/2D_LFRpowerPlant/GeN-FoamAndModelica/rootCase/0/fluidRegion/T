        type            zeroGradient;
    }
    bafflePool_master
    {
        type            NusseltThermalBaffle1D;
        value           uniform 710;
        samplePatch     bafflePool_slave;
        thickness       0.005;
        kappa           0;
        const           7.92351;
        coeff           0.031694;
        expRe           0.77;
        expPr           0.77;
    }
    bafflePool_slave
    {
        type            NusseltThermalBaffle1D;
        value           uniform 710;
        samplePatch     bafflePool_master;
        const           7.92351;
        coeff           0.031694;
        expRe           0.77;
        expPr           0.77;
    }
}


