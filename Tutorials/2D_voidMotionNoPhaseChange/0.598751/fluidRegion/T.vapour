FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0.598751/fluidRegion";
    object      T.vapour;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];


internalField   uniform 1155;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 1155;
    }
    outlet
    {
        type            zeroGradient;
    }
    fixedWalls
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            empty;
    }
}


