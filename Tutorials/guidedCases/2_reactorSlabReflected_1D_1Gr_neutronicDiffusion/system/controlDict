FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     GeN-Foam;

startFrom       latestTime;

stopAt          endTime;

endTime         1;

deltaT          1e-9;

writeControl    adjustableRunTime;

writeInterval   1;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression false;

timeFormat      general;

timePrecision   8;

runTimeModifiable true;

regionSolvers
{
    neutroRegion     diffusionNeutronics;
}

removeBaffles
{
    neutroRegion     false;
}

adjustTimeStep  true;

maxDeltaT       1;

maxCo           5;

maxPowerVariation 0.01;


