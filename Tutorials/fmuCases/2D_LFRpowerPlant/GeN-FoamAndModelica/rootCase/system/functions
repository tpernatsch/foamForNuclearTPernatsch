    avgCoolantTemperature
    {
        type            volFieldValue;
        libs            ( "libfieldFunctionObjects.so" );
        operation       volAverage;
        region          fluidRegion;
        writeControl    adjustableRunTime;
        writeFields     false;
        writeInterval   $writeIntervalFunctions;
        timeStart       $timeStartFunctions;
        log             true;
        fields
        (
            T
        );
