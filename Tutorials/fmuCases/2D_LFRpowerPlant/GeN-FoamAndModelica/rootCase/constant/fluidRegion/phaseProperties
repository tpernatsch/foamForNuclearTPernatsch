// ------------------------------------------------------------------------- //
// --- REGIME MAP MODEL ---------------------------------------------------- //
// ------------------------------------------------------------------------- //

regimeMapModel
{
    type                none;
}

// ------------------------------------------------------------------------- //
// --- REGIME PHYSICS FOR EACH REGIME -------------------------------------- //
// ------------------------------------------------------------------------- //

physicsModels
{
    dragModels
    {
        "innerFuel:outerFuel"
        {
            // Blasius correlation
            // fd = coeff * Re^exp
            type    ReynoldsPower;
            coeff   0.316;
            exp     -0.25;
        }

        "innerLowerFuelAssembly1:innerLowerFuelAssembly2:outerLowerFuelAssembly1:outerLowerFuelAssembly2:innerUpperFuelAssembly:outerUpperFuelAssembly:innerFuelDiagrid:outerFuelDiagrid"
        {
            // Blasius correlation
            // fd = coeff * Re^exp
            type    ReynoldsPower;
            coeff   0.316;
            exp     -0.25;
        }

        "primaryPump:SGenPrim1:SGenPrim2:SGenPrim3:SGenPrim4:SGenPrim5:SGenPrim6:SGenPrim7:SGenPrim8"
        {
            // Blasius correlation
            // fd = coeff * Re^exp
            type    ReynoldsPower;
            coeff   0.316;
            exp     -0.25;
        }
    }

    heatTransferModels
    {
        "innerLowerFuelAssembly1:innerLowerFuelAssembly2:outerLowerFuelAssembly1:outerLowerFuelAssembly2:innerFuel:outerFuel:innerUpperFuelAssembly:outerUpperFuelAssembly:innerFuelDiagrid:outerFuelDiagrid"
        {
            // Correlation taken from [2, 4]
            // Computation done with nusseltCorrelation.py
            // Nu = const + coeff * Re^expRe * Pr^expPr
            // Range of validity:
            //      x : [1.1; 1.95]  // pitch-to-diameter
            //      Pe: [30; 5000]
            // pitch-to-diameter ratio at 1.32
            type    NusseltReynoldsPrandtlPower;
            const   8.267142;
            coeff   0.033069;
            expRe   0.770000;
            expPr   0.770000;
        }

        "SGenPrim1:SGenPrim2:SGenPrim3:SGenPrim4:SGenPrim5:SGenPrim6:SGenPrim7:SGenPrim8"
        {
            // Correlation taken from [2, 4]
            // Computation done with nusseltCorrelation.py
            // Nu = const + coeff * Re^expRe * Pr^expPr
            // Range of validity:
            //      x : [1.1; 1.95]  // pitch-to-diameter
            //      Pe: [30; 5000]
            // pitch-to-diameter = 1.42
            type            NusseltAndWall;
            const   9.368208;
            coeff   0.037473;
            expRe   0.770000;
            expPr   0.770000;
            // -> H from Nu = 1.101372e+04 W/m2/K
            addH    2.7e3;
        }
    }
}

