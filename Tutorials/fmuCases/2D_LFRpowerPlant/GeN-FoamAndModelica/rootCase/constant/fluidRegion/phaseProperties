thermalHydraulicsType   "onePhase";

// ------------------------------------------------------------------------- //
// --- STRUCTURES PROPERTIES ----------------------------------------------- //
// ------------------------------------------------------------------------- //

volumeFractionFuelAssembly  0.5406; // volume fraction of the structure

DhFuelAssembly              0.009; // m

volumetricAreaFuelAssembly  205.9352; // m2/m3

volumeFractionSteamGen      0.450;

DhSteamGen                  0.039; // m

volumetricAreaSteamGen      56.69862; // m2/m3


structureProperties
{
    // Hypothesis 1: Suppose same volumeFraction and Dh as in the core active
    // part.
    "innerFuelDiagrid:outerFuelDiagrid"
    {
        volumeFraction      $volumeFractionFuelAssembly;
        Dh                  $DhFuelAssembly;

        passiveProperties
        {
            volumetricArea      ${{$volumetricAreaFuelAssembly/10.0}};
            rho                 7870; // kg/m³
            Cp                  560; // J/kg/K
            T                   673; // K
        }
    }

    "innerUpperAssembly:outerUpperAssembly"
    {
        volumeFraction      $volumeFractionFuelAssembly;
        Dh                  $DhFuelAssembly;

        passiveProperties
        {
            volumetricArea      ${{$volumetricAreaFuelAssembly/10.0}};
            rho                 7870; // kg/m³
            Cp                  560; // J/kg/K
            T                   740; // K
        }
    }

    "innerLowerFuelAssembly1:innerLowerFuelAssembly2:outerLowerFuelAssembly1:outerLowerFuelAssembly2:innerUpperFuelAssembly:outerUpperFuelAssembly"
    {
        volumeFraction      $volumeFractionFuelAssembly;
        Dh                  $DhFuelAssembly;

        passiveProperties
        {
            volumetricArea      ${{$volumetricAreaFuelAssembly/10.0}};
            rho                 7870; // kg/m³
            Cp                  560; // J/kg/K
            T                   673; // K
        }
    }

    "innerFuel:outerFuel"
    {
        volumeFraction      $volumeFractionFuelAssembly;
        Dh                  $DhFuelAssembly;

        powerModel
        {
            type                nuclearFuelPin;
            powerDensity        314832859.0768; // in the fuel pellets // W/m³, power.py
            fuelInnerRadius     0.00100; // m, [3]
            fuelOuterRadius     0.00450; // m, [3]
            cladInnerRadius     0.00465; // m, [3]
            cladOuterRadius     0.00525; // m, [3]
            fuelMeshSize        16;
            cladMeshSize        4;
            fuelRho             10500; // kg/m³
            cladRho             7800;  // kg/m³
            fuelCp              440.0; // J/kg/K, [5]
            cladCp              565;   // J/kg/K, [6] at 500 C
            fuelK               2;     // W/m/K, [5]
            cladK               20.2;  // W/m/K, [6] at 500 C
            fuelT               1800;  // K
            cladT               800;   // K

            // gapH                780; // W/m2/K
            // gapH table computed for an average burnup of 73.3 GWd/t, 
            // [Grasso2014] Table 2: Average burn-up and a maximum linear power
            // of 35 kW/m, [Grasso2014] Table 2: Maximum linear power
            gapHPowerDensity    table
            (
                (   0                       130     )
                (   306468250               780     )
                (   ${{2.0 * 306468250}}    1267.5  )
            );
        }
    }

    primaryPump
    {
        volumeFraction          0.919;
        Dh                      0.400; // thermalHydraulics.py
        momentumSource          (0 0 95000); // kg/m2/s, [1], thermalHydraulics.py

        // --- Transient for the Unprotected Loss Of Flow (ULOF)
        momentumSourceTimeProfile
        {
            type                table;

            //- Time after which the time table is applied
            startTime           1500000;

            //- Left column is time elapsed since the startTime defined above
            table       table
            (
                (   0       1   )
                (   0.0001  0   )
            );
        }

        passiveProperties
        {
            volumetricArea      10.00000; // m2/m3, thermalHydraulics.py
            rho                 7870; // kg/m³
            Cp                  560; // J/kg/K
            T                   673; // K
        }
    }

    "SGenPrim1"
    {
        volumeFraction          $volumeFractionSteamGen;
        Dh                      $DhSteamGen;

        powerModel
        {
            type                    fixedTemperatureFMU;
            temperatureNameFromFMU  "gfSteamGenTemperature1";
            volumetricArea          $volumetricAreaSteamGen;
            T                       631;
        }
    }
    "SGenPrim2"
    {
        volumeFraction          $volumeFractionSteamGen;
        Dh                      $DhSteamGen;

        powerModel
        {
            type                    fixedTemperatureFMU;
            temperatureNameFromFMU  "gfSteamGenTemperature2";
            volumetricArea          $volumetricAreaSteamGen;
            T                       634;
        }
    }
    "SGenPrim3"
    {
        volumeFraction          $volumeFractionSteamGen;
        Dh                      $DhSteamGen;

        powerModel
        {
            type                    fixedTemperatureFMU;
            temperatureNameFromFMU  "gfSteamGenTemperature3";
            volumetricArea          $volumetricAreaSteamGen;
            T                       634;
        }
    }
    "SGenPrim4"
    {
