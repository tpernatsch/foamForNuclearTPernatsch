        Dh                      $DhSteamGen;

        powerModel
        {
            type                    fixedTemperatureFMU;
            temperatureNameFromFMU  "gfSteamGenTemperature6";
            volumetricArea          $volumetricAreaSteamGen;
            T                       649;
        }
    }
    "SGenPrim7"
    {
        volumeFraction          $volumeFractionSteamGen;
        Dh                      $DhSteamGen;

        powerModel
        {
