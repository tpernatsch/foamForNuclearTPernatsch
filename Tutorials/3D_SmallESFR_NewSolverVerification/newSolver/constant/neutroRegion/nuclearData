FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      nuclearData;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// This files contains the nominal and perturbed nuclear data. Perturbed nuclear
// data can be provided adding a new state in the "states" dictionary. The file
// has been created using the serpentToFoam octave script available in the Tools
// folder of the GeN-Foam repository. The same script has been used to obtained
// the perturbed XS files.

// If true interpolates cross section with logarithmic temp for fuel
// (otherwise, square root)
fastNeutrons            true;

// Polyharmonic spline function
// - 1: phi(r) = |r|  -> linear interpolation
// - 2: phi(r) = r^2 ln(r)
// - 3: phi(r) = |r^3|
// - 4: phi(r) = r^4 ln(r)
polyharmonicSplineMode  1;

// Highly specialized flag. Please refer to Fiorina et al., Annals of Nuclear
// Energy 96O (2016)
adjustDiscFactors       false;

// Use homogeneous discontinuity factors provided below. Please refer to
// Fiorina et al., Annals of Nuclear Energy 96O (2016)
useGivenDiscFactors     false;

// Number of energy groups. Can be any, but consistent with the data below
energyGroups        1;

// Number of precursors groups. Can be any, but consistent with the data below
precGroups          8;

// Fuel axial orientation vector
axialOrientation    (0 0 1);

// Here below, the cross-sections (and few other parameters) are specified for
// each cellZone in the neutronics mesh. ALL cellZones must be specified in
// "reference" state but can be missed for the perturbed states!
// The use of #include allows to organise and lighten the nuclearData file but
// is optional.

states
(
    reference
    {
        Tfuel   900;
        Tclad   668;
        rhoCool 860;
        axExp   0;
        radExp  0;

        zones
        (
            #include "XSref"
        );
    }

    Tfuel1200K
    {
        Tfuel   1200;

        zones
        (
            #include "XSTfuel1200K"
        );
    }

    Tclad1950K
    {
        Tclad   1950;

        zones
        (
            #include "XSTclad1950K"
        );
    }

    rhoCool500kgm3
    {
        rhoCool 500;

        zones
        (
            #include "XSrhoCool500kgm3"
        );
    }

    axialExpansion
    {
        axExp   0.05;

        zones
        (
            #include "XSaxialExpansion"
        );
    }

    radialExpansion
    {
        radExp  0.05;

        zones
        (
            #include "XSradialExpansion"
        );
    }
);

