#!/bin/bash

# --- Run from this directory
cd ${0%/*} || exit 1

# --- Initialize the output file
resFile=test.out
rm -rf $resFile
touch $resFile

# --- Run the simulation
echo -e "Run tutorial 3D_SmallESFR ...\n" | tee -a $resFile
./Allrun_parallel >> log.simulation
echo -e "Done running tutorial 3D_SmallESFR ...\n" | tee -a $resFile

# --- Check it ran

isConverge()
{
    folder=$1
    name=$2
    string=$(tail -3 ./$folder/log.GeN-Foam | grep End)
    if [ "$string" = "End" ]; then
        echo -e "$name has converged \n" | tee -a $resFile
    else
        echo -e "$name has NOT converged \n" | tee -a $resFile
        exit 1
    fi
}

isConverge legacySolver "Steady state - Legacy"
isConverge newSolver   "Steady state - New"

# --- Recover the results
export LC_NUMERIC="en_US.UTF-8"
keffLeg=$(foamDictionary ./legacySolver/processor0/200/uniform/reactorState -entry keff -value)
keffNew=$(foamDictionary ./newSolver/processor0/200/uniform/reactorState -entry keff -value)


expectedKeff=0.936827



# --- Check that results are correct
isInRange()
{
    ref=$1
    value=$2
    error=$3
    valueMin=$(bc -l <<<"$value*(1-$error)")
    valueMax=$(bc -l <<<"$value*(1+$error)")
    if (( $(echo "$valueMin <= $ref && $ref <= $valueMax" | bc -l) )); then
        echo 0
    elif (( $(echo "$valueMax <= $ref && $ref <= $valueMin" | bc -l) )); then
        echo 0
    else
        echo 1
    fi
}

error=0.001
echo "keff test with $error relative error" | tee -a $resFile
if  [ $(isInRange $expectedKeff       $keffLeg       $error) -eq 0 ] &&
    [ $(isInRange $expectedKeff $keffNew $error) -eq 0 ]
then
    echo "Perfect match:" | tee -a $resFile
    echo "|                | Simulated | Expected |" | tee -a $resFile
    echo "|:---------------|:---------:|:--------:|" | tee -a $resFile
    echo "| keff - Legacy  | $keffLeg  | $expectedKeff |" | tee -a $resFile
    echo "| keff - New     | $keffNew  | $expectedKeff |" | tee -a $resFile
else
    echo "Divergent results:" | tee -a $resFile
    echo "|                | Simulated | Expected |" | tee -a $resFile
    echo "|:---------------|:---------:|:--------:|" | tee -a $resFile
    echo "| keff - Legacy  | $keffLeg  | $expectedKeff |" | tee -a $resFile
    echo "| keff - New     | $keffNew  | $expectedKeff |" | tee -a $resFile
    exit 1
fi

# --- Exit successfully
exit 0
