cd ${0%/*} || exit 1    # Run from this directory

clear

# Select tutorials in the test suite
tutorials="1D_HX 1D_PSBT_SC 1D_boiling 1D_CHF 1D_MSR_pointKinetics 1D_thermalMSR_pointKinetics 3D_SmallESFR 2D_cavityBoussinesq 2D_externalSourceDiffusion 2D_FFTF 2D_fullCoupling 2D_MSFR 2D_onePhaseAndPointKineticsCoupling 2D_onePhaseAndSubcriticalPointKineticsCoupling 2D_voidMotionNoPhaseChange 2D_KNS37-L22 Godiva_SN 3D_gFHR"
# tutorials="3D_SmallESFR " #2D_FFTF  3D_SmallESFR 1D_HX 1D_PSBT_SC 1D_boiling 2D_onePhaseAndPointKineticsCoupling 2D_KNS37

# Name of the result file in Markdown
resFile="./regressionResults"
rootPath=$(pwd)

# Clear or create new results file
echo -e "# GeN-Foam regression test suite\n" > $resFile
echo "Regression test of `date +"%d-%b-%Y - %H:%M:%S"`" >> $resFile

isConverge()
{
    folder=$1
    name=$2
    string=$(tail -3 ./$folder/log.GeN-Foam | grep End)
    if [ "$string" = "End" ]; then
        echo -e "$name has converged \n" | tee -a $rootPath/$resFile
    else
        echo -e "$name has NOT converged \n" | tee -a $rootPath/$resFile
    fi
}

# --- Recover the results
extract()
{
    value=$(
        awk '{ print $1+0 }' <<<$(
            grep -e "$1" ./$2/log.GeN-Foam |
            tail -1 |
            egrep -o "[-+]?[0-9]*\.?[0-9]+([eE][-+]?[0-9]+)?."
        )
    )
    echo $value
}

# Run all tutorials and check for clean finish
for tutorialName in $tutorials
do
    if [ -d $tutorialName ]
    then
        printf "Running tutorial $tutorialName...\n"
        printf "\n## $tutorialName ##\n" >> $resFile
    fi

    case "$tutorialName" in
    "3D_SmallESFR")
        cd $tutorialName
        ./Allrun_parallel
        printf "Done running tutorial $tutorialName...\n"

        # check it ran
        isConverge steadyState  "Steady state of $tutorialName"
        isConverge transient    "Transient of $tutorialName"

        # check that keff for esfr steady State is ~0.9370011
        keff=$(foamDictionary ./steadyState/processor0/200/uniform/reactorState -entry keff -value)
        printf "keff is $keff . It should be ~0.936827  \n" >> ../$resFile

        # check that power in esfr transient is ~8e08
        power=$(extract power transient)
        printf "power is $power . It should be ~8e+08  \n" >> ../$resFile
        cd ..
        ;;

    "1D_HX")
        # run one-phase
        cd $tutorialName/onePhase
        ./Allrun
        printf "Done running tutorial $tutorialName/onePhase...\n"

        # check it ran
        isConverge . "$tutorialName onePhase"
        cd ../..

        # run two-phase
        cd $tutorialName/twoPhase
        ./Allrun
        printf "Done running tutorial $tutorialName/twoPhase...\n"

        # check it ran
        isConverge . "$tutorialName twoPhase"
        cd ../..
        ;;

    "1D_CHF")
        # run one-phase
        cd $tutorialName/imposedPower
        ./Allrun
        printf "Done running tutorial $tutorialName/imposedPower...\n"

        # check it ran
        isConverge . "$tutorialName imposedPower"
        
        # check that results are correct
        input="./90/fluidRegion/T.fixedPower"
        TwallTop=$(head -40 "$input" | tail -1)
        printf "Temperature of the structure at the top of the channel at 90 seconds is: $TwallTop . It should be 2625.18 \n"  >> ../../$resFile

        cd ../..

        # run two-phase
        cd $tutorialName/imposedTemperature
        ./Allrun
        printf "Done running tutorial $tutorialName/imposedTemperature...\n"

        # check it ran
        isConverge . "$tutorialName imposedTemperature"
        
        # check that results are correct
        input="./40/fluidRegion/heatFlux.structure"
        QwallTop=$(head -40 "$input" | tail -1)
        printf "heat flux of the structure at the top of the channel at 40 seconds is: $QwallTop . It should be 33423.1 \n"  >> ../../$resFile
        cd ../..
        ;;

    "1D_boiling")
        cd $tutorialName
        ./Allrun
        printf "Done running tutorial $tutorialName...\n"

        # check it ran
        isConverge . $tutorialName
        
        cd ..
        ;;

    "1D_PSBT_SC")
        cd $tutorialName
        ./Allrun
        printf "Done running tutorial $tutorialName...\n"

        # check it ran
        isConverge . $tutorialName

        # check that results are correct
        input="./0.6/fluidRegion/alpha.vapour"
        averageAt=$(head -98 "$input" | tail -1)
        printf "time,  alpha.vapour at the end of the channel is: $averageAt . It should be 0.133727 \n" >> ../$resFile

        cd ..
        ;;

    "1D_MSR_pointKinetics")
        cd $tutorialName
        ./Allrun
        printf "Done running tutorial $tutorialName...\n"

        # check it ran
        isConverge steadyState  "Steady state of $tutorialName"
        isConverge transient    "Transient of $tutorialName"
        isConverge transientEnd "Transient end of $tutorialName"

        # check that power at the end of transient is ~6.14e+08
        power=$(extract totalPower transient)
        printf "power is $power . It should be ~6.13794e+08 \n" >> ../$resFile
        cd ..
        ;;

    "1D_thermalMSR_pointKinetics")
        cd $tutorialName
        ./Allrun
        printf "Done running tutorial $tutorialName...\n"

        # check it ran
        isConverge steadyState  "Steady state of $tutorialName"
        isConverge transient    "Transient of $tutorialName"
        isConverge transientEnd "Transient end of $tutorialName"

        # check that power at the end of transient is ~6.14e+08
        power=$(extract totalPower transient)
        printf "power is $power . It should be ~4.15258e+08 \n" >> ../$resFile
        cd ..
        ;;

    "2D_cavityBoussinesq")
        cd $tutorialName
        ./Allrun
        printf "Done running tutorial $tutorialName...\n"

        # check it ran
        isConverge . $tutorialName
        
        cd ..
        ;;

    "2D_FFTF")
        cd $tutorialName
        ./Allrun_parallel
        printf "Done running tutorial $tutorialName...\n"

        # check it ran
        isConverge steadyState  "Energy steady state of $tutorialName"
        isConverge transient    "Transient of $tutorialName"

        # check that reactivities are correct
        reactivityDoppler=$(extract "-> Doppler" transient)
        reactivityClad=$(extract "-> TClad" transient)
        reactivityDensity=$(extract "-> rhoCool" transient)
        reactivityStructures=$(extract "-> TStruct  " transient)
        reactivityDriveline=$(extract "-> driveline" transient)
        reactivityGEM=$(extract "-> GEM" transient)
        totalPower=$(extract "totalPower" transient)
        printf "reactivityDoppler is $reactivityDoppler . It should be 237.0728  \n" >> ../$resFile
        printf "reactivityClad is $reactivityClad . It should be 0.8198844    \n" >> ../$resFile
        printf "reactivityDensity is $reactivityDensity . It should be -2.525069    \n" >> ../$resFile
        printf "reactivityStructures is $reactivityStructures . It should be -1.017622    \n" >> ../$resFile
        # reactivityDriveline=$(grep -e "-> driveline" ./transient/log.GeN-Foam | tail -1 | egrep -o "[-+]?[0-9]*\.?[0-9]+([eE][-+]?[0-9]+)?.")
        printf "reactivityDriveline is $reactivityDriveline . It should be -8.631667  \n" >> ../$resFile
        printf "reactivityGEM is $reactivityGEM . It should be -464.8497  \n" >> ../$resFile
        printf "totalPower is $totalPower . It should be 29490.49  \n" >> ../$resFile
        cd ..
        ;;

    "2D_fullCoupling")
        cd $tutorialName
        ./Allrun
        printf "Done running tutorial $tutorialName...\n"

        # check it ran
        isConverge steadyState            "Steady State of $tutorialName"
        isConverge transientNoDriveline   "Transient (no driveline) of $tutorialName"
        cd ..
        ;;

    "2D_MSFR")
        cd $tutorialName
        ./Allrun
        printf "Done running tutorial $tutorialName...\n"  >> ../$resFile

        # check it ran
        isConverge steadyStateEN "Energy steady state of $tutorialName"
        isConverge steadyStateTH "Thermal-hydraulic steady state of $tutorialName"
        isConverge transient "Transient of $tutorialName"

        # check that keff for MSFR steady State is ~0.958765
        keff=$(foamDictionary ./steadyStateEN/165/uniform/reactorState -entry keff -value)
        printf "keff is $keff . It should be ~0.960283  \n" >> ../$resFile

        # check that power in MSFR transient is ~2e07
        power=$(extract power transient)
        printf "power is $power . It should be ~2e+07  \n" >> ../$resFile
        cd ..
        ;;

    "2D_onePhaseAndPointKineticsCoupling")
        cd $tutorialName
        ./Allrun
        printf "Done running tutorial $tutorialName...\n"

        # check it ran
        isConverge steadyState            "Steady State of $tutorialName"
        isConverge transientNoDriveline   "Transient (no driveline) of $tutorialName"
        isConverge transientWithDriveline "Transient (with driveline) of $tutorialName"
        isConverge transientWithBoron     "Transient (with boron) of $tutorialName"
        cd ..
        ;;

    "2D_onePhaseAndSubcriticalPointKineticsCoupling")
        cd $tutorialName
        ./Alltest 
        cd ..
        # Extract results
        cat $tutorialName/test.out >> $resFile
        echo -e "\n--------------------------------------------------------------------------------\n" >> $resFile
        ;;

    "2D_externalSourceDiffusion")
        cd $tutorialName
        ./Alltest 
        cd ..
        # Extract results
        cat $tutorialName/test.out >> $resFile
        echo -e "\n--------------------------------------------------------------------------------\n" >> $resFile
        ;;

    "2D_voidMotionNoPhaseChange")
        cd $tutorialName
        ./Allrun
        printf "Done running tutorial $tutorialName...\n"

        # check it ran
        isConverge . $tutorialName
        cd ..
        ;;

    "2D_KNS37-L22")
        cd $tutorialName
        ./Allrun
        printf "Done running tutorial $tutorialName...\n"

        # check it ran
        isConverge . $tutorialName

        # check that results are correct
        input="./postProcessing/fluidRegion/averageValues/-2/volFieldValue.dat"
        averageAt=$(head -9424 "$input" | tail -1)
        printf "time, average alpha.vapour and average T.structure when alpha is approximately max are: $averageAt . They should be 12.56424533593758    1.577348e-01    8.210752e+02 \n" >> ../$resFile

        cd ..
        ;;

    "Godiva_SN")
        cd $tutorialName
        ./Allrun_parallel
        printf "Done running tutorial $tutorialName...\n"

        # check it ran
        isConverge . $tutorialName

        # check that keff is ~0.980106
        keff=$(foamDictionary ./20/uniform/reactorState -entry keff -value)
        printf "keff is $keff . It should be 0.980106  \n" >> ../$resFile

        cd ..
        ;;
        
    "3D_gFHR")
        cd $tutorialName
        ./Allrun
        printf "Done running tutorial $tutorialName...\n"

        # check it ran
        isConverge steadyStateNSSP "Steady state of $tutorialName with nuclearSteadyStatePebble"
        isConverge steadyStateLPS  "Steady state of $tutorialName with lumpedParameterStructure"
        
        # check that max temperatures in the triso is correct
        Tfmax=$(extract "T.nuclearSteadyStatePebble.Tfmax" steadyStateNSSP)
        
        TfmaxAvg=$(echo "$Tfmax" | cut -d " " -f1)
        TfmaxMin=$(echo "$Tfmax" | cut -d " " -f2)
        TfmaxMax=$(echo "$Tfmax" | cut -d " " -f3)

        echo "|           | Simulated | Expected |" >> ../$resFile
        echo "|:----------|:---------:|:--------:|" >> ../$resFile
        echo "| Tfmax avg | $TfmaxAvg |  981.808 |" >> ../$resFile
        echo "| Tfmax min | $TfmaxMin |  900.664 |" >> ../$resFile
        echo "| Tfmax max | $TfmaxMax | 1062.87  |" >> ../$resFile

        cd ..
        ;;
        
    esac

done

# clean all

