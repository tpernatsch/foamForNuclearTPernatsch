FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//- COMPRESSIBLE

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    //transport       polynomial;
    //thermo          hPolynomial;
    //equationOfState icoPolynomial;
    transport       const;
    thermo          hConst;
    equationOfState perfectGas;
    specie          specie;
    energy          sensibleEnthalpy;
}

pRef                        1.6572E+07;

mixture
{
