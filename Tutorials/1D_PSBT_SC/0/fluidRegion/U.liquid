FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      Ul;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (9.2256 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (9.2256 0 0);
    }
    outlet
    {
        type            pressureInletOutletVelocity;
        value           $internalField;
        phi             phi.liquid;
    }
    fixedWalls
    {
        type            slip;
    }
}

