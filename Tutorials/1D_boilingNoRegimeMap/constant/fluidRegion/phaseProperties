FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      phaseProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// ------------------------------------------------------------------------- //
// --- THERMAL-HYDRAULIC TYPE ---------------------------------------------- //
// ------------------------------------------------------------------------- //

thermalHydraulicType    "twoPhase";

// ------------------------------------------------------------------------- //
// --- FLUID PROPERTIES ---------------------------------------------------- //
// ------------------------------------------------------------------------- //

fluid1 "liquid";
fluid2 "vapour";

liquidProperties
{
    residualAlpha   1e-69;
}

vapourProperties
{
    residualAlpha   1e-69;
    thermoResidualAlpha 0.02;
}

// ------------------------------------------------------------------------- //
// --- STRUCTURES PROPERTIES ----------------------------------------------- //
// ------------------------------------------------------------------------- //

structureProperties
{    
    type            "byZone";
    
    "low:top"
    {
        volumeFraction      0;//0.4720574811;
        Dh                  0.01;
    }
    
    "mid"
    {
        volumeFraction      0;//0.4720574811;
        Dh                  0.005;

        powerModel
        {
            volumeFraction      0.5;
            type                constantPower;
            iA                  100;
            T                   652.15;
            Cp                  500;
            rho                 7700;
            powerDensity        1e9;
        }
    }
}

// ------------------------------------------------------------------------- //
// --- REGIME MAP MODEL ---------------------------------------------------- //
// ------------------------------------------------------------------------- //

regimeMapModel
{
    type                none;
}

// ------------------------------------------------------------------------- //
// --- REGIME PHYSICS FOR EACH REGIME -------------------------------------- //
// ------------------------------------------------------------------------- //

physicsModelsByRegime
{
    dragModels
    {
        "liquid.vapour" 
        {
            type "Autruffe";
            vapourName "vapour";
        }

        "liquid.structure"
        {
            "low:mid:top"
            {
                type Darcy;
                coeff 2;
                exp   -0.125;
            }
        }
    }

    heatTransferModels
    {
        "liquid.vapour"
        {
            type constant;
            value 10000;
        }

        "vapour.liquid"
        {
            type constant;
            value 100;
        }

        "liquid.structure"
        {
            "mid"
            {
                type    Nusselt;
                const   7;
                coeff   1e-2;
                expRe   0.75;
                expPr   0.75;
            }
        }
    }

    fluidGeometry
    {
        dispersed   "vapour";

        dispersedFluidDiameterModel
        {
            type    constant;
            value   0.01;
        }

        fluidInterfacialAreaModel
        {
            type        "Schor";
            alphaName   "vapour";
            P           0.011;
            D           0.01;
        }

        structureInterfacialAreaPartitionModel
        {
            type        "constant";
            value1      1.0;
            value2      0;
        }
    }
}

// ------------------------------------------------------------------------- //
// --- PHASE-CHANGE RELATED ------------------------------------------------ //
// ------------------------------------------------------------------------- //

phaseChangeModel
{
    type            "heatDriven";
    mode            conductionLimited; 
    
    saturationModel
    {
        type        "BrowningPotter";
    }
}



// ------------------------------------------------------------------------- //
// --- MISCELLANEA --------------------------------------------------------- //
// ------------------------------------------------------------------------- //

pMin                    10000;
pRefCell                0;
pRefValue               100000;
residualKd              10;

// ************************************************************************* //