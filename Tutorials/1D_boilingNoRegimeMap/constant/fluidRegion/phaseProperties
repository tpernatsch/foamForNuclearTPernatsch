// ------------------------------------------------------------------------- //
// --- THERMAL-HYDRAULIC TYPE ---------------------------------------------- //
// ------------------------------------------------------------------------- //

thermalHydraulicType    "twoPhase";

// ------------------------------------------------------------------------- //
// --- FLUID PROPERTIES ---------------------------------------------------- //
// ------------------------------------------------------------------------- //

//- These could be anything you want, as long as fields in 0/fluidRegion/ have
//  these in their name and everyuthing else is re-named accordingly in this
//  dictionary
fluid1 "liquid";
fluid2 "vapour";

liquidProperties
{
    residualAlpha   1e-69;
}

vapourProperties
{
    residualAlpha   1e-69;
    thermoResidualAlpha 0.02;
}

/*

Example of fluidPropertiesDict

