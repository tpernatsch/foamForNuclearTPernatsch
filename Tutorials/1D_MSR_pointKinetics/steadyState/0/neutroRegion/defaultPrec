FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/neutroRegion";
    object      defaultPrec;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 0 -3 0 0 0 0 0 ];

internalField   uniform 1;

boundaryField
{
    bottom
    {
        type            cyclic;
    }
   
    top
    {
        type            cyclic;
    }

    walls
    {
        type            zeroGradient;
    }
    front
    {
        type             zeroGradient;
    }

    back
    {
        type            zeroGradient;
    }


  
}

