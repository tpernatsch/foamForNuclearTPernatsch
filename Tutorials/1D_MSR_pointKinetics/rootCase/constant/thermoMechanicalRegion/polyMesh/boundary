FoamFile
{
    version     2.0;
    format      ascii;
    class       polyBoundaryMesh;
    location    "constant/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

4
(
    top
    {
        type            cyclic;
        inGroups        List<word> 1(cyclic);
        nFaces          1;
        startFace       639;
        matchTolerance  0.0001;
        neighbourPatch  bottom;
        transformType   translational;
        separation      (0 0 12);
    }
    bottom
    {
        type            cyclic;
        inGroups        List<word> 1(cyclic);
        nFaces          1;
        startFace       640;
        matchTolerance  0.0001;
        neighbourPatch  top;
        transformType   translational;
        separation      (0 0 -12);
    }
    walls
    {
        type            wall;
        inGroups        List<word> 1(wall);
        nFaces          1280;
        startFace       641;
    }
    defaultFaces
    {
        type            empty;
        inGroups        List<word> 1(empty);
        nFaces          1280;
        startFace       1921;
    }
)

