// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version         2;
    format          ascii;
    arch            "LSB;label=32;scalar=64";
    class           dictionary;
    location        "system";
    object          controlDict;
}

application     GeN-Foam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         1000;

deltaT          0.001;

writeControl    adjustableRunTime;

writeInterval   1000;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

regionSolvers
{
    fluidRegion     onePhase;
}

removeBaffles
{
    fluidRegion     false;
}

liquidFuel      true;

adjustTimeStep  true;

maxDeltaT       1;

maxCo           1;

maxPowerVariation 0.025;


// ************************************************************************* //
