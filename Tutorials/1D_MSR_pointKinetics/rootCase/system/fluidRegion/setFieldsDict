FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue powerDensity 0
);

regions
(
    boxToCell
    {
        box (0 0 2) (1 1 5);

        fieldValues
        (
            volScalarFieldValue powerDensity 33e+07
        );
    }
);


