FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant/fluidRegion";
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       polynomial;
    thermo          hPolynomial;
    equationOfState icoPolynomial; //perfectGas;
    specie          specie;
    energy          sensibleEnthalpy;
}

pRef            100000;

// NB: values taken at 693.15 K which is the average temperature in the core
mixture // don't touch the name
{
    specie
    {
        molWeight               208.20; // g/mol
    }
    equationOfState
    {
        rhoCoeffs<8>            (10168.76 0 0 0 0 0 0 0); // kg/m³
        // rhoCoeffs<8>            (11065 -1.293 0 0 0 0 0 0); // kg/m³
    }
    thermodynamics
    {
        // Heat capacity at constant pressure
        CpCoeffs<8>             (142.5465 0 0 0 0 0 0 0); // J/kg/K
        // CpCoeffs<8>             (1.351533e+02 1.357940e-01 -4.630153e-04 7.197995e-07 -6.262880e-10 2.934805e-13 -5.748022e-17 0); // J/kg/K
        // Enthalpy
        Hf                      0; // J/kg
        // Entropy
        Sf                      0; // J/kg/K
    }
    transport
    {
        // Dynamic viscosity
        muCoeffs<8>             (1.466256e-03 0 0 0 0 0 0 0); // kg/m/s (Pa.s)
        // muCoeffs<8>             (3.488090e-02 -2.111789e-04 5.787052e-07 -8.653992e-10 7.329427e-13 -3.308185e-16 6.191944e-20 0); // kg/m/s (Pa.s)
        // Thermal conductivity
        kappaCoeffs<8>          (13.38478 0 0 0 0 0 0 0); // W/m/K
        // kappaCoeffs<8>          (3.284 1.617e-2 -2.305e-6 0 0 0 0 0); // W/m/K
    }
}


