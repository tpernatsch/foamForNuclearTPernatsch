FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U.liquid;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0.1);

boundaryField
{
    inletP
    {
        type            fixedValue;
        value           uniform (0 0 2);
    }
    inletS
    {
        type            fixedValue;
        value           uniform (0 0 2);
    }
    outletP
    {
        type            zeroGradient;
    }
    outletS
    {
        type            zeroGradient;
    }
    walls
    {
        type            slip;
    }
}

