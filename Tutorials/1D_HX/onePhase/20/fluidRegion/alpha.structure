FoamFile
{
    version     2.0;
    format      ascii;
    class       byZone;
    location    "20/fluidRegion";
    object      alpha.structure;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];


internalField   uniform 0.5;

boundaryField
{
    outletP
    {
        type            zeroGradient;
    }
    outletS
    {
        type            zeroGradient;
    }
    walls
    {
        type            zeroGradient;
    }
    inletP
    {
        type            zeroGradient;
    }
    inletS
    {
        type            zeroGradient;
    }
}


// ************************************************************************* //
