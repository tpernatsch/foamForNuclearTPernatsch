FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     GeN-Foam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         100;

deltaT          1;

writeControl    adjustableRunTime;

writeInterval   100;

purgeWrite      0;

writeFormat     ascii;

writePrecision  7;

writeCompression false;

timeFormat      general;

timePrecision   8;

runTimeModifiable false;

adjustTimeStep  true;

maxDeltaT       1;

maxCo           5;

maxPowerVariation 0.01;

regionSolvers
{
    fluidRegion     onePhase;
    neutroRegion    diffusionNeutronics;
    thermoMechanicalRegion legacyThermoMechanics;
}

removeBaffles
{
    fluidRegion     true;
    neutroRegion    false;
    thermoMechanicalRegion false;
}


