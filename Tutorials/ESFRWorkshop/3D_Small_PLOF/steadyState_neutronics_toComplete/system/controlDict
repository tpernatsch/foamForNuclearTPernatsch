FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Run a simulation from 0 to 200s with deltaT non-adaptive = 1s
// Write results once every 100s

application     GeN-Foam;

startFrom      startTime;

startTime       0;

stopAt          endTime;

endTime         1;

deltaT          0.01;

writeControl    runTime;

writeInterval   1;

purgeWrite      0;

writeFormat     ascii;

writePrecision  7;

writeCompression false;

timeFormat      general;

timePrecision   8;

runTimeModifiable false;

liquidFuel      false;

adjustTimeStep  false;

maxDeltaT       1;

maxCo           40;

maxPowerVariation 0.025;


// ------------------------------------------------------------------------- //
// ----------------- MAPPINGS SPECS ---------------------------------------- //
// ------------------------------------------------------------------------- //

// If in one mesh baffles (i.e., internal patches) are present, this can cause projection
// errors in the mesh-to-mesh algorithm. removeBaffles allows the user to specify which
// meshes have baffles and if these need to be removed for the weights calculation

removeBaffles
{
    neutroRegion    false;
}




