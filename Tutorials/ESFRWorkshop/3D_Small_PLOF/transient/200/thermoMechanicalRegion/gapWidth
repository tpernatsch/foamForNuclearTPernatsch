FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "100/thermoMechanicalRegion";
    object      gapWidth;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 1e+15;

boundaryField
{
    top
    {
        type            calculated;
        value           uniform 1e+15;
    }
    topCR
    {
        type            calculated;
        value           uniform 1e+15;
    }
    bottom
    {
        type            calculated;
        value           uniform 1e+15;
    }
    bottomCR
    {
        type            calculated;
        value           uniform 1e+15;
    }
    zeroDispl
    {
        type            calculated;
        value           uniform 1e+15;
    }
    defaultFaces
    {
        type            calculated;
        value           uniform 1e+15;
    }
}


