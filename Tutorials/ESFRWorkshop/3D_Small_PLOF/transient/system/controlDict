FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Run from 200 to 400, with adaptive time step, writing every 10 seconds

application     GeN-Foam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         400;

deltaT          1;

writeControl    runTime;

writeInterval   5;

purgeWrite      0;

writeFormat     ascii;

writePrecision  7;

writeCompression false;

timeFormat      general;

timePrecision   8;

runTimeModifiable true;

liquidFuel      false;

adjustTimeStep  true;

maxDeltaT       1;

maxCo           10;

maxPowerVariation 0.025;

removeBaffles
{
    fluidRegion     true;
    neutroRegion    false;
    thermoMechanicalRegion false;
}


