FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

libs ("libsciantix.so");
libs ("liboffbeat.so");

//- Run options:
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         25;
deltaT          0.1;

//- Write options:
writeControl    runTime;
writeInterval   1;
purgeWrite      0;
writeFormat     ascii;
writeCompression off;
timeFormat      general;
timePrecision   6;
writePrecision  12;
removeBaffles
{ 
	fluidRegion true;
	channelRegion false;
	fuelBehaviourRegion false;
    neutroRegion false;
};

// Common entries
adjustTimeStep true;
runTimeModifiable true;
adjustableTimeStep  true;
//maxDeltaT       1;
maxCo           20;
maxPowerVariation 1e9;
maxDeltaT         1.0e5;
minDeltaT         0.001;
//maxRelativeDeltaTIncrease 2.0;
minRelativeDeltaTDecrease 1e9;
maxRelativePowerIncrease  2.0;
maxRelativePowerDecrease  2.0;
maxBurnupIncrease 0.1;
maxAverageCreep   1e-4;
maxMaximumCreep   1e-4;
maxTotalFgrChange   0.1;    
maxLocalFgrChange   1.0;
runTimeModifiable true;
maxCourantNoPorosity  0.25;


