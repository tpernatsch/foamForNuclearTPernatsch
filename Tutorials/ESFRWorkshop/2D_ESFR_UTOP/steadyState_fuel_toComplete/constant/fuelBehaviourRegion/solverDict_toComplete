FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      solverDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//------------------------------------------//
//---------SOLVERS SELECTION----------------//
//------------------------------------------//

// For the thermalSolver we'll use "solidConduction"
// For the  mechanicSolver we'll use "smallStrain"


thermalSolver           ...;
mechanicsSolver         ...;
neutronicsSolver        fromLatestTime; // fromLatestTime if solution does not need to be updated
elementTransport        byList; // will look for elementTransportOptions to see which transport solvers to activate

//- Material and rhelogy treatment:
materialProperties      byZone;
rheology                byMaterial;

heatSource              timeDependentLhgr;
burnup                  fromPower;
fastFlux                timeDependentAxialProfile;
corrosion               fromLatestTime;
gapGas                  FRAPCON;
fgr                     SCIANTIX;
sliceMapper             byMaterial;

elementTransportOptions
{
    solvers        ( porosityTransport );

    porosityOptions
    {
        advectiveTerm   true;          
        diffusiveTerm   false;      
        boundedAdvectionTerm true;
    }
}


//------------------------------------------//
//-----------SOLVERS OPTIONS----------------//
//------------------------------------------//

// Options which apply to several solvers
// These are generic simulation parameters

globalOptions
{
    pinDirection            (0 0 1);
    reactorType             "SFR";
}

// Thermal solver options

thermalSolverOptions
{
    heatFluxSummary     off;
}

// Mechanics solver options
rheologyOptions
{
    thermalExpansion on;
    modifiedPlaneStrain on;
    springModulus   3500;
    coolantPressureList
    {
        file            "$FOAM_CASE/constant/systemPressure";
        outOfBounds     clamp;
    }
    planeStress     off;
}

mechanicsSolverOptions
{
    forceSummary        off;  
    cylindricalStress   on;  

    multiMaterialCorrection
    {
        type                    uniform2D;
        defaultWeights          1;
    }
}

// Fission gas release options

fgrOptions
{
    nFrequency  1;
    relax       0.1;
    addToRegistry true;
}

// Gap model options

gapGasOptions
{
    gapPatches ( fuelOuter cladInner );
    holePatches ( fuelInner );
    topFuelPatches    ( fuelTop);
    bottomFuelPatches ( fuelBottom);

    gapVolumeOffset 0.0;
    gasReserveVolume 0.0;
    gasReserveTemperature 290;
}

// Power source options

heatSourceOptions // Data from ESFR-SIMPLE benchmark WP 3
{
    timePoints  (  0.0 0.083333 300.08333  600.08333  900.08333 );
    lhgr        ( 0.0 27182.74  27609.12    27782.22 27782.22);
    timeInterpolationMethod linear;

    axialProfile
    {
        type timeDependentTabulated;
        #include "axialProfile";
        axialInterpolationMethod step;
        burnupInterpolationMethod linear;
    }

    radialProfile
    {
        type    flat;
    }

    materials ( fissile fertile );
}

// Flux options

fastFluxOptions
{
    timePoints  ( 0.0 0.083333 300.08333  600.08333  900.08333);
    fastFlux    ( 0.0 1.5945e15  1.6088e15    1.6350e15 1.6350e15);
    timeInterpolationMethod linear;

    axialProfile
    {
        type timeDependentTabulated;
        #include "axialFluxProfile";
        axialInterpolationMethod linear;
        burnupInterpolationMethod linear;
    }

    materials ( fissile fertile cladding );
}



//------------------------------------------//
//-----------MATERIALS PROPERTIES-----------//
//------------------------------------------//

// For each zone of the mesh, it is assumed that a different material is used
// and material properties need to be specified.

// For this exercise, the UPuO2 model available in the fuel behaviour solver
// to model MOX fuel need to be completed to reflect the ESFR-SMART fuel composition

// Inner fuel composition is 17.990 Pu% and 82.010 U% --> material name is "UPuO2"
// Uranium enrichment is 0.257%
// Pu composition is: 
// 238: 3.625%
// 239: 47.904%
// 240: 29.859%
// 241: 8.252%
// 242: 10.360%

materials
{
    writeMaterialProperties true;
    fissile
    {
        material                    ...;
        Tref                        Tref [ 0 0 0 1 0 ] 293;

        densificationModel          UO2FRAPCON;
        swellingModel               UO2FRAPCON;
        relocationModel             UO2FRAPCON;
        conductivityModel           UPuO2Philipponeau;

        enrichment                  ...;
        rGrain                      6.0e-06;
        GdContent                   0.0;
        theoreticalDensity          11039;
        densityFraction             0.955;
        dishFraction                0.0;

        resinteringDensityChange    0.3;
        GapCold                     0.155e-3;
        DiamCold                    9.36e-3;
        recoveryFraction            0.5;
        outerPatch                  "fuelOuter";

        isotropicCracking           on;
        nCracksMax                  12;

        rheologyModel               elasticity;
        
        poreVelocityModel MOXLackey;
        
        ratioUMetal         0.8196;
        ratioPuMetal        0.1790;
        ratioAmMetal        0.0014;
        oxygenMetalRatio    1.970;
        
        nSlices 15;
        
        isotopesU
        (
            0.000e-2 // U234
            0.253e-2 // U235
            0.000e-2 // U236
           99.747e-2 // U238
        );
        
        isotopesPu
        (
            3.625e-2 // Pu238 
            ... // Pu239
            ... // Pu240
            ... // Pu241
            10.360e-2 // Pu242
        );
        
        isotopesAm
        (
            1.0
            0.0
        );
    }
        
    fertile
    {
        material                    UO2;
        Tref                        Tref [ 0 0 0 1 0 ] 293;

        densificationModel          UO2FRAPCON;
        swellingModel               UO2FRAPCON;
        relocationModel             UO2FRAPCON;

        enrichment                  0.00257;
        rGrain                      6.0e-06;
        GdContent                   0.0;
        theoreticalDensity          10950;
        densityFraction             0.955;
        dishFraction                0.0;

        resinteringDensityChange    0.3;
        GapCold                     0.155e-3;
        DiamCold                    9.36e-3;
        recoveryFraction            0.5;
        outerPatch                  "fuelOuter";

        isotropicCracking           on;
        nCracksMax                  12;

        rheologyModel               elasticity;
        
        poreVelocityModel MOXLackey;
        
        nSlices 5;
    }

    cladding
    {
        material                steel1515Ti;
        Tref                    Tref [ 0 0 0 1 0 ] 293;

        PoissonRatioModel "1515TiTobbe";

        rheologyModel   misesPlasticCreep;
        rheologyModelOptions
        {
            plasticStrainVsYieldStress table
            (
                (0    250e6)
            );

            creepModel TobbeAIM1CreepModel;
            relax 0.7;
        }

        nSlices 1;
    }
}

