FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      phaseProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// ------------------------------------------------------------------------- //
// --- THERMAL-HYDRAULIC TYPE ---------------------------------------------- //
// ------------------------------------------------------------------------- //

thermalHydraulicType    "onePhase";

// ------------------------------------------------------------------------- //
// --- STRUCTURES PROPERTIES ----------------------------------------------- //
// ------------------------------------------------------------------------- //

structureProperties
{    
    type            "byZone";

    "intermed:main_fd"
    {
        volumeFraction      0;
        Dh                  1;
    }

    "hx"
    {
        volumeFraction      0.6;
        Dh                  0.01;

        powerModel
        {
            type            constantTemperature;
            volumetricArea  200;
            T               900;
        }
    }

    "pump"
    {
        volumeFraction      0;
        Dh                  1;
        momentumSource      (0 0 -300000);
    }
}

// ------------------------------------------------------------------------- //
// --- REGIME MAP MODEL ---------------------------------------------------- //
// ------------------------------------------------------------------------- //

regimeMapModel
{
    type                none;
}

// ------------------------------------------------------------------------- //
// --- REGIME PHYSICS FOR EACH REGIME -------------------------------------- //
// ------------------------------------------------------------------------- //

physicsModelsByRegime
{
    dragModels
    {
        "hx"
        {
            type    DarcyReynoldsPower;
            coeff   0.687;
            exp     -0.25;
        }
    }

    heatTransferModels
    {
        "hx"
        {
            type    NusseltReynoldsPrandtlPower;
            const   0;
            coeff   0.023;
            expRe   0.8;
            expPr   0.3;
        }
    }
}

// ------------------------------------------------------------------------- //
// --- MISCELLANEA --------------------------------------------------------- //
// ------------------------------------------------------------------------- //

pMin                    10000;
pRefCell                0;
pRefValue               100000;

