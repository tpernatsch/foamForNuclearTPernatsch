        type            wedge;
    }
    back
    {
        type            wedge;
    }
    bottomwall
    {
        type            zeroGradient;
    }
    topwall
    {
        type            zeroGradient;
    }
    reflector
    {
        type            zeroGradient;
    }
    hx
    {
        type            zeroGradient;
    }
}


