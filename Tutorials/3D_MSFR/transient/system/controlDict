FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}

application     GeN-ROM;

startFrom       startTime;

startTime       500;

stopAt          endTime;

endTime         510;

deltaT          0.001;

writeControl    adjustableRunTime;

writeInterval   10;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression on;

timeFormat      general;

timePrecision   8;

runTimeModifiable yes;

solveFluidMechanics false;

solveEnergy     true;

solveNeutronics true;

solveThermalMechanics false;

liquidFuel      true;

adjustTimeStep  true;

maxDeltaT       1;

maxCo           1;

maxPowerVariation 0.025;


