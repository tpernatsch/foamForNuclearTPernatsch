FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     GeN-Foam;

startFrom       latestTime;

stopAt          endTime;

endTime         100;

deltaT          1e-06;

writeControl    adjustableRunTime;

writeInterval   10;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression false;

timeFormat      general;

timePrecision   8;

runTimeModifiable true;

removeBaffles
{
    neutroRegion     false;
}

adjustTimeStep  true;

maxDeltaT       1;

maxCo           5;

maxPowerVariation 0.01;


functions
{
    avgFlux
    {
        type            volFieldValue;
        libs            (fieldFunctionObjects);

        fields
        (
            oneGroupFlux
            flux0
            flux1
            externalSourceFlux0
            externalSourceFlux1
        );
        operation       volAverage;
        regionType      cellZone;
        region          neutroRegion;
        name            zone0;

        writeFields     false;
    }

    integratedFlux
    {
        type            volFieldValue;
        libs            (fieldFunctionObjects);

        fields
        (
            oneGroupFlux
            flux0
            flux1
            externalSourceFlux0
            externalSourceFlux1
        );
        operation       volIntegrate;
        regionType      cellZone;
        region          neutroRegion;
        name            zone0;

        writeFields     false;
    }
}

