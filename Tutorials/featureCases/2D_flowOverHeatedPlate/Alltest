#!/bin/bash

# --- Run from this directory
cd ${0%/*} || exit 1

# --- Initialize the output file
resFile=test.out
rm -rf $resFile
touch $resFile

# --- Run the simulation
echo -e "Run tutorial 2D_flowOverHeatedPlate ...\n" | tee -a $resFile
./Allrun >> log.simulation
echo -e "Done running tutorial 2D_flowOverHeatedPlate ...\n" | tee -a $resFile

# --- Check it ran
endString=$(tail -3 ./log.GeN-Foam | grep End)
if [ "$endString" = "End" ]; then
    echo -e "2D_flowOverHeatedPlate has converged \n" | tee -a $resFile
else
    echo -e "2D_flowOverHeatedPlate has NOT converged \n" | tee -a $resFile
    exit 1
fi

# --- Recover T avg, min, max from log
extract_T()
{
    line=$(
        grep -e "T (avg min max)" ./$1/log.GeN-Foam |
        tail -1
    )
    echo $line
}

Tline=$(extract_T)

Tmax=$(echo "$Tline" | awk '{print $8}')
expectedTMax=309.143

# --- Check results are correct
isInRange()
{
    ref=$1
    value=$2
    error=$3
    valueMin=$(bc -l <<<"$value*(1-$error)")
    valueMax=$(bc -l <<<"$value*(1+$error)")
    if (( $(echo "$valueMin <= $ref && $ref <= $valueMax" | bc -l) )); then
        echo 0
    elif (( $(echo "$valueMax <= $ref && $ref <= $valueMin" | bc -l) )); then
        echo 0
    else
        echo 1
    fi
}

error=0.001

if  [ $(isInRange $Tmax $expectedTMax $error) -eq 0 ]
then
    echo "Perfect match:" | tee -a $resFile
    echo "|           | Simulated | Expected |" | tee -a $resFile
    echo "|:----------|:---------:|:--------:|" | tee -a $resFile
    echo "| TMax      |  $Tmax  |  $expectedTMax |" | tee -a $resFile
else
    echo "Divergent results:" | tee -a $resFile
    echo "|           | Simulated | Expected |" | tee -a $resFile
    echo "|:----------|:---------:|:--------:|" | tee -a $resFile
    echo "| Tfmax avg |  $Tmax  |  $expectedTMax |" | tee -a $resFile
    fi


# --- Exit successfully
exit 0
# ----------------------------------------------------------------- end-of-file

