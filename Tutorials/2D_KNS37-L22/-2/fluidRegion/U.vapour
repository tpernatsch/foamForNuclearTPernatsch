FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U.vapour;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 1e-3);

boundaryField
{
    outlet
    {
        type            pressureInletOutletVelocity;
        value           $internalField;
        phi             phi.vapour;
    }
    inlet
    {
        type            pressureInletOutletVelocity;
        value           $internalField;
        phi             phi.vapour;
    }
    wrapper
    {
        type            slip;
    }
    wedgeY+
    {
        type            wedge;
    }
    wedgeY-
    {
        type            wedge;
    }
}

// ************************************************************************* //
