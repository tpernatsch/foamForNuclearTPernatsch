4
(
    top
    {
        type            cyclic;
        inGroups        1(cyclic);
        nFaces          1;
        startFace       639;
        matchTolerance  0.0001;
        transform       unknown;
        neighbourPatch  bottom;
    }
    bottom
    {
        type            cyclic;
        inGroups        1(cyclic);
        nFaces          1;
        startFace       640;
        matchTolerance  0.0001;
        transform       unknown;
        neighbourPatch  top;
    }
    walls
    {
        type            wall;
        inGroups        1(wall);
        nFaces          1280;
        startFace       641;
    }
    defaultFaces
    {
        type            empty;
        inGroups        1(empty);
        nFaces          1280;
        startFace       1921;
    }
)

