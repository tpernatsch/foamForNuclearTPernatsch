FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


// General

application     GeN-ROM;

startFrom       startTime;//latestTime;//

startTime      200;

stopAt       endTime;//writeNow;//  

endTime        500;

deltaT          0.1; // time step (if non adjusted)

adjustTimeStep  true; // adjust time step based on CFL condition, max power and max delta T

maxDeltaT	    1; // max time step

writeControl   adjustableRunTime;//timeStep;//

writeInterval   50;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression on;

timeFormat      general;

timePrecision   8;

runTimeModifiable yes;

// ************************************************************************* //
// Physics to solve

solveFluidMechanics  false;

solveEnergy  true;

solveNeutronics true;

solveThermalMechanics  false;

// ************************************************************************* //
// Thermal-hydraulic options

compr false; // true for compressible simulation

liquidFuel	true; // eg, MSRs

// ************************************************************************* //
// Solution control

maxCo           0.999; // should be below 1 for CFL condition (necessary to guarantee stability if solving NS)

maxPowerVariation	0.025; //max power variation in each time step




