//- COMPRESSIBLE

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;

    transport           const;
    thermo              hConst;
    equationOfState     Boussinesq;
    specie          specie;
    energy          sensibleEnthalpy;
}

pRef                        100000;

mixture
{
    specie
    {
        molWeight           22.989769;
    }

    equationOfState
    {
        rho0                897;
        T0                  500;
        beta                2.42e-4;
    }

    thermodynamics
    {
        Cp                  1250;
        Hf                  0;
    }
    transport
    {
        mu                  4e-4;
        Pr                  3.214286e-3;
    }
}

