FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T.vapour;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 500;

boundaryField
{
    top
    {
        type            fixedValue;
        value           uniform 500;
    }
    bottom
    {
        type            fixedValue;
        value           uniform 1000;
    }
    fixedWalls
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            empty;
    }
}

