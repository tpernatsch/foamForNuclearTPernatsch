FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue alpha.liquid 1
    volScalarFieldValue alpha.vapour 0
    volScalarFieldValue alpha.structure 0
    volScalarFieldValue T.liquid 300
);

regions
(
    // Set patch values (using ==)
    boxToCell
    {
        box (0.35 -100 -100)(0.65 100 100);

        fieldValues
        (
            volScalarFieldValue alpha.liquid 0.25
            volScalarFieldValue alpha.vapour 0.25
            volScalarFieldValue alpha.structure 0.5
            //volScalarFieldValue T.liquid 650
        );
    }
);

