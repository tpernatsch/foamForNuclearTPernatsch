FoamFile
{
    version         2;
    format          ascii;
    class           volScalarField;
    object          defaultFlux;
}

dimensions      [ 0 -2 -1 0 0 0 0 ];

internalField   uniform 1;

boundaryField
{
    walls
    {
        type            zeroGradient;
    }
    "(front|back)"
    {
        type            wedge;
    }
}


