FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

apperture   0.1; // rad

sina       ${{ sin($apperture/2.0) }};
cosa       ${{ cos($apperture/2.0) }};

vertices
(
    (${{2.00*$cosa}}    ${{-2.00*$sina}}    -1.50)
    (${{3.84*$cosa}}    ${{-3.84*$sina}}    -2.11)
    (${{3.84*$cosa}}    ${{ 3.84*$sina}}    -2.11)
    (${{2.00*$cosa}}    ${{ 2.00*$sina}}    -1.50)
    (${{2.00*$cosa}}    ${{-2.00*$sina}}     1.50)
    (${{3.84*$cosa}}    ${{-3.84*$sina}}     2.11)
    (${{3.84*$cosa}}    ${{ 3.84*$sina}}     2.11)
    (${{2.00*$cosa}}    ${{ 2.00*$sina}}     1.50)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) zone0 (10 1 15) simpleGrading (0.5 1 1)
);

edges
(
    arc 0 1 (${{3.02*$cosa}}    ${{-3.02*$sina}}    -2.52)
    arc 2 3 (${{3.02*$cosa}}    ${{ 3.02*$sina}}    -2.52)
    arc 4 5 (${{3.02*$cosa}}    ${{-3.02*$sina}}     2.52)
    arc 6 7 (${{3.02*$cosa}}    ${{ 3.02*$sina}}     2.52)
    arc 1 5 (${{4.54*$cosa}}    ${{-4.54*$sina}}     0.00)
    arc 2 6 (${{4.54*$cosa}}    ${{ 4.54*$sina}}     0.00)
);

boundary
(
    walls
    {
        type patch;
        faces
        (
            (0 3 2 1)
            (4 5 6 7)
            (0 4 7 3)
            (1 5 6 2)
        );
    }
    front
    {
        type wedge;
        faces
        (
            (0 1 5 4)
        );
    }
    back
    {
        type wedge;
        faces
        (
            (3 2 6 7)
        );
    }
);

