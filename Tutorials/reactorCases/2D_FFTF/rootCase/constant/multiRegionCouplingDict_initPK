FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      multiRegionCouplingDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

multiPhysicsSolvers
{
    energyNeutroMechLoop
    {
        solvers
        {
            fluidRegion     onePhase;
            neutroRegion    diffusionNeutronics;
        }
        minResidual     0.00005;
        maxIterations   3;
    }
}

mappings
{
    neutroRegion
    {
        fluidRegion
        {
            targetFields    ( powerDensity secondaryPowerDensity );
            sourceFields    ( powerDensityNeutronics powerDensityNeutronicsToLiquid );
        }
    }

    fluidRegion
    {}
}


