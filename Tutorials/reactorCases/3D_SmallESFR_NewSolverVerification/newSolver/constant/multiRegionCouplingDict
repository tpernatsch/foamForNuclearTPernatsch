FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       dictionary;
    location    "constant";
    object      multiRegionCouplingDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

meshDeformation
{
    neutroRegion
    {
        displacementField disp;
    }
}

mappings
{
    fluidRegion
    {
        neutroRegion
        {
            sourceFields     ( powerDensity secondaryPowerDensity );
            targetFields     ( powerDensityNeutronics powerDensityNeutronicsToLiquid );
            fieldTypes       ( scalar scalar );
        }
    }
    neutroRegion
    {
        fluidRegion
        {
            sourceFields     ( T thermo:rho T.fuelAvForNeutronics T.cladAvForNeutronics T.passiveStructure );
            targetFields     ( TCool rhoCool TFuel TClad TStructMech );
            fieldTypes       ( scalar scalar scalar scalar scalar );
        }
        thermoMechanicalRegion
        {
            sourceFields     ( meshDisp );
            targetFields     ( disp );
            fieldTypes       ( vector );
        }
    }
    thermoMechanicalRegion
    {
        fluidRegion
        {
            sourceFields     ( T.passiveStructure T.fuelAvForNeutronics );
            targetFields     ( TStructFromTH TFuel );
            fieldTypes       ( scalar scalar );
        }
        neutroRegion
        {
            sourceFields     ( powerDensity );
            targetFields     ( Q );
            fieldTypes       ( scalar );
        }
    }
}


