physicsModels
{
    dragModels
    {
        "Core"
        {
            type    ReynoldsPower; // Power fit (R=0.9956, Re of 500-3000) from case https://www.kta-gs.de/e/standards/3100/3102_3_engl_1981_03.pdf
            //coeff 2.0185584021913607;
            //exp   -0.015323099527580823;
            //coeff   2.722790276270995;
            //exp    1.4686675095560845e-05;
            //coeff  2.097649756799391;
            //exp   0.020219358449307157;
            coeff 300;
            exp -1;
            const 3.5;
        }
    }

    heatTransferModels
    {
        "Core"
        {
            type    NusseltReynoldsPrandtlPower; // Wakao
            const   2; //2; //4.82;
            coeff   1.1; //0.016; //0.0185;
            expRe   0.6; //0.72; //0.827;
            expPr   0.33; //0.31; //0.827;
        }
    }
}


