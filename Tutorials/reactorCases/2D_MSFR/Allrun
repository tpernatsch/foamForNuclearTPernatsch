cd ${0%/*} || exit 1    # Run from this directory

#==============================================================================*

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

#==============================================================================*

endTimeTH=15
endTimeEN=165
endTimeTransient=175

cases="steadyStateTH steadyStateEN transient"

runCloneCase()
{
    printf "Cloning $2 to case $1..."
    cp -r $2 $1
    printf "$2 cloned!\n"
}

setSteadyStateTH()
{
    runCloneCase $1 $2
    printf "Setting steady state case...\n"
    foamDictionary $1/constant/neutroRegion/neutronicsProperties -entry eigenvalueNeutronics -set true
    # foamDictionary $1/system/fvSolution -entry tightlyCoupled -set false
    foamDictionary $1/system/controlDict -entry endTime -set $endTimeTH
    foamDictionary $1/system/controlDict -entry deltaT -set 1e-03
    foamDictionary $1/system/controlDict -entry adjustTimeStep -set true
    foamDictionary $1/system/controlDict -entry writeInterval -set 1
    foamDictionary $1/system/controlDict -entry removeBaffles/fluidRegion -set false
    cp $1/constant/regionsDict_steadyStateTH $1/constant/regionsDict
    GeN-Foam -initializeMappedFields -case $1
    printf "Case set!\n\n"
}

setSteadyStateEN()
{
    runCloneCase $1 $2
    printf "Setting steady state  case...\n"
    cp -r $1/0/neutroRegion $1/$endTimeTH/
    cp -r $1/0/uniform $1/$endTimeTH/
    foamDictionary $1/constant/neutroRegion/neutronicsProperties -entry eigenvalueNeutronics -set true
    # foamDictionary $1/system/fvSolution -entry tightlyCoupled -set false
    foamDictionary $1/system/controlDict -entry startTime -set $endTimeTH
    foamDictionary $1/system/controlDict -entry endTime -set $endTimeEN
    foamDictionary $1/system/controlDict -entry deltaT -set 0.25
    foamDictionary $1/system/controlDict -entry adjustTimeStep -set false
    foamDictionary $1/system/controlDict -entry writeInterval -set 50
    foamDictionary $1/system/controlDict -entry removeBaffles/neutroRegion -set false
    foamDictionary $1/system/fluidRegion/fvSolution -entry PIMPLE/solveFluidMechanics -set false
    foamDictionary $1/system/fluidRegion/fvSolution -entry PIMPLE/solveEnergy -set true
    cp steadyStateEN/constant/regionsDict_steadyStateEN $1/constant/regionsDict
    GeN-Foam -initializeMappedFields -case $1
    printf "Case set!\n\n"
}

setTransient()
{
    runCloneCase $1 $2
    printf "Setting $1 case...\n"
    foamDictionary $1/constant/neutroRegion/neutronicsProperties -entry eigenvalueNeutronics -set false
    # foamDictionary $1/system/fvSolution -entry tightlyCoupled -set true
    foamDictionary $1/system/controlDict -entry startTime -set $endTimeEN
    foamDictionary $1/system/controlDict -entry endTime -set $endTimeTransient
    foamDictionary $1/system/controlDict -entry deltaT -set 1e-03
    foamDictionary $1/system/controlDict -entry adjustTimeStep -set true
    foamDictionary $1/system/controlDict -entry writeInterval -set 10
    cp $1/constant/regionsDict_transient $1/constant/regionsDict
    GeN-Foam -initializeMappedFields -case $1
    printf "Case set!\n\n"
}

for caseName in $cases
do
    printf "Preparing to run case $caseName...\n"

    case "$caseName" in
        "steadyStateTH")
            setSteadyStateTH $caseName rootCase
            printf "Steady state th case is prepared!\n"
            ;;
        "steadyStateEN")
            setSteadyStateEN $caseName steadyStateTH
            printf "Steady state NE case is prepared!\n"
            ;;
        "transient")
            printf "Transient case is prepared!\n"
            setTransient $caseName steadyStateEN
            ;;
    esac

    # Start gnuplot if it exist
    if command -v gnuplot &> /dev/null
    then
        gnuplot -e "log='$caseName/log.GeN-Foam'" residuals - &> /dev/null &
    else
        echo "gnuplot could not be found"
    fi

    #( cd $caseName && runApplication `getApplication` )
    printf "Running GeN-Foam on $caseName\n"
    GeN-Foam -case $caseName 2>&1 | tee "$caseName/log.GeN-Foam"

    # Kill gnuplot if it was started
    pkill -x gnuplot &> /dev/null &

done

