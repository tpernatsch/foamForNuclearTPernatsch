FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application         GeN-Foam;

startFrom           latestTime;

stopAt              endTime;

endTime             1;

deltaT              1;

writeControl        adjustableRunTime;

writeInterval       1;

purgeWrite          2;

writeFormat         ascii;

writePrecision      8;

writeCompression    off;

timeFormat          general;

timePrecision       14;

runTimeModifiable   true;

//- Global options

liquidFuel          false;

//- Time step control options

adjustTimeStep      true;

maxDeltaT           1;

maxCo               10;

maxPowerVariation   0.001;

removeBaffles
{
    fluidRegion     true;
    neutroRegion    false;
}

