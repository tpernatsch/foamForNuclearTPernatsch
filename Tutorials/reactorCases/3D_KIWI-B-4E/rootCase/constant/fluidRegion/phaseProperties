{
    fuelElements
    {
        volumeFraction      0.696911; // Calculated with the dimensions found in 1965 LANL
        Dh                  0.00254;

        powerModel
        {
            type                lumpedNuclearStructure;
            volumetricArea      477.305494; // m2/m3
            powerDensity        0; // Will be computed by the neutronic solver
            nodesNumber         1;
            nodeFuel            0;
            nodeClad            1;
            nodeMatrix          0;
            kappaMatrix         50; // 1000; // W/m/K
            heatConductances    (2.451162e+07 1.149520e+07); // W/m3/K
            rhoCp               (3671370); // J/m3/K
