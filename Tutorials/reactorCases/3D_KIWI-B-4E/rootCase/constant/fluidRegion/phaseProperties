// ------------------------------------------------------------------------- //
// --- REGIME MAP MODEL ---------------------------------------------------- //
// ------------------------------------------------------------------------- //

regimeMapModel
{
    type    none;
}

// ------------------------------------------------------------------------- //
// --- REGIME PHYSICS FOR EACH REGIME -------------------------------------- //
// ------------------------------------------------------------------------- //

physicsModels
{
    dragModels
    {
        fuelElements //:coreSupport:supportPlate"
        {
            // Filonienko equation (Re in [3e3; 5e7])
            // type    Colebrook;
            // coeff   1.82;
            // const   -1.64;
            // exp     -2.0;

            // Determining velocity and friction factor for turbulent flow in smooth
            // tubes, Dawid Taler, International journal of sciences, 105, (2016), 109-122;
            // Re in [3e3; 1e7]
            type    Colebrook;
            coeff   1.2776;
            const   -0.406;
            exp     -2.246;

            // Walton 1992, (2) GRAPH-I-TITE G. Not working
            // type        ReynoldsPower;
            // coeff       ${{0.25 * 363}};
            // const       ${{0.25 * 0.0345}};
            // exp         -1.25;

            // Walton 1992, (5) Basic friction factor and roughness correction. Not working
            // type        ReynoldsPower;
            // coeff       ${{1.35 * 0.046}};
            // exp         -0.2;

            // Walton 1992, (7) Moody friction with 6 = 0.006. A correlation
            // based on the Moody diagram for a roughness of 0.006 was developed
            // (ref. 4) and is shown in the following equation. The relative
            // roughness of 0.006 was measured experimentally from a passage of
            // a fuel element split axially. Not working
            // type        ReynoldsPower;
            // coeff       ${{0.25 * 7.2}};
            // const       ${{0.25 * 0.03172}};
            // exp         -0.75;
        }

        unloadedElements
        {
            type    ReynoldsPower;
            coeff   0.0625;
            exp     -0.32;
        }

        coreSupport
        {
            // Determining velocity and friction factor for turbulent flow in smooth
            // tubes, Dawid Taler, International journal of sciences, 105, (2016), 109-122;
            // Re in [3e3; 1e7]
            type    Colebrook;
            coeff   1.2776;
            const   -0.406;
            exp     -2.246;
        }
    }

    heatTransferModels
    {
        "fuelElements:unloadedElements:coreSupport" //:coreSupport:supportPlate"
        {
            // Simple heat transfer correlations for turbulent tube flow,
            // Dawid Taler and Jan Taler, E3S Web of Conferences 13, 0200
            // (2017), DOI: 10.1051/e3sconf/20171302008
            // 3e3≤ Re ≤1e6, 0.1≤ Pr ≤1
            // type    NusseltReynoldsPrandtlPower;
            // const   0;
            // coeff   0.02155;
            // expRe   0.8018;
            // expPr   0.709;

            // Walton 1992, (I0) Wolf-McCarthy II.
            // This is the earlier of the two correlations developed by these
            // researchers based on experimental data for a hydrogen flow in
            // a electrically heated stainless steel tube (ref.38). The
            // correlation, shown below, was developed over a range of Reynolds
            // numbers from 7800 to 1.55e6 and a range of Tw/Tb from 1.5
            // to 2.8.
            // Nu = 0.023 * Re^0.8 * Pr^0.4 * (Tw/Tb)^(-0.3)
            type    NusseltReynoldsPrandtlPower;
            const   0;
            coeff   0.023; // ${{0.023 * 0.7}};
            expRe   0.8;
            expPr   0.4;
            expTc   -0.3; // -0.2;
        }
    }
}

