FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 0.005; // *100, /100 do not change anything

boundaryField
{
    top
    {
        type            inletOutlet;
        inletValue      uniform 0.005;
        value           uniform 0.005;
    }
    bottom
    {
        type            turbulentMixingLengthDissipationRateInlet;
        mixingLength    0.001;
        value           uniform 0.005;
    }
    wall
    {
        type            zeroGradient;
        value           $internalField;
    }
}


