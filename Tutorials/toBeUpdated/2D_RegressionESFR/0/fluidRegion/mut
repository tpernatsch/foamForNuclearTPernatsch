FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/fluidRegion";
    object      mut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    topWall
    {
        type            calculated;
        value           uniform 0;
    }
    wedgeY+
    {
        type            wedge;
    }
    wedgeY-
    {
        type            wedge;
    }
    walls
    {
        type            mutkWallFunction;
        Cmu             0.09;
        kappa           0.41;
        E               9.8;
        value           uniform 0;
    }
    baffle_master
    {
        type            mutkWallFunction;
        Cmu             0.09;
        kappa           0.41;
        E               9.8;
        coupleGroup     baffle;
        value           uniform 0;
    }
    baffle_slave
    {
        type            mutkWallFunction;
        Cmu             0.09;
        kappa           0.41;
        E               9.8;
        coupleGroup     baffle;
        value           uniform 0;
    }
}


