FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      defaultFlux;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 0 -2 -1 0 0 0 0 ];

internalField   uniform 1;

boundaryField
{
    "walls"
    {
        type            fixedValue;
        value           uniform 0;
    }
     "wedge1"
    {
        type            wedge;
        value           uniform 0;
    } 
     "wedge2"
    {
        type            wedge;
        value           uniform 0;
    }   
}


