FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant/fluidRegion";
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       polynomial;
    thermo          hPolynomial;
    equationOfState icoPolynomial; //perfectGas;
    specie          specie;
    energy          sensibleEnthalpy;
}

pRef                100000;

mixture
{
    specie
    {
        molWeight           22.989769;
    }

    equationOfState
    {
        rhoCoeffs<8>        (1000 0 0 0 0 0 0 0);
    }

    thermodynamics
    {
        CpCoeffs<8>         (850 0 0 0 0 0 0 0);

        Hf                  0;

        Sf                  0;
    }

    transport
    {
        muCoeffs<8>         (1.8e-4 0 0 0 0 0 0 0);

        kappaCoeffs<8>      (65 0 0 0 0 0 0 0);
    }
}


