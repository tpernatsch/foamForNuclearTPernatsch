lc = 0.1;

edge = 0.2;

haldEdge = edge/2;

flatToFlat = edge * Sqrt(3); 

halfFlatToFlat = flatToFlat/2;

Point(1) = {-haldEdge, -halfFlatToFlat,  0, lc} ;
Point(2) = {-edge, 0, 0, lc} ;
Point(3) = {-haldEdge, halfFlatToFlat,  0, lc} ;
Point(4) = {haldEdge, halfFlatToFlat,  0, lc} ;
Point(5) = {edge, 0, 0, lc} ;
Point(6) = {haldEdge, -halfFlatToFlat,  0, lc} ;

Line(1) = {1,2} ;
Line(2) = {2,3} ;
Line(3) = {3,4} ;
Line(4) = {4,5} ;
Line(5) = {5,6} ;
Line(6) = {6,1} ;

Line Loop(7) = {1,2,3,4,5,6} ;

Plane Surface(1) = {7} ;



//secondSurface[] = Translate {0, flatToFlat, 0} { Duplicata{ Surface{1}; } };

//Physical Surface("side") = {secondSurface[0]} ;


assembly[] = Extrude {0, 0, 1} { 
  Surface{1}; Layers{10} ; Recombine;
};
// In this last extrusion command we retrieved the volume number
// programatically by using the return value (a list) of the Extrude
// command. This list contains the "top" of the extruded surface (in
// out[0]), the newly created volume (in out[1]) and the ids of the
// lateral surfaces (in out[2], out[3], ...)



Physical Surface("bottom") = {1} ;

Physical Surface("top") = {assembly[0]} ;

Physical Surface("walls") = {assembly[2],assembly[3],assembly[4],assembly[5],assembly[6],assembly[7]} ;

Physical Volume("assembly") = {assembly[1]} ;














