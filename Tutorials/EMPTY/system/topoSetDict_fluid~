FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

actions
(
    // structure
    {
        name    structure;
        type    cellSet;
        action  new;
        source  boxToCell;
        sourceInfo
        {
            box (1.0  1.0 -0.1 )(2.0 1.2 0.1);
        }
    }
    {
        name    structure;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        sourceInfo
        {
            set structure;
        }
    }

    // pool (the rest)
    {
        name    pool;
        type    cellZoneSet;
        action  clear;
    }
    {
        name    pool;
        type    cellSet;
        action  add;
        source  cellToCell;
        sourceInfo
        {
            set structure;
        }
    }
    {
        name    pool;
        type    cellSet;
        action  invert;
    }
    {
        name    pool;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        sourceInfo
        {
            set pool;
        }
	}
);

