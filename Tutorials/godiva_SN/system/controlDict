FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// General

//removeFluidBaffles	true;

application         GeN-Foam;

startFrom           startTime;//latestTime;//

startTime           0;//1000;

stopAt              endTime;// writeNow;// 

endTime             100;//1010;

deltaT              1;//0.001; // time step (if non adjusted)

adjustTimeStep      false;//true; // adjust time step based on CFL condition, max power and max delta T

maxDeltaT           0.5; // max time step

writeControl        runTime;//timeStep;//timeStep;//adjustableRunTime;

writeInterval       100;//5;

purgeWrite          0;

writeFormat         ascii;

writePrecision      7;

writeCompression    false;

timeFormat          general;

timePrecision       8;

runTimeModifiable   true;

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Physics to solve

solveFluidMechanics     false;

solveEnergy             false;

solveNeutronics         true;

solveThermalMechanics   false;

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Global simulation options

compr       false; // true for compressible simulation

liquidFuel  false; // eg, MSRs

// Solution control

maxCo               0.99; // should be below 1 for CFL condition (necessary to guarantee stability if solving NS)

maxPowerVariation   0.025; //max power variation in each time step

// ************************************************************************* //
