FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

PIMPLE
{
    nOuterCorrectors        1;
    tightlyCoupled          false;//true; // if true it iterates on energy, fuel temp, thermal-mechanics and neutronics (not necessary for very short time steps)
    timeStepResidual        0.00005; // required accuracy for the coupling
    maxTimeStepIterations   3;
}

