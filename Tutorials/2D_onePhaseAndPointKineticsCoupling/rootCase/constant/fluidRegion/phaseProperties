// ------------------------------------------------------------------------- //
// --- THERMAL-HYDRAULIC TYPE ---------------------------------------------- //
// ------------------------------------------------------------------------- //

thermalHydraulicType    "onePhase";

// ------------------------------------------------------------------------- //
// --- STRUCTURES PROPERTIES ----------------------------------------------- //
// ------------------------------------------------------------------------- //

structureProperties
{    
    type            "byZone";

    "zone0"
    {
        volumeFraction      0.5;
        Dh                  0.01;

        powerModel
        {
            type                nuclearFuelPin;
            volumetricArea      300;
            powerDensity        0;
            fuelInnerRadius     0.0012;
            fuelOuterRadius     0.004715;
            cladInnerRadius     0.004865;
            cladOuterRadius     0.005365;
            fuelMeshSize        16;
            cladMeshSize        4;
            fuelRho             10480;
            fuelCp              250;
            cladRho             7500;
            cladCp              500;
            gapH                3000;
            fuelK               3;
            cladK               20;
            fuelT               600;
            cladT               600;
        }

        passiveProperties
        {
            volumetricArea      2;
            rho                 7700;
            Cp                  500;
            T                   600;
        }
    }
}

// ------------------------------------------------------------------------- //
// --- REGIME MAP MODEL ---------------------------------------------------- //
// ------------------------------------------------------------------------- //

regimeMapModel
{
    type                none;
}

// ------------------------------------------------------------------------- //
// --- REGIME PHYSICS FOR EACH REGIME -------------------------------------- //
// ------------------------------------------------------------------------- //

physicsModelsByRegime
{
    dragModels
    {
        "zone0"
        {
            type    DarcyReynoldsPower;
            coeff   0.687;
            exp     -0.25;
        }
    }

    heatTransferModels
    {
        "zone0"
        {
            type    NusseltReynoldsPrandtlPower;
            const   4.82;
            coeff   0.0185;
            expRe   0.827;
            expPr   0.827;
        }
    }
}

