FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}

application     GeN-Foam;

startFrom       startTime;

startTime       100;

stopAt          endTime;

endTime         200;

deltaT          1e-06;

writeControl    timeStep;

writeInterval   10;

purgeWrite      0;

writeFormat     ascii;

writePrecision  7;

writeCompression false;

timeFormat      general;

timePrecision   8;

runTimeModifiable false;

solveFluidMechanics true;

solveEnergy     true;

solveNeutronics true;

solveThermalMechanics false;

removeFluidBaffles true;

adjustTimeStep  true;

maxDeltaT       1;

maxCo           5;

maxPowerVariation 0.01;


