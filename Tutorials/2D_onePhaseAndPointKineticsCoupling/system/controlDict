FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//- General

application         GeN-Foam;

startFrom           startTime;

startTime           200;

stopAt              endTime;

endTime             250;

deltaT              0.000001;

writeControl        timeStep;

writeInterval       10;

purgeWrite          0;

writeFormat         ascii;

writePrecision      7;

writeCompression    false;

timeFormat          general;

timePrecision       8;

runTimeModifiable   false;

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//- Physics to solve

solveFluidMechanics     true;

solveEnergy             true;

solveNeutronics         true;

solveThermalMechanics   false;

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//- Global simulation options

removeFluidBaffles		true; 		

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//- Solution control

//- Related to onePhase thermalHydraulic model

adjustTimeStep      true;

maxDeltaT           1;

maxCo              	5;

//- Related to neutronics

maxPowerVariation   0.01;

// ************************************************************************* //
