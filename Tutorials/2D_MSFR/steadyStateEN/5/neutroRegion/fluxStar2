FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "5/neutroRegion";
    object      fluxStar2;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 -2 -1 0 0 0 0];


internalField   uniform 1;

boundaryField
{
    front
    {
        type            wedge;
    }
    back
    {
        type            wedge;
    }
    bottomwall
    {
        type            fixedValue;
        value           uniform 0;
    }
    topwall
    {
        type            fixedValue;
        value           uniform 0;
    }
    reflector
    {
        type            fixedValue;
        value           uniform 0;
    }
    hx
    {
        type            fixedValue;
        value           uniform 0;
    }
}


