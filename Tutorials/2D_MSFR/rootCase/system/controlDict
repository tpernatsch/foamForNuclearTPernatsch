FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


// General

application     GeN-ROM;

startFrom       startTime;//latestTime;//

startTime      	0;

stopAt       	endTime;//writeNow;//  

endTime        	5;

deltaT          1e-2; // time step (if non adjusted)

writeControl   	adjustableRunTime;//timeStep;//

writeInterval   5;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression on;

timeFormat      general;

timePrecision   8;

runTimeModifiable yes;

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Physics to solve

solveFluidMechanics     true;

solveEnergy             true;

solveNeutronics         true;

solveThermalMechanics   false;

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Global simulation options

liquidFuel  			true; 

// Time step control

adjustTimeStep 		true;

maxDeltaT           1;

maxCo               10;

maxPowerVariation   0.025;

// ************************************************************************* //




