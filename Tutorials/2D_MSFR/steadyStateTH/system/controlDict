FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}

application     GeN-Foam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         5;

deltaT          0.001;

writeControl    adjustableRunTime;

writeInterval   5;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable yes;

solveFluidMechanics true;

solveEnergy     false;

solveNeutronics false;

solveThermalMechanics false;

liquidFuel      true;

adjustTimeStep  true;

maxDeltaT       1;

maxCo           10;

maxPowerVariation 0.025;


