/*
Script to generate the FMU
*/

// Load the mandatory libraries
loadModel(Modelica, ThermoPower);

// Load all the files composing the model
loadFile("./H2.mo");
loadFile("./NTPTurbomachine_noControl.mo");

// Some useful options for FMI
setCommandLineOptions("--fmiSources=true --fmiFilter=none -d=nonewInst");

// Build the FMU
translateModelFMU(NTPTurbomachine_noControl, version="2.0", fmuType="cs");
