/*
Script to generate the secondary circuit in FMU
*/

// Load the mandatory libraries
loadModel(Modelica, ThermoPower);

// Load all the files composing the model
loadFile("./Controller.mo");

// Some useful options for FMI
setCommandLineOptions("--fmiFilter=none");
setCommandLineOptions("--fmiSources=true");
setCommandLineOptions("--fmiFlags=s");

// Build the FMU
translateModelFMU(Controller, version="2.0", fmuType="cs");
buildModelFMU(Controller, version="2.0", fmuType="cs");
