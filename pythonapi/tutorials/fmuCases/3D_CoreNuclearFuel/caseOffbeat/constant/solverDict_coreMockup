FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      solverDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//- Thermal and Mechanical solver selection:
thermalSolver           solidConduction;
mechanicsSolver         smallStrain; // largeStrainTotLag; // largeStrainUpdLag; // smallStrain;
neutronicsSolver        fromLatestTime; // Because fast reactor
elementTransport        fromLatestTime;

//- Material and rhelogy treatment:
materialProperties      byZone;
rheology                byMaterial;

heatSource              fmiLhgr;
burnup                  fromPower; // Because fast reactor
fastFlux                timeDependentAxialProfile;
gapGas                  FRAPCON;
fgr                     SCIANTIX;
sliceMapper             autoAxialSlices;
corrosion               fromLatestTime;

globalOptions
{
    pinDirection        (0 0 1);
    reactorType         "LWR";
}

thermalSolverOptions
{
    heatFluxSummary     on;
    calculateEnthalpy   on;
}

rheologyOptions
{
    thermalExpansion    on;
    modifiedPlaneStrain on;
    springModulus       3500;
    coolantPressureList
    {
        file            "$FOAM_CASE/constant/systemPressure";
        outOfBounds     clamp;
    }
    planeStress         off;
}

mechanicsSolverOptions
{
    forceSummary        off;  
    cylindricalStress   on;  

    multiMaterialCorrection
    {
        type                    uniform;
        defaultWeights          0.9;
    }

    /*
    forceSummary        off;
    linearStrainTensor  off;
    cylindricalStress   off;
    RhieChowCorrection  on;

    multiMaterialCorrection
    {
        type            uniform;
        defaultWeights  1;
    }
    */
}

fgrOptions
{
    nFrequency  1;
    relax       1;
}

gapGasOptions
{
    gapPatches          ( fuelOuter cladInner );
    holePatches         ();
    topFuelPatches      ( fuelTop );
    bottomFuelPatches   ( fuelBottom );

    gapVolumeOffset     0.0;
    gasReserveVolume    0.0;
    gasReserveTemperature 290;
}

heatSourceOptions
{
    QavgNameFromFMU     offbeatQavg;
    // initialQavg         0; // 230e2;
    alpha               0.5; // relaxation factor

    axialProfile
    {
        type                        fmiTabulated;
        axialLocationsNameFromFMU   offbeatAxialLocations;
        axialProfileNameFromFMU     offbeatHeatSrcAxial;
        // initialAxialLocations // Need to be passed by input FMI to reduce potential user errors 
        // (
        //     0 0.05 0.1 0.15 0.2 0.25 0.3 0.35 0.4 0.45 0.5 0.55 0.6 0.65 0.7 0.75 0.8 0.85 0.9 0.95 1
        // );
        // initialData                 21{1};
        axialInterpolationMethod    linear;
    }

    radialProfile
    {
        // type    fromBurnup;
        type    flat;
    }

    materials ( fuel );
}

fastFluxOptions
{ // Need a FMI input ? I think it would be cool, but useless for fast reactor
    timePoints  ( 0  3600     1.26E+08 );
    fastFlux    ( 2e13  2e13     2e13 );
    timeInterpolationMethod linear;

    axialProfile
    {
        type flat;
        /*
        type                        fmiTabulated;
        axialLocationsNameFromFMU   offbeatAxialLocations;
        axialProfileNameFromFMU     offbeatFastFluxAxial;
        // initialAxialLocations // Need to be passed by input FMI to reduce potential user errors 
        // (
        //     0 0.05 0.1 0.15 0.2 0.25 0.3 0.35 0.4 0.45 0.5 0.55 0.6 0.65 0.7 0.75 0.8 0.85 0.9 0.95 1
        // );
        // initialData                 21{1};
        axialInterpolationMethod    linear;
        */
    }

    materials ( fuel cladding );
}


materials
{
    writeMaterialProperties         true;

    fuel
    {
        material                UPuO2;
        Tref                    Tref [ 0 0 0 1 0 ] 293;

        densificationModel      UO2FRAPCON;
        swellingModel           UO2FRAPCON;
        relocationModel         UO2FRAPCON;
        
        // heatCapacityModel       constant;
        // densityModel            constant;
        // YoungModulusModel       constant;
        // PoissonRatioModel       constant;
        // thermalExpansionModel   constant;
        // conductivityModel       UPuO2Kato;
        // rho             rho [ 1 -3 0 0 0 ] 10662;
        // Cp              Cp [ 0 2 -2 -1 0 ] 120;
        // E               E [ 1 -1 -2 0 0 ] 2e+11;
        // nu              nu [ 0 0 0 0 0 ] 0.345;
        // alpha           alpha [ 0 0 0 0 0 ] 1e-06;
        // Tref            Tref [ 0 0 0 1 0 ] 300;
        // oxygenMetalRatio 2;
        // ratioUMetal     0.8;
        // ratioPuMetal    0.18;
        // ratioAmMetal    0.02;
        // ratioNpMetal    0;
        // isotopesU       ( 1e-05 0.00248 1e-05 0.9975 );
        // isotopesPu      ( 0.00872 0.65 0.23512 0.0714 0.03476 );
        // isotopesAm      ( 1 0 );

        enrichment                  0; // 0.05;
        ratioUMetal         0.78;   // to be checked
        ratioPuMetal        0.20;   // to be checked
        ratioAmMetal        0.02;   // to be checked
        oxygenMetalRatio    2; // -> c, hc, ym
        isotopesU // to be checked
        (
            0.001e-2 // U234
            0.248e-2 // U235
            0.001e-2 // U236
            99.75e-2 // U238
        );
        isotopesPu // to be checked
        (
             0.872e-2 // Pu238 
            65.000e-2 // Pu239
            23.512e-2 // Pu240
             7.140e-2 // Pu241
             3.476e-2 // Pu242
        );
        isotopesAm // to be checked
        (
            1
            0
        );
        rGrain                      5e-05;
        // GdContent                   0.0;
        theoreticalDensity          10960;
        densityFraction             0.95;
        dishFraction                0.0;

        resinteringDensityChange    0.3;
        GapCold                     0.13e-3; // (2 * (rclad_i - rfuel_o)) be carfull when changing fuel dimensions
        DiamCold                    9.0e-3;  // be carfull when changing fuel dimensions
        recoveryFraction            0.5;
        outerPatch                  "fuelOuter";

        isotropicCracking           on;
        nCracksMax                  12;

        rheologyModel               elasticity;

        // failureModel    UO2meltingMATPRO;
        // stopIfFailed    off;
        // failureModelOptions
        // {
        //     Tmelt   3113.0; // According to UO2meltingMATPRO.C
        // }
    }

    cladding
    {
        material                steel1515Ti;
        Tref                    Tref [ 0 0 0 1 0 ] 293;

        rheologyModel           misesPlasticCreep;
        rheologyModelOptions
        {
            plasticStrainVsYieldStress table
            (
                (0    400e6) // From Luzzi et al. 2014 report Figure 11
            );

            creepModel  TobbeAIM1CreepModel;
            relax       0.9; // help converge // 1.0;
        }

        failureModel    combined;
        stopIfFailed    off;
        failureModelOptions
        {
            criteria    ( cumulativeDamageFunction UO2meltingMATPRO );

            limitCDF    0.2; // Maximum from Luzzi et al. Table 4
            Tmelt       ${{550+273.15}}; // Maximum peak temperature from Luzzi et al.
        }

        // failureModel    UO2meltingMATPRO;
        // stopIfFailed    off;
        // failureModelOptions
        // {
        //     Tmelt   ${{550+273.15}}; // Maximum peak temperature from Luzzi et al.
        // }

        // failureModel    cumulativeDamageFunction;
        // stopIfFailed    off;
        // failureModelOptions
        // {
        //     limitCDF   0.2; // Maximum from Luzzi et al. Table 4
        // }
    }
}

