FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

libs ("libsciantix.so");
libs ("liboffbeat.so");

#include "simulationParameters"

application     offbeat;

//- Run options:
startFrom       startTime;
startTime       $startTime; // 0;
stopAt          endTime;
endTime         15; // 1.26e8; // Replaced by PyFMI
deltaT          $timeStep; // Must be the same as in the FMI Master Simulator

//- Write options:
writeControl    adjustableRunTime; // adjustableRunTime; // timeStep;
writeInterval   $writeInterval; // 100;
purgeWrite      0; // 2;
writeFormat     ascii;
writeCompression off;
timeFormat      general;
timePrecision   8; // 20;
writePrecision  6;

functions
{
    #includeFunc  probes
}

//- Adjustable time step options:
adjustableTimeStep true;

maxDeltaT         6.048e5;
minDeltaT         0.001;
maxRelativeDeltaTIncrease 1e9;
minRelativeDeltaTDecrease 1e9;
maxRelativePowerIncrease  0.1;
maxRelativePowerDecrease  0.1;
maxBurnupIncrease 0.1;
maxAverageCreep   1e-4;
maxMaximumCreep	  1e-4;
maxFGR			  1e-8;

runTimeModifiable true;

solveFMI          true;

