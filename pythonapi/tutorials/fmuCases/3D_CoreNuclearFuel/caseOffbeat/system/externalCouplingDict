FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      externalCouplingDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

externalFunctions
{
    surfacePowerFMI
    {
        type                extAxialPatch;
        // fieldName           gradT;
        // fieldType           vector;
        fieldName           heatFlux;
        fieldType           scalar;
        patchName           cladOuter;
        outputName          offbeatSurfacePowerAxial;
        axialLocationsNameFromFMU   offbeatAxialLocations;
        initialData         0; // 21{0};
        // initialAxialLocations // Need to be passed by input FMI to reduce potential user errors
        // (
        //     0 0.05 0.1 0.15 0.2 0.25 0.3 0.35 0.4 0.45 0.5 0.55 0.6 0.65 0.7 0.75 0.8 0.85 0.9 0.95 1
        // );
        // scale               21.5; // Thermal conductivity of Zircaloy
        scale               1;
        relaxationFactor    0.5; // Need to be used in implicit coupling, fine for
                              // now only in steady-state calculation
    }

    rhoCpdTdtFMI
    {
        type                extAxialAverageSliceMesh;
        fieldName           T;
        outputName          offbeatRhoCpdTdtAxial;
        axialLocationsNameFromFMU   offbeatAxialLocations;
        scale               0.475686; // Volume fraction of structure per slice ((Sfuel+Sclad)/Slat)
        relaxationFactor    0.1; // Need to be used in implicit coupling
        isRhoCpdTdt         true;
    }

    TFuelFMI
    {
        type                extAxialAverageSliceMesh;
        fieldName           T;
        cellZone            fuel;
        outputName          offbeatTFuelAxial;
        axialLocationsNameFromFMU   offbeatAxialLocations;
        scale               1;
        relaxationFactor    1;
    }

    TCladdingFMI
    {
        type                extAxialAverageSliceMesh;
        fieldName           T;
        cellZone            cladding;
        outputName          offbeatTCladAxial;
        axialLocationsNameFromFMU   offbeatAxialLocations;
        scale               1;
        relaxationFactor    1;
    }
}

