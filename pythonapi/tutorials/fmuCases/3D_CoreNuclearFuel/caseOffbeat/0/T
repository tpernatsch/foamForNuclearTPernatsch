FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 673.15;

boundaryField
{
    ".*Front|.*Back"
    {
        type            wedge;
        value           $internalField;
    }

    fuelInner
    {
        type            zeroGradient;
    }

    fuelOuter
    {
        type            fuelRodGap;
        patchType       regionCoupledOFFBEAT;
        kappa           k;
        coupled         true;
        alpha           uniform 5000;
        roughness       uniform 2.2e-6;
        value           $internalField;
        relax           0.1; // 1
    }

    cladInner
    {
        type            fuelRodGap; // resistiveGap to test, not working
        patchType       regionCoupledOFFBEAT;
        kappa           k;
        coupled         true;
        alpha           uniform 5000;
        roughness       uniform 0.5e-6;
        value           $internalField;
        relax           0.1; // 1;
    }

    // cladOuter
    // {
    //     type            fmiAxialProfileT; // Merge/Factorize the class with axialProfileT?
    //     axialProfileDict
    //     {
    //         axialLocationsNameFromFMU   offbeatAxialLocations;
    //         axialProfileNameFromFMU     offbeatTstructAxial;
    //         // NOTE : axial locations are NOT normalized
    //         // initialAxialLocations // Need to be passed by input FMI to reduce potential user errors
    //         // (
    //         //     0 0.05 0.1 0.15 0.2 0.25 0.3 0.35 0.4 0.45 0.5 0.55 0.6 0.65 0.7 0.75 0.8 0.85 0.9 0.95 1
    //         // );
    //         initialData                 15{673.15};
    //         axialInterpolationMethod    linear;
    //     }
    //     value           uniform 673.15;
    // }

    cladOuter
    {
        type            fmiAxialProfileHTC; // Merge/Factorize the class with axialProfileT?
        axialProfileDict
        {
            axialLocationsNameFromFMU   offbeatAxialLocations;
            TaxialProfileNameFromFMU    offbeatTfluidAxial;
            HaxialProfileNameFromFMU    offbeatHtcAxial;
            // NOTE : axial locations are NOT normalized
            // initialAxialLocations // Need to be passed by input FMI to reduce potential user errors
            // (
            //     0 0.05 0.1 0.15 0.2 0.25 0.3 0.35 0.4 0.45 0.5 0.55 0.6 0.65 0.7 0.75 0.8 0.85 0.9 0.95 1
            // );
            TinitialData                15{673.15};
            HinitialData                15{5e3};
            axialInterpolationMethod    linear;
        }
        value           uniform 673.15;
    }
}


